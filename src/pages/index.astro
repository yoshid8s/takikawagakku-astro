---
import { getCollection } from 'astro:content';
import Layout from '../layouts/Layout.astro';

const posts = (await getCollection('blog')).sort(
	(a, b) =>
		b.data.date.getTime() -
		a.data.date.getTime()
);

const latestPost = posts[0];

const formatDate = (date: Date) =>
	date
		.toLocaleDateString('ja-JP', {
			year: 'numeric',
			month: '2-digit',
			day: '2-digit',
		})
		.replace(/\//g, '.');

const postHref = (slug: string) =>
	`/${encodeURIComponent(slug)}/`;
---

<Layout>
	<main>
		<section class="hero">
			<div class="hero__inner">
				<div class="hero__content">
					<h1 class="hero__message">
						<img
							src="/images/main-message.svg"
							alt="「近助（きんじょ）」を合言葉に！ 子どもにも大人にも優しい街"
						/>
					</h1>

					<div class="hero__body">
						<p>
							<span>名古屋市昭和区の南に位置する滝川学区は、</span>
							<span>都市の便利さと自然が共存する、住みやすい</span>
							<span>街です。滝川学区自治協議会は、滝川学区を</span>
							<span>より良い街にするために、町内会のみなさん</span>
							<span>や子ども会、防災関連団体、名古屋市など</span>
							<span>行政機関と連携して活動しています。</span>
						</p>
					</div>
				</div>
			</div>
		</section>
		<section class="news">
			<div class="section-inner">
				<div class="section-heading">
					<p class="section-heading__eyebrow">NEWS</p>
					<h2>新着情報</h2>
				</div>

				{
					latestPost && (
						<article class="news-card">
							<div class="news-card__meta">
								<time datetime={latestPost.data.date.toISOString()}>
									{formatDate(latestPost.data.date)}
								</time>
							</div>

							<div class="news-card__body">
								<h3>
									<a href={postHref(latestPost.data.slug)}>
										{latestPost.data.title}
									</a>
								</h3>

								{
									latestPost.data.excerpt && (
										<p>
											{latestPost.data.excerpt}
										</p>
									)
								}

								<a
									class="news-card__more"
									href={postHref(latestPost.data.slug)}
								>
									詳しくはこちら →
								</a>
							</div>
						</article>
					)
				}

				<div class="news__footer">
					<a class="button-link" href="/blog/">新着情報一覧を見る</a>
				</div>
			</div>
		</section>
		<section class="features">
			<div class="section-inner">
				<div class="section-heading">
					<p class="section-heading__eyebrow">ABOUT TAKIKAWA</p>
					<h2>滝川学区の特徴</h2>
				</div>

				<div class="features__grid">
					<article class="feature-card">
						<p class="feature-card__number">01</p>
						<h3>文教地区に指定</h3>
						<p>
							滝川学区には、幼児園や保育園から大学まで幅広い教育機関があり、
							文教地区に指定されているので、教育上ふさわしくない施設がありません。
							学区外にはなりますが、近隣に名古屋大学があり、図書館も利用できるので、
							将来に向けての学びに最適です。
						</p>
					</article>

					<article class="feature-card">
						<p class="feature-card__number">02</p>
						<h3>交流の機会</h3>
						<p>
							滝川学区では毎年、「ふれあいフェスタ」というお子様からシニアまで
							楽しめるイベントや地域の交流会などが多数開催され、
							地域の皆様と触れ合うことのできる機会が豊富にあります。
						</p>
					</article>

					<article class="feature-card">
						<p class="feature-card__number">03</p>
						<h3>子育て、介護も安心</h3>
						<p>
							滝川学区は転勤などでの出入りが比較的多い文教学区です。
							若い世代も多く、子どもにとっても大人にとっても住みやすい環境が
							整っていて、 子育てやシニア向けのコミュニティ もあります。
							高度医療・救急医療を担う八事日赤第二病院、聖霊病院、
							かかりつけ医院、介護施設も多いので健康面でも安心です。
						</p>
					</article>

					<article class="feature-card">
						<p class="feature-card__number">04</p>
						<h3>自然の多い街</h3>
						<p>
							滝川学区は公園や緑地が多く、
							自然と触れ合いながら健やかな育ちを促します。
							また、防犯や防災にも配慮した街づくりを行っています。
						</p>
					</article>
				</div>
			</div>
		</section>
		<section class="safety">
			<div class="section-inner">
				<div class="section-heading">
					<h2>地域の防犯・防火・防災意識の高い街へ</h2>
				</div>

				<div class="safety__content">
					<div class="safety__image">
						<img
							src="/images/takikawa-fire-brigade.jpg"
							alt="滝川学区消防団"
						/>
					</div>

					<div class="safety__body">
						<p>
							滝川学区では、様々なイベントを開催しています。学校祭や縁日など、
							さまざまな楽しいイベントを通じて、学区の絆を深めることができます。
							また、地域の安全や
							<a href="/crisis_management/">防犯・防火・防災</a>
							にも力を入れており、防犯パトロールや防災訓練などを定期的に実施しています。
							滝川学区では、子どもたちだけでなく、大人も安心して暮らせるような
							環境作りに取り組んでいます。
						</p>
					</div>
				</div>
			</div>
		</section>
		<section class="environment">
			<div class="section-inner">
				<div class="section-heading">
					<h2>滝川学区の主な生活環境指数のご紹介</h2>
				</div>

				<div class="environment__figure">
					<img
						src="/images/takikawa_environ_figure_outline.svg"
						alt="滝川学区の主な生活環境指数"
					/>
				</div>
			</div>
		</section>
	</main>
</Layout>

<style>
	.hero {
		min-height: 620px;
		display: flex;
		align-items: center;
		position: relative;
		background:
			linear-gradient(rgb(0 0 0 / 10%), rgb(0 0 0 / 10%)),
			url('/images/kousho-shrine.jpeg') center / cover no-repeat;
		color: #fff;
	}

	.hero__inner {
		width: min(1120px, calc(100% - 48px));
		margin: 0 auto;
		position: relative;
		z-index: 1;

		display: flex;
		justify-content: center;
	}

	.hero__content {
		width: fit-content;
	}

	.hero__message {
		margin: 0 0 36px;
	}

	.hero__message img {
		display: block;
		width: min(564px, 100%);
		height: auto;
	}

	.hero__body {
		width: fit-content;
		margin: 0 auto;
	}

	.hero p {
		margin: 0;
		font-size: 15px;
		font-weight: 400;
		line-height: 2.2;
		text-align: left;
	}

	.hero__body span {
		display: block;
		white-space: nowrap;
	}

	.section-inner {
	width: min(1120px, calc(100% - 48px));
	margin: 0 auto;
	}

	.news {
		padding: 96px 0;
		background: #fff;
		color: #111827;
	}

	.section-heading {
		margin-bottom: 48px;
	}

	.section-heading__eyebrow {
		margin: 0 0 8px;
		color: #ea7300;
		font-size: 13px;
		font-weight: 700;
		letter-spacing: 0.12em;
	}

	.section-heading h2 {
		margin: 0;
		font-size: clamp(30px, 3vw, 42px);
		font-weight: 500;
	}

	.news-card {
		display: grid;
		grid-template-columns: 140px 1fr;
		gap: 40px;
		padding: 32px 0;
		border-top: 1px solid #e5e7eb;
		border-bottom: 1px solid #e5e7eb;
	}

	.news-card__meta {
		font-size: 14px;
		color: #6b7280;
	}

	.news-card__body h3 {
		margin: 0 0 14px;
		font-size: 22px;
		font-weight: 500;
		line-height: 1.6;
	}

	.news-card__body h3 a {
		color: inherit;
		text-decoration: none;
	}

	.news-card__body h3 a:hover {
		color: #ea7300;
	}

	.news-card__body p {
		margin: 0 0 18px;
		font-size: 16px;
		line-height: 1.8;
		color: #4b5563;
	}

	.news-card__more {
		font-size: 14px;
		color: #ea7300;
		text-decoration: none;
	}

	.news__footer {
		margin-top: 36px;
		text-align: right;
	}

	.button-link {
		display: inline-block;
		padding: 12px 20px;
		border: 1px solid #111827;
		color: #111827;
		text-decoration: none;
		font-size: 14px;
	}

	.button-link:hover {
		border-color: #ea7300;
		color: #ea7300;
	}

	.features {
		padding: 104px 0;
		background: #f7f8f6;
		color: #111827;
	}

	.features__grid {
		display: grid;
		grid-template-columns: repeat(2, minmax(0, 1fr));
		gap: 1px;
		background: #dfe3df;
		border: 1px solid #dfe3df;
	}

	.feature-card {
		padding: 48px;
		background: #fff;
	}

	.feature-card__number {
		margin: 0 0 28px;
		color: #ea7300;
		font-size: 13px;
		font-weight: 700;
		letter-spacing: 0.12em;
	}

	.feature-card h3 {
		margin: 0 0 20px;
		font-size: 24px;
		font-weight: 500;
	}

	.feature-card > p:last-child {
		margin: 0;
		color: #4b5563;
		font-size: 16px;
		line-height: 1.9;
	}

	.safety {
		padding: 104px 0;
		background: #fff;
		color: #111827;
	}

	.safety__content {
		display: grid;
		grid-template-columns: 1fr 1fr;
		align-items: center;
		gap: 64px;
	}

	.safety__image img {
		display: block;
		width: 100%;
		height: auto;
	}

	.safety__body p {
		margin: 0;
		font-size: 16px;
		line-height: 1.9;
		color: #4b5563;
	}

	.safety__body a {
		color: #ea7300;
		text-decoration: none;
	}

	.safety__body a:hover {
		text-decoration: underline;
	}

	.environment {
		padding: 104px 0;
		background: #f7efe3;
		color: #111827;
	}

	.environment__figure {
		margin-top: 48px;
		text-align: center;
	}

	.environment__figure img {
		display: block;
		width: min(100%, 1000px);
		height: auto;
		margin: 0 auto;
	}

@media (max-width: 768px) {
	.hero {
		min-height: 780px;
		align-items: flex-start;
		padding-top: 130px;
	}

	.hero__inner {
		width: calc(100% - 32px);
		margin: 0 auto;
	}

	.hero__content {
		width: 100%;
	}

	.hero__message {
		width: 100%;
		margin: 0 auto 58px;
	}

	.hero__message img {
		display: block;
		width: 100%;
		max-width: 564px;
		height: auto;
		margin: 0 auto;
	}

	.hero__body {
		width: fit-content;
		max-width: 100%;
		margin: 0 auto;
	}

	.hero p {
		margin: 0;
		font-size: 15px;
		font-weight: 400;
		line-height: 2.2;
		text-align: left;
	}

	.hero__body span {
		display: block;
		white-space: nowrap;
	}
	.news {
		padding: 64px 0;
	}

	.news-card {
		display: block;
		padding: 28px 0;
	}

	.news-card__meta {
		margin-bottom: 14px;
	}

	.news-card__body h3 {
		margin: 0 0 14px;
		font-size: 20px;
		line-height: 1.55;
	}

	.news-card__body p {
		margin: 0 0 18px;
		font-size: 15px;
		line-height: 1.8;
	}

	.news-card__more {
		font-size: 14px;
	}

	.features__grid {
		grid-template-columns: 1fr;
	}

	.feature-card {
		padding: 36px 28px;
	}
	.safety__content {
		grid-template-columns: 1fr;
		gap: 28px;
	}

	.safety__image {
		order: 1;
	}

	.safety__body {
		order: 2;
	}
}
</style>