---
import Layout from '../../layouts/Layout.astro';
---

<Layout>
	<main>
		<section class="page-hero">
			<img
				src="/images/about/takikawa-gakku.jpeg"
				alt=""
				class="page-hero__image"
			/>
			<div class="page-hero__overlay"></div>
			<h1>滝川学区について<br />
            ご紹介します</h1>
		</section>

		<nav class="breadcrumbs" aria-label="パンくずリスト">
			<div class="page-inner">
				<a href="/">Home</a>
				<span aria-hidden="true">/</span>
				<span>滝川学区の紹介</span>
			</div>
		</nav>

		<section class="about-section notices">
			<div class="page-inner">
				<h2>滝川学区自治協議会からの連絡事項</h2>

				<div class="notice-list">
					<div class="notice-item">
						<time datetime=""></time>
						<p>現在、連絡事項はありません</p>
					</div>
				</div>
			</div>
		</section>

		<section class="about-section">
			<div class="page-inner">
				<h2>滝川学区自治協議会<br />について</h2>

				<div class="two-column">
					<div>
						<img
							src="/images/about/takikawa-primary-school.png"
							alt="滝川小学校"
						/>
					</div>

                    <div class="prose">
                        <p>
                            滝川学区自治協議会は、 小学校区を1つの単位として構成し、活動を展開している
                            「学区連絡協議会 = 学区連協」 と呼ばれる任意組織です。
                            名古屋市などの行政機関と連携・協力しながら、
                            地域をより良くしていくことを目指して活動しています。
                        </p>

                        <p>
                            なお、学区連協は、現在、名古屋市内 267 学区のうち266の学区で組織されています。
                        </p>

                        <p>
                            一般的には、学区連協は、区域内の町内会・自治会の他、
                            区政協力委員会や民生委員・児童委員協議会、消防団、子ども会などの団体で構成されていますが、
                            あくまでも任意団体であるため、構成団体は学区連協ごとに決めることができます。
                            滝川学区では加盟していない小学校PTAや学童保育所などが構成団体として入っている学区もあります。
                        </p>

                        <p>
                            また、学区連協の運営に関しても、任意団体であるために公的な条例や規則等もなく、
                            各学区連協において、市が作成した「準則」に基づいた規約等を設けて実施しています。
                        </p>
                    </div>
				</div>
			</div>
		</section>

        <section class="about-section">
            <div class="page-inner">
                <h2>滝川学区だより</h2>

                <div class="prose prose--center">
                    <p>
                        滝川学区自治協議会では、地域のみなさまへ活動内容やお知らせをお伝えするため、
                        「滝川学区だより」を発行しています。
                    </p>

                    <div class="about-links">
                        <a class="text-link" href="/about/takikawagakku_newsletter/">
                            滝川学区だよりを見る
                        </a>

                        <a class="text-link" href="/about/takikawa_circular_notice/">
                            回覧板情報を見る
                        </a>
                    </div>
                </div>
            </div>
        </section>

		<section class="about-section">
			<div class="page-inner">
                <h2>
				滝川学区自治協議会<br />
				の構成
				</h2>

                <p class="section-lead">
                    滝川学区自治協議会は滝川学区のさまざまな団体で構成されています。
                </p>
				<h2>自治協議会の構成</h2>
				<div class="takikawa-structure">
					<button
						class="takikawa-flyer-button"
						type="button"
						data-lightbox-image="/images/about/takikawa-chart.png"
						data-lightbox-group="takikawa-flyer"
						aria-label="滝川学区自治協議会の構成図を拡大表示"
					>
						<img
							src="/images/about/takikawa-chart.png"
							alt="滝川学区自治協議会の構成図"
						/>
					</button>
				</div>
			</div>
		</section>

		<section class="about-section">
			<div class="page-inner">
				<h2>学区の構成</h2>
				<img
					class="wide-image"
					src="/images/about/takikawa-organization-map.png"
					alt="滝川学区の構成"
				/>
			</div>
		</section>

		<section class="about-section">
			<div class="page-inner">
				<h2>役員会</h2>
				<img
					class="wide-image"
					src="/images/about/executive-committee.png"
					alt="役員会"
				/>
			</div>
		</section>

		<section class="about-section">
			<div class="page-inner">
				<h2>事務局</h2>
				<img
					class="wide-image"
					src="/images/about/secretariat.png"
					alt="事務局"
				/>
			</div>
		</section>

		<section class="about-section">
			<div class="page-inner">
				<h2>関係団体</h2>
				<img
					class="wide-image"
					src="/images/about/related-organization.png"
					alt="関係団体"
				/>
			</div>
		</section>

		<section class="about-section">
			<div class="page-inner">
				<h2>町内会</h2>
				<img
					class="wide-image"
					src="/images/about/neighborhood-association.png"
					alt="町内会"
				/>
			</div>
		</section>

		<section class="about-section">
			<div class="page-inner">
				<h2>加子母村との交流</h2>

				<div class="two-column">
					<div>
						<img
							src="/images/about/kashimo-osugi.jpg"
							alt="加子母の大杉"
						/>
					</div>

                    <div class="prose">
                        <p>
                            四季折々の彩りに染まる山に囲まれ、木曽川水系の付知川、白川の2本の川の源流域にある
                            「中津川市加子母地区。20年に一度軌り行われる伊勢神宮式年遷宮の御用材は
                            加子母裏木曽国有林からきり出されています。
                        </p>

                        <p>
                            滝川学区と岐阜県中津川市の山間地・加子母地区。
                            都市と農山村というまったく異なる土地が、新たな地域交流
                            その背景には、両地域をつなぐ歴史的なご縁があるのです。
                        </p>

                        <p>
                            その鍵を握るのが、学区内にある「香積院」です。
                        </p>

                        <p>
                            「香積院」は、鎌倉時代、木曽義仲とその一族を弔うために建立されたとされる
                            「大威徳寺」がルーツ。その大威徳寺があったのが、まさに加子母地区なのです。
                            江戸時代に入り、大威徳寺は尾張藩の命により名古屋に移され、
                            現在の香積院となったという説があります。
                        </p>

                        <p>
                            「自分たちの地域をもっと知ってほしい」と願う加子母地区と、
                            「つながりのある地域と交流を深めたい」と考えていた滝川学区。
                            その想いが重なり2023年11月、地域の枠を越えた交流がスタート。
                            伊勢神宮や姫路城の修復にも使われた「東濃ひのき」や「かしもトマト」など、
                            これからも加子母の魅力的な自然や特産品を紹介していきます。
                        </p>
                    </div>
				</div>
			</div>
		</section>
		<div
			class="image-lightbox"
			id="takikawa-lightbox"
			aria-hidden="true"
		>
			<button
				class="image-lightbox__close"
				type="button"
				aria-label="画像を閉じる"
			>
				×
			</button>

			<div class="image-lightbox__content">
				<img
					class="image-lightbox__image"
					src=""
					alt=""
				/>
			</div>
		</div>
	</main>
</Layout>

<style>
	.page-inner {
		width: min(1120px, calc(100% - 48px));
		margin: 0 auto;
	}

	.page-hero {
		position: relative;
		height: 420px;
		display: grid;
		place-items: center;
		overflow: hidden;
		color: #fff;
	}

	.page-hero__image {
		position: absolute;
		inset: 0;
		width: 100%;
		height: 100%;
		object-fit: cover;
	}

	.page-hero__overlay {
		position: absolute;
		inset: 0;
		background: rgb(0 0 0 / 18%);
	}

	.page-hero h1 {
		position: relative;
		z-index: 1;
		margin: 0;
		font-size: clamp(36px, 4vw, 56px);
		font-weight: 400;
	}

	.breadcrumbs {
		padding: 48px 0;
		background: #f4f9fc;
	}

	.breadcrumbs .page-inner {
		display: flex;
		gap: 8px;
		font-size: 14px;
	}

	.breadcrumbs a {
		color: #338acb;
		text-decoration: none;
	}

    .section-lead {
        margin: -24px auto 40px;
        text-align: center;
        font-size: 16px;
        line-height: 1.9;
    }

	.about-section {
		padding: 88px 0;
		background: #f4f9fc;
		color: #333;
	}

	.about-section:nth-of-type(even) {
		background: #fff;
	}

	.about-section h2 {
		margin: 0 0 56px;
		text-align: center;
		font-size: clamp(32px, 4vw, 48px);
		font-weight: 400;
		line-height: 1.35;
	}

	.notice-list {
		padding: 48px;
		background: #fff;
	}

	.notice-item {
		display: grid;
		grid-template-columns: 110px 1fr;
		gap: 24px;
		align-items: center;
	}

	.notice-item a {
		color: #00a6e9;
	}

	.two-column {
		display: grid;
		grid-template-columns: 1fr 1fr;
		gap: 64px;
		align-items: start;
	}

    .two-column img,
    .diagram-link img {
        display: block;
        width: 100%;
        height: auto;
    }

    .wide-image {
        display: block;
        width: 70%;
        height: auto;
        margin: 0 auto;
    }

	.prose {
		font-size: 16px;
		line-height: 1.9;
	}

	.diagram-link {
		display: block;
		max-width: 900px;
		margin: 0 auto;
		cursor: zoom-in;
	}

    .prose--center {
        max-width: 760px;
        margin: 0 auto;
        text-align: center;
    }

    .text-link {
        color: #00a6e9;
        text-decoration: underline;
        text-underline-offset: 0.2em;
    }

    .about-links {
        display: flex;
        justify-content: center;
        gap: 32px;
        margin-top: 24px;
    }

	/* =========================================================
	   Flyer button
	========================================================= */

	.takikawa-flyer-button {
		display: block;
		width: 100%;
		padding: 0;
		border: 0;
		background: transparent;
		cursor: zoom-in;
	}

	.takikawa-flyer-button img {
		display: block;
		width: 100%;
		height: auto;
	}

	/* =========================================================
	   Lightbox
	========================================================= */

	.image-lightbox {
		position: fixed;
		z-index: 9999;
		inset: 0;
		display: none;
		align-items: center;
		justify-content: center;
		padding: 48px;
		background: rgb(0 0 0 / 88%);
	}

	.image-lightbox.is-open {
		display: flex;
	}

	.image-lightbox__content {
		display: flex;
		max-width: 100%;
		max-height: 100%;
		align-items: center;
		justify-content: center;
	}

	.image-lightbox__image {
		display: block;
		width: auto;
		height: auto;
		max-width: min(1500px, 94vw);
		max-height: 88vh;
		object-fit: contain;

		cursor: zoom-in;
		user-select: none;
		-webkit-user-drag: none;
		touch-action: none;

		transition: transform 0.15s ease;
		transform-origin: center center;
	}

	.image-lightbox__image.is-zoomed {
		cursor: grab;
		transition: none;
	}

	.image-lightbox__image.is-dragging {
		cursor: grabbing;
	}

	.image-lightbox__close {
		position: absolute;
		top: 18px;
		right: 24px;
		width: 48px;
		height: 48px;
		padding: 0;
		border: 0;
		background: transparent;
		color: #fff;
		cursor: pointer;
		font-size: 42px;
		line-height: 1;
	}


	@media (max-width: 768px) {
		.page-hero {
			height: 300px;
		}

		.page-inner {
			width: min(100% - 32px, 1120px);
		}

		.about-section {
			padding: 64px 0;
		}

		.two-column {
			grid-template-columns: 1fr;
			gap: 32px;
		}

		.notice-item {
			grid-template-columns: 1fr;
			gap: 8px;
		}

        .wide-image {
            width: 100%;
        }

        .about-links {
            flex-direction: column;
            align-items: center;
            gap: 16px;
        }

        .page-hero {
            height: 300px;
            padding: 0 24px;
            box-sizing: border-box;
        }

        .page-hero h1 {
            width: 100%;
            max-width: 520px;
            margin: 0 auto;
            font-size: clamp(30px, 9vw, 40px);
            line-height: 1.35;
            text-align: center;
            letter-spacing: 0;
        }

        .page-hero__image {
            object-position: center;
        }
	}
</style>
<script>
	const lightbox = document.querySelector('#takikawa-lightbox');
	const lightboxImage = lightbox?.querySelector('.image-lightbox__image');
	const closeButton = lightbox?.querySelector('.image-lightbox__close');

	const prevButton = null;
	const nextButton = null;
	const counter = null;

	let currentGroup = [];
	let currentIndex = 0;

	const updateLightbox = () => {
		if (
			!(lightboxImage instanceof HTMLImageElement) ||
			currentGroup.length === 0
		) {
			return;
		}

		const currentButton = currentGroup[currentIndex];

		if (!(currentButton instanceof HTMLElement)) return;

		const src = currentButton.dataset.lightboxImage;
		const image = currentButton.querySelector('img');

		if (!src) return;

		lightboxImage.src = src;
		lightboxImage.alt =
			image instanceof HTMLImageElement ? image.alt : '';

		if (counter) {
			counter.textContent =
				`${currentIndex + 1} / ${currentGroup.length}`;
		}

		if (prevButton instanceof HTMLButtonElement) {
			prevButton.disabled = currentGroup.length <= 1;
		}

		if (nextButton instanceof HTMLButtonElement) {
			nextButton.disabled = currentGroup.length <= 1;
		}
	};

	const openLightbox = (button) => {
		if (
			!lightbox ||
			!(button instanceof HTMLElement)
		) {
			return;
		}

		const groupName = button.dataset.lightboxGroup;

		if (!groupName) return;

		currentGroup = Array.from(
			document.querySelectorAll('[data-lightbox-image]')
		).filter((item) => {
			return (
				item instanceof HTMLElement &&
				item.dataset.lightboxGroup === groupName
			);
		});

		currentIndex = currentGroup.indexOf(button);

		if (currentIndex < 0) {
			currentIndex = 0;
		}

		updateLightbox();

		lightbox.classList.add('is-open');
		lightbox.setAttribute('aria-hidden', 'false');
		document.body.style.overflow = 'hidden';
	};

	const closeLightbox = () => {
		if (!lightbox) return;

		lightbox.classList.remove('is-open');
		lightbox.setAttribute('aria-hidden', 'true');

		if (lightboxImage instanceof HTMLImageElement) {
			lightboxImage.src = '';
		}

		currentGroup = [];
		currentIndex = 0;
		document.body.style.overflow = '';
	};

	const showPrevious = () => {
		if (currentGroup.length <= 1) return;

		currentIndex =
			(currentIndex - 1 + currentGroup.length) %
			currentGroup.length;

		updateLightbox();
	};

	const showNext = () => {
		if (currentGroup.length <= 1) return;

		currentIndex =
			(currentIndex + 1) %
			currentGroup.length;

		updateLightbox();
	};

	/*
	 * 重要：
	 * 個々の画像ボタンではなく document でクリックを監視する。
	 */
	document.addEventListener('click', (event) => {
		if (!(event.target instanceof Element)) return;

		const button = event.target.closest('[data-lightbox-image]');

		if (!(button instanceof HTMLElement)) return;

		event.preventDefault();
		event.stopPropagation();

		openLightbox(button);
	});

	closeButton?.addEventListener('click', (event) => {
		event.stopPropagation();
		closeLightbox();
	});

	let isZoomed = false;
	let isDragging = false;

	let imageX = 0;
	let imageY = 0;

	let dragStartX = 0;
	let dragStartY = 0;

	const zoomScale = 2;

	const applyImageTransform = () => {
		if (!(lightboxImage instanceof HTMLImageElement)) return;

		if (!isZoomed) {
			lightboxImage.style.transform = '';
			return;
		}

		lightboxImage.style.transform =
			`translate(${imageX}px, ${imageY}px) scale(${zoomScale})`;
	};

	const resetZoom = () => {
		if (!(lightboxImage instanceof HTMLImageElement)) return;

		isZoomed = false;
		isDragging = false;

		imageX = 0;
		imageY = 0;

		lightboxImage.classList.remove(
			'is-zoomed',
			'is-dragging'
		);

		lightboxImage.style.transform = '';
	};

	const toggleZoom = () => {
		if (!(lightboxImage instanceof HTMLImageElement)) return;

		if (isZoomed) {
			resetZoom();
			return;
		}

		isZoomed = true;
		imageX = 0;
		imageY = 0;

		lightboxImage.classList.add('is-zoomed');

		applyImageTransform();
	};

	/*
	* クリック / タップで拡大・縮小
	*/
	lightboxImage?.addEventListener('click', (event) => {
		event.preventDefault();
		event.stopPropagation();

		if (isDragging) return;

		toggleZoom();
	});

	/*
	* ドラッグ開始
	*/
	lightboxImage?.addEventListener('mousedown', (event) => {
		if (
			!isZoomed ||
			!(lightboxImage instanceof HTMLImageElement)
		) {
			return;
		}

		event.preventDefault();
		event.stopPropagation();

		isDragging = true;

		dragStartX = event.clientX - imageX;
		dragStartY = event.clientY - imageY;

		lightboxImage.classList.add('is-dragging');
	});

	/*
	* 重要：
	* mousemove は画像ではなく document で監視する
	*/
	document.addEventListener('mousemove', (event) => {
		if (!isDragging || !isZoomed) return;

		event.preventDefault();

		imageX = event.clientX - dragStartX;
		imageY = event.clientY - dragStartY;

		applyImageTransform();
	});

	/*
	* ドラッグ終了
	*/
	document.addEventListener('mouseup', () => {
		if (!isDragging) return;

		isDragging = false;

		if (lightboxImage instanceof HTMLImageElement) {
			lightboxImage.classList.remove('is-dragging');
		}
	});

	lightboxImage?.addEventListener('pointerdown', (event) => {
		if (
			!isZoomed ||
			!(lightboxImage instanceof HTMLImageElement)
		) {
			return;
		}

		event.preventDefault();

		isDragging = true;

		dragStartX = event.clientX - imageX;
		dragStartY = event.clientY - imageY;

		lightboxImage.classList.add('is-dragging');
		lightboxImage.setPointerCapture(event.pointerId);
	});

	lightboxImage?.addEventListener('pointermove', (event) => {
		if (
			!isDragging ||
			!isZoomed ||
			!(lightboxImage instanceof HTMLImageElement)
		) {
			return;
		}

		event.preventDefault();

		imageX = event.clientX - dragStartX;
		imageY = event.clientY - dragStartY;

		applyImageTransform();
	});

	lightboxImage?.addEventListener('pointerup', (event) => {
		if (!(lightboxImage instanceof HTMLImageElement)) return;

		isDragging = false;

		lightboxImage.classList.remove('is-dragging');

		if (lightboxImage.hasPointerCapture(event.pointerId)) {
			lightboxImage.releasePointerCapture(event.pointerId);
		}
	});

	lightboxImage?.addEventListener('pointercancel', () => {
		isDragging = false;
		lightboxImage?.classList.remove('is-dragging');
	});

	prevButton?.addEventListener('click', (event) => {
		event.stopPropagation();
		showPrevious();
	});

	nextButton?.addEventListener('click', (event) => {
		event.stopPropagation();
		showNext();
	});

	lightbox?.addEventListener('click', (event) => {
		if (event.target === lightbox) {
			closeLightbox();
		}
	});

	document.addEventListener('keydown', (event) => {
		if (!lightbox?.classList.contains('is-open')) return;

		if (event.key === 'Escape') {
			closeLightbox();
		}

		if (event.key === 'ArrowLeft') {
			showPrevious();
		}

		if (event.key === 'ArrowRight') {
			showNext();
		}
	});
</script>
