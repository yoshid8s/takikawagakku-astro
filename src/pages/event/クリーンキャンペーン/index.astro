---
import Layout from '../../../layouts/Layout.astro';
import { cleanCampaignRecords } from '../../../data/cleanCampaignRecords';
---
<Layout>
	<main>

		<section class="page-hero">
			<img
				src="/images/event/clean-campaign/hero.jpg"
				alt=""
				class="page-hero__image"
			/>

			<div class="page-hero__overlay"></div>

			<div class="page-hero__content">
				<h1>クリーンキャンペーン</h1>
			</div>
		</section>
		<nav class="breadcrumbs" aria-label="パンくずリスト">
			<div class="page-inner">
				<a href="/">Home</a>
				<span>/</span>
				<a href="/event/">イベント</a>
				<span>/</span>
				<span>クリーンキャンペーン</span>
			</div>
		</nav>
		<section class="clean-intro">
			<div class="page-inner">
				<h2>
					滝川おそうじ隊<br />
					クリーンキャンペーン当日の流れ
				</h2>

				<div class="intro-grid">
					<div class="intro-image">
						<img
							src="/images/event/clean-campaign/main.jpg"
							alt="クリーンキャンペーン"
						/>
					</div>

					<div class="prose">
						<ul class="clean-flow">
							<li>
								<strong>9:45</strong>
								滝川公園集合
							</li>

							<li>
								<strong>10:00～10:50</strong>
								清掃活動<br />
								２つのルートに分かれて滝川学区内の道路を清掃します。
							</li>

							<li>
								<strong>10:50</strong>
								挨拶をして解散
							</li>
						</ul>

						<h3>注意事項など</h3>

						<ul>
							<li>軍手・ゴミ袋・ゴミばさみは用意します。</li>
							<li>
								回収したごみは、滝川公園で滝川学区自治協議会が回収します。
							</li>
							<li>
								その他の清掃道具が必要な方は各自でご用意ください。
							</li>
							<li>
								子どもにはお菓子、大人には粗品が出ます。最後に滝川公園でお渡しします。
							</li>
						</ul>
					</div>
				</div>
			</div>
		</section>
		<section class="clean-current">
			<div class="page-inner narrow">
				<h2>クリーンキャンペーン2026 概要</h2>

				<div class="event-details">
					<p>
						<strong>【開催期日】</strong>
						2026年6月6日（土）
					</p>

					<p>
						※名古屋市のクリーンキャンペーンと連携して実施
					</p>

					<p>
						2026年11月　クリーンキャンペーン月間（予定）
					</p>

					<p>
						※詳細は、決まり次第ご案内いたします。
					</p>
				</div>
			</div>
		</section>
		<section class="clean-records">
			<div class="page-inner">
				{
					cleanCampaignRecords.map((record) => (
						<article class="record">
							<button
								class="record-toggle"
								type="button"
								aria-expanded="false"
							>
								<span>
									クリーンキャンペーン{record.year}結果報告
								</span>

								<span
									class="record-toggle__icon"
									aria-hidden="true"
								>
									＋
								</span>
							</button>

							<div class="record-content">
								<section class="record-section record-summary-section">
									<h3>開催概要</h3>

									<p class="record-summary">
										{record.summary}
									</p>
								</section>

								<div class="record-details">
									{record.date && (
										<p>
											<strong>【開催期日】</strong>
											<span>{record.date}</span>
										</p>
									)}

									{record.time && (
										<p>
											<strong>【開催時間】</strong>
											<span>{record.time}</span>
										</p>
									)}

									{record.venue && (
										<p>
											<strong>【集合場所】</strong>
											<span>{record.venue}</span>
										</p>
									)}

									{record.participants && (
										<p>
											<strong>【参加者】</strong>
											<span>{record.participants}</span>
										</p>
									)}

									{record.contents && (
										<p>
											<strong>【活動内容】</strong>
											<span>{record.contents}</span>
										</p>
									)}
								</div>

								{record.photos && record.photos.length > 0 && (
									<section class="record-section">
										<h3>当日の写真</h3>

										<div class="photo-grid">
											{record.photos.map((image, index) => (
												<button
													class="record-photo"
													type="button"
													data-lightbox-image={image.src}
													data-lightbox-group={`clean-${record.year}-photos`}
													data-lightbox-index={index}
													aria-label={`${image.alt}を拡大表示`}
												>
													<img
														src={image.src}
														alt={image.alt}
														loading="lazy"
													/>
												</button>
											))}
										</div>
									</section>
								)}

								{record.flyers && record.flyers.length > 0 && (
									<section class="record-section">
										<h3>チラシ</h3>

										<div class="flyer-grid">
											{record.flyers.map((image, index) => (
												<button
													class="flyer"
													type="button"
													data-lightbox-image={image.src}
													data-lightbox-group={`clean-${record.year}-flyers`}
													data-lightbox-index={index}
													aria-label={`${image.alt}を拡大表示`}
												>
													<img
														src={image.src}
														alt={image.alt}
														loading="lazy"
													/>
												</button>
											))}
										</div>
									</section>
								)}
							</div>
						</article>
					))
				}
			</div>
		</section>

		<div
			class="lightbox"
			data-lightbox
			aria-hidden="true"
		>
			<button
				class="lightbox__close"
				type="button"
				aria-label="閉じる"
			>
				×
			</button>

			<button
				class="lightbox__nav lightbox__nav--prev"
				type="button"
				aria-label="前の画像"
			>
				‹
			</button>

			<div class="lightbox__content">
				<img
					class="lightbox__image"
					src=""
					alt=""
				/>

				<p class="lightbox__counter"></p>
			</div>

			<button
				class="lightbox__nav lightbox__nav--next"
				type="button"
				aria-label="次の画像"
			>
				›
			</button>
		</div>

	</main>
</Layout>
<style>
	.page-inner {
		width: min(1120px, calc(100% - 48px));
		margin: 0 auto;
	}

	.narrow {
		max-width: 900px;
	}

	.page-hero {
		position: relative;
		height: 420px;
		overflow: hidden;
	}

	.page-hero__image {
		display: block;
		width: 100%;
		height: 100%;
		object-fit: cover;
		object-position: center;
	}

	.page-hero__overlay {
		position: absolute;
		inset: 0;
		background: rgb(0 0 0 / 20%);
	}

	.page-hero__content {
		position: absolute;
		inset: 0;
		display: grid;
		place-items: center;
		padding: 24px;
	}

	.page-hero h1 {
		margin: 0;
		color: #fff;
		font-size: clamp(38px, 4vw, 60px);
		font-weight: 400;
		text-align: center;
	}

	.breadcrumbs {
		padding: 32px 0;
		background: #fff;
	}

	.breadcrumbs .page-inner {
		display: flex;
		flex-wrap: wrap;
		gap: 8px;
		font-size: 14px;
	}

	.breadcrumbs a,
	.text-link {
		color: #00a6e9;
		text-underline-offset: 0.2em;
	}

	.clean-intro {
		padding: 88px 0;
		background: #f4f9fc;
	}

	.clean-intro h2 {
		margin: 0 0 56px;
		text-align: center;
		font-size: clamp(32px, 4vw, 46px);
		font-weight: 400;
		line-height: 1.4;
	}

	.clean-current {
		padding: 88px 0;
		background: #fff;
	}

	.clean-current h2 {
		margin: 0 0 48px;
		text-align: center;
		font-size: clamp(30px, 4vw, 42px);
		font-weight: 400;
		line-height: 1.4;
	}

	.event-details {
		max-width: 900px;
		margin: 0 auto;
		font-size: 16px;
		line-height: 2;
	}

	.event-details p {
		margin: 0 0 18px;
	}

	.clean-records {
		padding: 88px 0;
		background: #fff;
	}

	.clean-flow {
		margin: 0 0 32px;
		padding-left: 1.4em;
	}

	.clean-flow li {
		margin-bottom: 20px;
	}

	.clean-flow strong {
		display: block;
		margin-bottom: 4px;
	}

	.intro-grid {
		display: grid;
		grid-template-columns: minmax(0, 0.9fr) minmax(0, 1.1fr);
		gap: 64px;
		align-items: start;
	}

	.intro-image img {
		display: block;
		width: 100%;
		height: auto;
	}

	.prose {
		font-size: 16px;
		line-height: 2;
	}

	.prose p {
		margin: 0 0 22px;
	}

	.prose--narrow {
		max-width: 900px;
		margin: 0 auto;
	}

	.rules ul {
		margin: 0 0 28px;
		padding-left: 1.5em;
	}

	.flyer-grid {
		display: grid;
		grid-template-columns: repeat(2, minmax(0, 1fr));
		gap: 32px;
		max-width: 1000px;
		margin: 48px auto 0;
	}

	.flyer {
		display: block;
		padding: 0;
		border: 0;
		background: transparent;
		cursor: zoom-in;
	}

	.flyer img {
		display: block;
		width: 100%;
		height: auto;
	}
    
    /* 年次記録 */

    .record {
        border-top: 1px solid #d9e0e5;
    }

    .record:last-child {
        border-bottom: 1px solid #d9e0e5;
    }

    .record-toggle {
        display: flex;
        width: 100%;
        align-items: center;
        justify-content: space-between;
        gap: 24px;
        padding: 28px 0;
        border: 0;
        background: transparent;
        color: #111827;
        font-size: clamp(24px, 3vw, 34px);
        font-weight: 500;
        text-align: left;
        cursor: pointer;
    }

    .record-toggle:hover {
        color: #ea7300;
    }

    .record-toggle__icon {
        flex: 0 0 auto;
        font-size: 28px;
        font-weight: 300;
        transition: transform 0.2s ease;
    }

    .record-toggle[aria-expanded='true'] .record-toggle__icon {
        transform: rotate(45deg);
    }

    .record-content {
        display: none;
        padding: 16px 0 72px;
    }

    .record-content.is-open {
        display: block;
    }

    .record-section {
        margin-top: 64px;
    }

    .record-summary-section {
        max-width: 1100px;
        margin: 24px auto 0;
    }

    .record-section h3 {
        margin: 0 0 32px;
        text-align: center;
        font-size: 26px;
        font-weight: 500;
    }

    .record-summary {
        margin: 0;
        font-size: 16px;
        line-height: 2;
        letter-spacing: 0.02em;
    }

    .record-details {
        max-width: 1100px;
        margin: 48px auto 0;
    }

    .record-details p {
        display: grid;
        grid-template-columns: max-content 1fr;
        column-gap: 16px;
        margin: 0 0 18px;
        font-size: 16px;
        line-height: 1.8;
    }

    .record-details strong {
        white-space: nowrap;
    }

    .photo-grid {
        display: grid;
        grid-template-columns: repeat(3, minmax(0, 1fr));
        gap: 20px;
        margin-top: 32px;
    }

    .record-photo {
        padding: 0;
        border: 0;
        background: transparent;
        cursor: zoom-in;
    }

    .record-photo img {
        display: block;
        width: 100%;
        aspect-ratio: 4 / 3;
        object-fit: cover;
    }

    .flyer-grid {
        display: grid;
        grid-template-columns: repeat(2, minmax(0, 1fr));
        gap: 32px;
        max-width: 1000px;
        margin: 32px auto 0;
    }

    .flyer {
        display: block;
        padding: 0;
        border: 0;
        background: transparent;
        cursor: zoom-in;
    }

    .flyer img {
        display: block;
        width: 100%;
        height: auto;
    }

	/* lightbox */

	.lightbox {
		position: fixed;
		inset: 0;
		z-index: 3000;
		display: none;
		align-items: center;
		justify-content: center;
		padding: 40px 90px;
		background: rgb(0 0 0 / 88%);
	}

	.lightbox.is-open {
		display: flex;
	}

	.lightbox__content {
		position: relative;
		display: flex;
		max-width: 100%;
		max-height: 100%;
		flex-direction: column;
		align-items: center;
		justify-content: center;
		overflow: hidden;
	}

	.lightbox__image {
		display: block;
		max-width: 94%;
		max-height: 86vh;
		width: auto;
		height: auto;
		object-fit: contain;
		cursor: zoom-in;
		user-select: none;
		-webkit-user-drag: none;
		transform: translate(0, 0) scale(1);
		transform-origin: center center;
		transition: transform 0.2s ease;
	}

	.lightbox__image.is-zoomed {
		cursor: grab;
		transition: none;
	}

	.lightbox__image.is-dragging {
		cursor: grabbing;
	}

	.lightbox__close {
		position: absolute;
		top: 20px;
		right: 24px;
		z-index: 2;
		width: 48px;
		height: 48px;
		border: 0;
		background: transparent;
		color: #fff;
		font-size: 40px;
		cursor: pointer;
	}

	.lightbox__nav {
		position: absolute;
		top: 50%;
		z-index: 2;
		display: grid;
		width: 56px;
		height: 72px;
		place-items: center;
		border: 0;
		background: rgb(0 0 0 / 25%);
		color: #fff;
		font-size: 56px;
		cursor: pointer;
		transform: translateY(-50%);
	}

	.lightbox__nav--prev {
		left: 20px;
	}

	.lightbox__nav--next {
		right: 20px;
	}

	.lightbox__counter {
		margin: 12px 0 0;
		color: #fff;
		font-size: 13px;
	}


    @media (max-width: 480px) {
        .photo-grid {
            grid-template-columns: 1fr;
        }
    }

	@media (max-width: 768px) {
		.page-inner {
			width: min(100% - 32px, 1120px);
		}

		.page-hero {
			height: 300px;
		}

		.page-hero h1 {
			font-size: 36px;
		}

		.clean-intro,
		.clean-records {
			padding: 64px 0;
		}

		.clean-current {
			padding: 64px 0;
		}

		.clean-current h2 {
			margin-bottom: 36px;
		}

		.event-details {
			font-size: 15px;
			line-height: 1.9;
		}

		.intro-grid {
			grid-template-columns: 1fr;
			gap: 36px;
		}

		.flyer-grid {
			grid-template-columns: 1fr;
			gap: 24px;
		}

		.lightbox {
			padding: 64px 50px 32px;
		}

		.lightbox__image {
			max-width: 100%;
			max-height: 78vh;
		}

		.lightbox__nav {
			width: 44px;
			height: 60px;
			font-size: 44px;
		}

		.lightbox__nav--prev {
			left: 4px;
		}

		.lightbox__nav--next {
			right: 4px;
		}

        .record-toggle {
            padding: 22px 0;
            font-size: 22px;
        }

        .record-content {
            padding-bottom: 56px;
        }

        .record-section {
            margin-top: 48px;
        }

        .record-details {
            margin-top: 36px;
        }

        .record-details p {
            display: block;
            margin-bottom: 16px;
        }

        .record-details strong {
            display: block;
            margin-bottom: 4px;
        }

        .photo-grid {
            grid-template-columns: repeat(2, minmax(0, 1fr));
            gap: 12px;
        }
	}
</style>
<script>
	const lightbox = document.querySelector('[data-lightbox]');
	const lightboxImage = lightbox?.querySelector('.lightbox__image');
	const closeButton = lightbox?.querySelector('.lightbox__close');
	const prevButton = lightbox?.querySelector('.lightbox__nav--prev');
	const nextButton = lightbox?.querySelector('.lightbox__nav--next');
	const counter = lightbox?.querySelector('.lightbox__counter');

	let currentImages = [];
	let currentIndex = 0;

	let isZoomed = false;
    let didDrag = false;

    const DRAG_THRESHOLD = 5;

	let isDragging = false;

	let translateX = 0;
	let translateY = 0;

	let dragStartX = 0;
	let dragStartY = 0;
	let dragOriginX = 0;
	let dragOriginY = 0;

	const ZOOM_SCALE = 2;

	const updateTransform = () => {
		if (!lightboxImage) return;

		const scale = isZoomed ? ZOOM_SCALE : 1;

		lightboxImage.style.transform =
			`translate(${translateX}px, ${translateY}px) scale(${scale})`;
	};

	const resetZoom = () => {
		if (!lightboxImage) return;

		isZoomed = false;
		isDragging = false;

		translateX = 0;
		translateY = 0;

		lightboxImage.classList.remove('is-zoomed', 'is-dragging');

		updateTransform();
	};

	const renderImage = () => {
		if (!lightboxImage || currentImages.length === 0) return;

		resetZoom();

		const current = currentImages[currentIndex];

		lightboxImage.setAttribute(
			'src',
			current.getAttribute('data-lightbox-image') || ''
		);

		const thumbnail = current.querySelector('img');

		lightboxImage.setAttribute(
			'alt',
			thumbnail?.getAttribute('alt') || ''
		);

		if (counter) {
			counter.textContent =
				currentImages.length > 1
					? `${currentIndex + 1} / ${currentImages.length}`
					: '';
		}

		const hasMultiple = currentImages.length > 1;

		if (prevButton) {
			prevButton.hidden = !hasMultiple;
		}

		if (nextButton) {
			nextButton.hidden = !hasMultiple;
		}
	};

	const showPrevious = () => {
		if (currentImages.length < 2) return;

		currentIndex =
			(currentIndex - 1 + currentImages.length) %
			currentImages.length;

		renderImage();
	};

	const showNext = () => {
		if (currentImages.length < 2) return;

		currentIndex =
			(currentIndex + 1) %
			currentImages.length;

		renderImage();
	};

	const closeLightbox = () => {
		if (!lightbox || !lightboxImage) return;

		resetZoom();

		lightbox.classList.remove('is-open');
		lightbox.setAttribute('aria-hidden', 'true');

		lightboxImage.setAttribute('src', '');

		currentImages = [];
		currentIndex = 0;

		document.body.style.overflow = '';
	};

	document.querySelectorAll('[data-lightbox-image]').forEach((button) => {
		button.addEventListener('click', () => {
			if (!lightbox || !lightboxImage) return;

			const group = button.getAttribute('data-lightbox-group');

			currentImages = Array.from(
				document.querySelectorAll(
					`[data-lightbox-group="${group}"]`
				)
			);

			currentIndex = currentImages.indexOf(button);

			renderImage();

			lightbox.classList.add('is-open');
			lightbox.setAttribute('aria-hidden', 'false');

			document.body.style.overflow = 'hidden';
		});
	});

    lightboxImage?.addEventListener('click', () => {
        if (didDrag) {
            didDrag = false;
            return;
        }

        if (isZoomed) {
            resetZoom();
            return;
        }

        isZoomed = true;
        translateX = 0;
        translateY = 0;

        lightboxImage.classList.add('is-zoomed');

        updateTransform();
    });

	lightboxImage?.addEventListener('pointerdown', (event) => {
        if (!isZoomed) return;

        isDragging = true;
        didDrag = false;

        dragStartX = event.clientX;
        dragStartY = event.clientY;

        dragOriginX = translateX;
        dragOriginY = translateY;

        lightboxImage.classList.add('is-dragging');
        lightboxImage.setPointerCapture(event.pointerId);

        event.preventDefault();
	});

	lightboxImage?.addEventListener('pointermove', (event) => {
        if (!isZoomed || !isDragging) return;

        const deltaX = event.clientX - dragStartX;
        const deltaY = event.clientY - dragStartY;

        if (
            Math.abs(deltaX) > DRAG_THRESHOLD ||
            Math.abs(deltaY) > DRAG_THRESHOLD
        ) {
            didDrag = true;
        }

        translateX = dragOriginX + deltaX;
        translateY = dragOriginY + deltaY;

        updateTransform();
	});

	const stopDragging = (event) => {
		if (!isDragging || !lightboxImage) return;

		isDragging = false;
		lightboxImage.classList.remove('is-dragging');

		if (
			event?.pointerId !== undefined &&
			lightboxImage.hasPointerCapture(event.pointerId)
		) {
			lightboxImage.releasePointerCapture(event.pointerId);
		}
	};

	lightboxImage?.addEventListener('pointerup', stopDragging);
	lightboxImage?.addEventListener('pointercancel', stopDragging);

	prevButton?.addEventListener('click', showPrevious);
	nextButton?.addEventListener('click', showNext);
	closeButton?.addEventListener('click', closeLightbox);

	lightbox?.addEventListener('click', (event) => {
		if (event.target === lightbox) {
			closeLightbox();
		}
	});

	document.addEventListener('keydown', (event) => {
		if (!lightbox?.classList.contains('is-open')) return;

		if (event.key === 'Escape') {
			closeLightbox();
		}

		if (event.key === 'ArrowLeft') {
			showPrevious();
		}

		if (event.key === 'ArrowRight') {
			showNext();
		}
        });

        document.querySelectorAll('.record-toggle').forEach((toggle) => {
            toggle.addEventListener('click', () => {
                const record = toggle.closest('.record');
                const content = record?.querySelector('.record-content');

                if (!content) return;

                const isOpen = content.classList.toggle('is-open');

                toggle.setAttribute(
                    'aria-expanded',
                    String(isOpen)
                );
            });
        });
</script>