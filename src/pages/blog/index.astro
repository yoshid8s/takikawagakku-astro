---
import { getCollection } from 'astro:content';
import Layout from '../../layouts/Layout.astro';

const pageTitle = '新着情報';

const posts = (await getCollection('blog')).sort(
	(a, b) =>
		b.data.date.getTime() -
		a.data.date.getTime()
);

/* =========================================================
   Categories
========================================================= */

const categoryMap = new Map<
	string,
	{
		name: string;
		slug: string;
		count: number;
	}
>();

for (const post of posts) {
	for (const category of post.data.categories) {
		const existing =
			categoryMap.get(category.slug);

		if (existing) {
			existing.count += 1;
		} else {
			categoryMap.set(category.slug, {
				name: category.name,
				slug: category.slug,
				count: 1,
			});
		}
	}
}

const categories = Array.from(
	categoryMap.values()
).sort((a, b) =>
	a.name.localeCompare(
		b.name,
		'ja'
	)
);


/* =========================================================
   Monthly archives
========================================================= */

const archiveMap = new Map<
	string,
	{
		year: number;
		month: number;
		count: number;
	}
>();

for (const post of posts) {
	const year =
		post.data.date.getFullYear();

	const month =
		post.data.date.getMonth() + 1;

	const key =
		`${year}-${String(month).padStart(2, '0')}`;

	const existing =
		archiveMap.get(key);

	if (existing) {
		existing.count += 1;
	} else {
		archiveMap.set(key, {
			year,
			month,
			count: 1,
		});
	}
}

const archives = Array.from(
	archiveMap.values()
).sort((a, b) => {
	if (a.year !== b.year) {
		return b.year - a.year;
	}

	return b.month - a.month;
});


/* =========================================================
   Helpers
========================================================= */

const formatDate = (date: Date) =>
	date.toLocaleDateString('ja-JP', {
		year: 'numeric',
		month: 'long',
		day: 'numeric',
	});

const postHref = (slug: string) =>
	`/${encodeURIComponent(slug)}/`;
---

<Layout title={pageTitle}>
	<main class="blog-page">

		<!-- =====================================================
		     Header
		===================================================== -->

        <section class="blog-hero">
            <img
                src="/images/blog/whats-new-hero.png"
                alt=""
            />

            <div class="blog-hero__overlay">
                <div class="blog-hero__content">
                    <h1>新着情報</h1>

                    <p>
                        滝川学区自治協議会からのお知らせや、
                        地域のイベント・活動情報をご覧いただけます。
                    </p>
                </div>
            </div>
        </section>


		<!-- =====================================================
		     Filter navigation
		===================================================== -->

		<section class="blog-navigation">
			<div class="blog-navigation__inner">

				<!-- Categories -->

				<div class="blog-filter">
					<h2>カテゴリーから探す</h2>

					<div class="blog-categories">
						{
							categories.map((category) => (
								<a
									href={`/category/${encodeURIComponent(category.slug)}/`}
									class="blog-category"
								>
									<span>
										{category.name}
									</span>

									<span class="blog-category__count">
										{category.count}
									</span>
								</a>
							))
						}
					</div>
				</div>


				<!-- Archives -->

				<div class="blog-filter">
					<h2>月別に探す</h2>

					<div class="blog-archives">
						{
							archives.map((archive) => (
								<a
									href={`/${archive.year}/${String(
										archive.month
									).padStart(2, '0')}/`}
									class="blog-archive"
								>
									{archive.year}年
									{archive.month}月

									<span>
										（{archive.count}）
									</span>
								</a>
							))
						}
					</div>
				</div>

			</div>
		</section>


		<!-- =====================================================
		     Posts
		===================================================== -->

		<section class="blog-list">
			<div class="blog-list__inner">

				{
					posts.length === 0 ? (
						<p class="blog-list__empty">
							現在、新着情報はありません。
						</p>
					) : (
						<div class="blog-list__grid">

							{posts.map((post) => (

                            <article class="blog-card">
                                <a
                                    href={postHref(post.data.slug)}
                                    class="blog-card__link"
                                >
                                    <div class="blog-card__body">

                                        <div class="blog-card__meta">
                                            <time datetime={post.data.date.toISOString()}>
                                                {formatDate(post.data.date)}
                                            </time>
                                        </div>

                                        <h2>
                                            {post.data.title}
                                        </h2>

                                        {
                                            post.data.excerpt && (
                                                <p class="blog-card__excerpt">
                                                    {post.data.excerpt}
                                                </p>
                                            )
                                        }

                                        {
                                            post.data.categories.length > 0 && (
                                                <div class="blog-card__categories">
                                                    {
                                                        post.data.categories.map((category) => (
                                                            <span class="blog-card__category">
                                                                {category.name}
                                                            </span>
                                                        ))
                                                    }
                                                </div>
                                            )
                                        }

                                    </div>
                                </a>
                            </article>

							))}

						</div>
					)
				}

			</div>
		</section>

	</main>
</Layout>


<style>

    /* =========================================================
    Hero
    ========================================================= */

    .blog-hero {
        position: relative;
        width: 100%;
        height: clamp(280px, 32vw, 460px);
        overflow: hidden;
        background: #111827;
    }

    .blog-hero img {
        display: block;
        width: 100%;
        height: 100%;
        object-fit: cover;
        object-position: center;
    }

    .blog-hero__overlay {
        position: absolute;
        inset: 0;

        display: flex;
        align-items: center;
        justify-content: center;

        padding: 32px;

        background: rgb(0 0 0 / 22%);
    }

    .blog-hero__content {
        width: min(100%, 1000px);
        text-align: center;
    }

    .blog-hero h1 {
        margin: 0 0 24px;

        color: #fff;

        font-size: clamp(42px, 5vw, 64px);
        font-weight: 400;
        line-height: 1.3;

        text-shadow:
            0 2px 12px
            rgb(0 0 0 / 40%);
    }

    .blog-hero p {
        margin: 0;

        color: #fff;

        font-size: 17px;
        line-height: 1.9;

        text-shadow:
            0 1px 8px
            rgb(0 0 0 / 45%);
    }

	/* =========================================================
	   Page
	========================================================= */

	.blog-page {
		width: 100%;
		margin: 0;
		padding: 0;
		background: #fff;
		color: #111827;
	}


	/* =========================================================
	   Navigation
	========================================================= */

	.blog-navigation {
		padding: 56px 0;
		background: #fff;
		border-bottom: 1px solid #e5e7eb;
	}

	.blog-navigation__inner {
		display: grid;
		grid-template-columns:
			minmax(0, 1fr)
			minmax(260px, 340px);
		gap: 64px;

		width: min(calc(100% - 64px), 1180px);
		margin: 0 auto;
	}

	.blog-filter h2 {
		margin: 0 0 20px;
		font-size: 20px;
		font-weight: 600;
		line-height: 1.5;
	}


	/* =========================================================
	   Categories
	========================================================= */

	.blog-categories {
		display: flex;
		flex-wrap: wrap;
		gap: 10px;
	}

	.blog-category {
		display: inline-flex;
		align-items: center;
		gap: 7px;

		padding: 7px 14px;

		border: 1px solid #d7e0e7;
		border-radius: 999px;

		color: #374151;
		font-size: 14px;
		line-height: 1.4;

		text-decoration: none;

		transition:
			border-color 0.2s ease,
			color 0.2s ease,
			background 0.2s ease;
	}

	.blog-category:hover {
		border-color: #009fe8;
		background: #f4fbff;
		color: #009fe8;
	}

	.blog-category__count {
		color: #9ca3af;
		font-size: 12px;
	}


	/* =========================================================
	   Archives
	========================================================= */

	.blog-archives {
		display: flex;
		flex-wrap: wrap;
		gap: 8px 20px;
	}

	.blog-archive {
		color: #374151;
		font-size: 14px;
		line-height: 1.7;
		text-decoration: none;
	}

	.blog-archive:hover {
		color: #009fe8;
		text-decoration: underline;
		text-underline-offset: 0.2em;
	}

	.blog-archive span {
		color: #9ca3af;
		font-size: 12px;
	}


	/* =========================================================
	   List
	========================================================= */

	.blog-list {
		padding: 72px 0 112px;
		background: #f4f9fc;
	}

	.blog-list__inner {
		width: min(calc(100% - 64px), 1180px);
		margin: 0 auto;
	}

    .blog-list__grid {
        display: grid;
        grid-template-columns: repeat(2, minmax(0, 1fr));
        gap: 24px;
    }


	/* =========================================================
	   Card
	========================================================= */

    .blog-card {
        min-width: 0;
        background: #fff;
        border-radius: 6px;
        box-shadow: 0 8px 28px rgb(15 23 42 / 5%);
    }

    .blog-card__link {
        display: block;
        height: 100%;
        color: inherit;
        text-decoration: none;
    }


	/* Image */

    .blog-card__image {
        width: 100%;

        /* 16 / 10 → 少し横長に */
        aspect-ratio: 16 / 8;

        overflow: hidden;
        background: #edf2f5;
    }

    .blog-card__image img {
        display: block;
        width: 100%;
        height: 100%;
        object-fit: cover;
        object-position: center;

        transition:
            transform 0.35s ease;
    }

	.blog-card__link:hover
	.blog-card__image img {
		transform: scale(1.025);
	}


	/* Body */

    .blog-card__body {
        display: flex;
        flex-direction: column;
        height: 100%;
        padding: 28px 30px;
    }

    .blog-card__meta {
        margin-bottom: 12px;
    }

    .blog-card__meta time {
        color: #6b7280;
        font-size: 13px;
    }

    .blog-card h2 {
        margin: 0 0 14px;
        font-size: 20px;
        font-weight: 500;
        line-height: 1.65;
        transition: color 0.2s ease;
    }

    .blog-card__link:hover h2 {
        color: #009fe8;
    }

    .blog-card__excerpt {
        display: -webkit-box;
        margin: 0 0 22px;
        overflow: hidden;

        color: #4b5563;
        font-size: 14px;
        line-height: 1.8;

        -webkit-box-orient: vertical;
        -webkit-line-clamp: 3;
    }

	/* Card categories */

    .blog-card__categories {
        display: flex;
        flex-wrap: wrap;
        gap: 6px;
        margin-top: auto;
    }

    .blog-card__category {
        display: inline-flex;
        padding: 4px 9px;
        border-radius: 999px;
        background: #f4f9fc;
        color: #4b5563;
        font-size: 12px;
    }


	/* Empty */

	.blog-list__empty {
		margin: 0;
		text-align: center;

		font-size: 17px;
		line-height: 1.8;
	}


	/* =========================================================
	   Tablet
	========================================================= */

	@media (max-width: 1000px) {
		.blog-navigation__inner {
			grid-template-columns: 1fr;
			gap: 40px;
		}

		.blog-list__grid {
			grid-template-columns:
				repeat(2, minmax(0, 1fr));
		}
	}


	/* =========================================================
	   Mobile
	========================================================= */

    @media (max-width: 700px) {
        .blog-list__grid {
            grid-template-columns: 1fr;
        }

        .blog-card__body {
            padding: 22px;
        }
    }
	
    @media (max-width: 600px) {
		.blog-header {
			padding: 56px 0 48px;
		}

		.blog-header__inner {
			width: calc(100% - 32px);
			text-align: left;
		}

		.blog-header h1 {
			margin-bottom: 18px;
			font-size: 36px;
		}

		.blog-header p {
			font-size: 15px;
		}


		.blog-navigation {
			padding: 40px 0;
		}

		.blog-navigation__inner {
			width: calc(100% - 32px);
			gap: 36px;
		}

		.blog-filter h2 {
			font-size: 18px;
		}


		.blog-category {
			padding: 6px 12px;
			font-size: 13px;
		}


		.blog-list {
			padding: 48px 0 72px;
		}

		.blog-list__inner {
			width: calc(100% - 32px);
		}

		.blog-list__grid {
			grid-template-columns: 1fr;
			gap: 24px;
		}

		.blog-card__body {
			padding: 20px;
		}

		.blog-card h2 {
			font-size: 18px;
		}
	}
</style>