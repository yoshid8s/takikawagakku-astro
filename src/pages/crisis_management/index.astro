		.crisis-lightbox {
			position: fixed;
			z-index: 9999;
			inset: 0;
			display: none;
			align-items: center;
			justify-content: center;
			padding: 48px;
			overflow: auto;
			background: rgb(0 0 0 / 88%);
		}

		.crisis-lightbox__nav {
			width: 44px;
			height: 60px;
			font-size: 44px;
		}

		.crisis-lightbox__nav--prev {
			left: 4px;
		}

		.crisis-lightbox__nav--next {
			right: 4px;
		}
	}
</style>
<script>
	const lightbox = document.querySelector('#crisis-lightbox');
	const lightboxImage = lightbox?.querySelector('.crisis-lightbox__image');
	const closeButton = lightbox?.querySelector('.crisis-lightbox__close');
	const prevButton = lightbox?.querySelector('.crisis-lightbox__nav--prev');
	const nextButton = lightbox?.querySelector('.crisis-lightbox__nav--next');
	const counter = lightbox?.querySelector('.crisis-lightbox__counter');

	let currentGroup = [];
	let currentIndex = 0;

	const updateLightbox = () => {
		if (
			!(lightboxImage instanceof HTMLImageElement) ||
			currentGroup.length === 0
		) {
			return;
		}

		const currentButton = currentGroup[currentIndex];

		if (!(currentButton instanceof HTMLElement)) return;

		const src = currentButton.dataset.lightboxImage;
		const image = currentButton.querySelector('img');

		if (!src) return;

		lightboxImage.src = src;
		lightboxImage.alt =
			image instanceof HTMLImageElement ? image.alt : '';

		if (counter) {
			counter.textContent =
				`${currentIndex + 1} / ${currentGroup.length}`;
		}

		if (prevButton instanceof HTMLButtonElement) {
			prevButton.disabled = currentGroup.length <= 1;
		}

		if (nextButton instanceof HTMLButtonElement) {
			nextButton.disabled = currentGroup.length <= 1;
		}
	};

	const openLightbox = (button) => {
		if (
			!lightbox ||
			!(button instanceof HTMLElement)
		) {
			return;
		}

		const groupName = button.dataset.lightboxGroup;

		if (!groupName) return;

		currentGroup = Array.from(
			document.querySelectorAll('[data-lightbox-image]')
		).filter((item) => {
			return (
				item instanceof HTMLElement &&
				item.dataset.lightboxGroup === groupName
			);
		});

		currentIndex = currentGroup.indexOf(button);

		if (currentIndex < 0) {
			currentIndex = 0;
		}

		updateLightbox();

		lightbox.classList.add('is-open');
		lightbox.setAttribute('aria-hidden', 'false');
		document.body.style.overflow = 'hidden';
	};

	const closeLightbox = () => {
		if (!lightbox) return;

		lightbox.classList.remove('is-open');
		lightbox.setAttribute('aria-hidden', 'true');

		if (lightboxImage instanceof HTMLImageElement) {
			lightboxImage.src = '';
		}

		currentGroup = [];
		currentIndex = 0;
		document.body.style.overflow = '';
	};

	const showPrevious = () => {
		if (currentGroup.length <= 1) return;

		currentIndex =
			(currentIndex - 1 + currentGroup.length) %
			currentGroup.length;

		updateLightbox();
	};

	const showNext = () => {
		if (currentGroup.length <= 1) return;

		currentIndex =
			(currentIndex + 1) %
			currentGroup.length;

		updateLightbox();
	};

	/*
	 * 重要：
	 * 個々の画像ボタンではなく document でクリックを監視する。
	 */
	document.addEventListener('click', (event) => {
		if (!(event.target instanceof Element)) return;

		const button = event.target.closest('[data-lightbox-image]');

		if (!(button instanceof HTMLElement)) return;

		event.preventDefault();
		event.stopPropagation();

		openLightbox(button);
	});

	closeButton?.addEventListener('click', (event) => {
		event.stopPropagation();
		closeLightbox();
	});

	let isZoomed = false;
	let isDragging = false;

	let imageX = 0;
	let imageY = 0;

	let dragStartX = 0;
	let dragStartY = 0;

	const zoomScale = 2;

	const applyImageTransform = () => {
		if (!(lightboxImage instanceof HTMLImageElement)) return;

		if (!isZoomed) {
			lightboxImage.style.transform = '';
			return;
		}

		lightboxImage.style.transform =
			`translate(${imageX}px, ${imageY}px) scale(${zoomScale})`;
	};

	const resetZoom = () => {
		if (!(lightboxImage instanceof HTMLImageElement)) return;

		isZoomed = false;
		isDragging = false;

		imageX = 0;
		imageY = 0;

		lightboxImage.classList.remove(
			'is-zoomed',
			'is-dragging'
		);

		lightboxImage.style.transform = '';
	};

	const toggleZoom = () => {
		if (!(lightboxImage instanceof HTMLImageElement)) return;

		if (isZoomed) {
			resetZoom();
			return;
		}

		isZoomed = true;
		imageX = 0;
		imageY = 0;

		lightboxImage.classList.add('is-zoomed');

		applyImageTransform();
	};

	/*
	* クリック / タップで拡大・縮小
	*/
	lightboxImage?.addEventListener('click', (event) => {
		event.preventDefault();
		event.stopPropagation();

		if (isDragging) return;

		toggleZoom();
	});

	/*
	* ドラッグ開始
	*/
	lightboxImage?.addEventListener('mousedown', (event) => {
		if (
			!isZoomed ||
			!(lightboxImage instanceof HTMLImageElement)
		) {
			return;
		}

		event.preventDefault();
		event.stopPropagation();

		isDragging = true;

		dragStartX = event.clientX - imageX;
		dragStartY = event.clientY - imageY;

		lightboxImage.classList.add('is-dragging');
	});

	/*
	* 重要：
	* mousemove は画像ではなく document で監視する
	*/
	document.addEventListener('mousemove', (event) => {
		if (!isDragging || !isZoomed) return;

		event.preventDefault();

		imageX = event.clientX - dragStartX;
		imageY = event.clientY - dragStartY;

		applyImageTransform();
	});

	/*
	* ドラッグ終了
	*/
	document.addEventListener('mouseup', () => {
		if (!isDragging) return;

		isDragging = false;

		if (lightboxImage instanceof HTMLImageElement) {
			lightboxImage.classList.remove('is-dragging');
		}
	});

	lightboxImage?.addEventListener('pointerdown', (event) => {
		if (
			!isZoomed ||
			!(lightboxImage instanceof HTMLImageElement)
		) {
			return;
		}

		event.preventDefault();

		isDragging = true;

		dragStartX = event.clientX - imageX;
		dragStartY = event.clientY - imageY;

		lightboxImage.classList.add('is-dragging');
		lightboxImage.setPointerCapture(event.pointerId);
	});

	lightboxImage?.addEventListener('pointermove', (event) => {
		if (
			!isDragging ||
			!isZoomed ||
			!(lightboxImage instanceof HTMLImageElement)
		) {
			return;
		}

		event.preventDefault();

		imageX = event.clientX - dragStartX;
		imageY = event.clientY - dragStartY;

		applyImageTransform();
	});

	lightboxImage?.addEventListener('pointerup', (event) => {
		if (!(lightboxImage instanceof HTMLImageElement)) return;

		isDragging = false;

		lightboxImage.classList.remove('is-dragging');

		if (lightboxImage.hasPointerCapture(event.pointerId)) {
			lightboxImage.releasePointerCapture(event.pointerId);
		}
	});

	lightboxImage?.addEventListener('pointercancel', () => {
		isDragging = false;
		lightboxImage?.classList.remove('is-dragging');
	});

	prevButton?.addEventListener('click', (event) => {
		event.stopPropagation();
		showPrevious();
	});

	nextButton?.addEventListener('click', (event) => {
		event.stopPropagation();
		showNext();
	});

	lightbox?.addEventListener('click', (event) => {
		if (event.target === lightbox) {
			closeLightbox();
		}
	});

	document.addEventListener('keydown', (event) => {
		if (!lightbox?.classList.contains('is-open')) return;

		if (event.key === 'Escape') {
			closeLightbox();
		}

		if (event.key === 'ArrowLeft') {
			showPrevious();
		}

		if (event.key === 'ArrowRight') {
			showNext();
		}
	});
</script>