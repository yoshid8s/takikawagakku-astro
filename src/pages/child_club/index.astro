	/* lightbox */

	.lightbox {
		position: fixed;
		inset: 0;
		z-index: 3000;
		display: none;
		align-items: center;
		justify-content: center;
		padding: 40px 90px;
		background: rgb(0 0 0 / 88%);
	}

	.lightbox.is-open {
		display: flex;
	}

	.lightbox__content {
		position: relative;
		display: flex;
		max-width: 100%;
		max-height: 100%;
		flex-direction: column;
		align-items: center;
		justify-content: center;
		overflow: hidden;
	}

	.lightbox__image {
		display: block;
		max-width: 94%;
		max-height: 86vh;
		width: auto;
		height: auto;
		object-fit: contain;
		cursor: zoom-in;
		user-select: none;
		-webkit-user-drag: none;
		transform: translate(0, 0) scale(1);
		transform-origin: center center;
		transition: transform 0.2s ease;
	}

	.lightbox__image.is-zoomed {
		cursor: grab;
		transition: none;
	}

	.lightbox__image.is-dragging {
		cursor: grabbing;
	}

	.lightbox__close {
		position: absolute;
		top: 20px;
		right: 24px;
		z-index: 2;
		width: 48px;
		height: 48px;
		border: 0;
		background: transparent;
		color: #fff;
		font-size: 40px;
		cursor: pointer;
	}

	.lightbox__nav {
		position: absolute;
		top: 50%;
		z-index: 2;
		display: grid;
		width: 56px;
		height: 72px;
		place-items: center;
		border: 0;
		background: rgb(0 0 0 / 25%);
		color: #fff;
		font-size: 56px;
		cursor: pointer;
		transform: translateY(-50%);
	}

	.lightbox__nav--prev {
		left: 20px;
	}

	.lightbox__nav--next {
		right: 20px;
	}

	.lightbox__counter {
		margin: 12px 0 0;
		color: #fff;
		font-size: 13px;
	}


