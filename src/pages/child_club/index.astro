<script>
	document.querySelectorAll('.activity-toggle').forEach((toggle) => {
		toggle.addEventListener('click', () => {
			const item = toggle.closest('.activity-item');
			const content = item?.querySelector('.activity-content');

			if (!content) return;

			const isOpen = content.classList.toggle('is-open');

			toggle.setAttribute('aria-expanded', String(isOpen));
		});
	});

	document.querySelectorAll('.schedule-toggle').forEach((toggle) => {
		toggle.addEventListener('click', () => {
			const item = toggle.closest('.schedule-item');
			const content = item?.querySelector('.schedule-content');

			if (!content) return;

			const isOpen = content.classList.toggle('is-open');

			toggle.setAttribute('aria-expanded', String(isOpen));
		});
	});
</script>