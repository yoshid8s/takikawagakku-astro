---
import Layout from '../../../layouts/Layout.astro';

const pageTitle = 'こども食堂 なごやAsoviva';
---

<Layout title={pageTitle}>
	<main class="takids-page">

		<!-- =====================================================
		     Hero
		===================================================== -->

		<section class="takids-hero">
			<img
				src="/images/community-center/takids/hero.png"
				alt="こども食堂 なごやAsoviva"
			/>

			<div class="takids-hero__overlay">
				<h1>こども食堂 なごやAsoviva</h1>
			</div>
		</section>


		<!-- =====================================================
		     Breadcrumbs
		===================================================== -->

		<nav
			class="takids-breadcrumbs"
			aria-label="パンくずリスト"
		>
			<a href="/">Home</a>
			<span>/</span>

			<a href="/takikawa_community_icenter/">
				滝川コミュニティセンター
			</a>
			<span>/</span>

			<span>こども食堂 なごやAsoviva</span>
		</nav>


		<!-- =====================================================
		     Introduction / 基本理念
		===================================================== -->

		<section class="takids-intro">
			<div class="takids-inner takids-inner--narrow">

				<p class="takids-intro__lead">
					こどもたちの地域居場所つくりとして
					「たキッズ」を令和4年7月から開催しています。
				</p>

				<div class="takids-philosophy">
					<p>
						「いのち」の土台となる食をつうじて、つながる
					</p>

					<p>
						大人も子どもも遊びながら、
						「いのち」のかがやきを育む
					</p>

					<p>
						一人ひとりがそれぞれに、
						新しい体験を通して、自分の世界を広げていく
					</p>
				</div>

				<p class="takids-intro__closing">
					上記の基本理念を基に活動しております。
				</p>

			</div>
		</section>


		<!-- =====================================================
		     講座内容
		===================================================== -->

		<section class="takids-section takids-section--content">
			<div class="takids-inner">

				<h2>講座内容</h2>

				<div class="takids-content">

					<p>
						八事周辺で 子どもたち・おとなも
						「たべる・あそぶ・まなぶ」ことを体験する場として、
						子どもイベント、食堂運営、大人の学び講座、
						フリースクールなどの活動をしている
						ＮＰＯ法人なごや Asoviva（あそびば）が運営する
						食育講座です。
					</p>

					<p>
						一緒に活動してくれるボランティアも募集中です！
						ご参加お待ちしております。
					</p>

					<p>
						どなたでも参加可能です。
					</p>

					<p>
						出入り自由で親子で来て頂けます。
						幼稚園児、未就園児さんは親子同伴でお願い致します。
					</p>

					<p>
						お食事提供がメインになります。
						食べて話してゆっくりお過ごしいただけます。
					</p>

					<p>
						フリースペースでボードゲームやクラフト作りなど
						遊んで帰ることもできます。
					</p>


					<div class="takids-info">
						<p>
							<strong>◆時間</strong>
							10時〜15時
						</p>

						<p>
							<strong>◆限定５０食</strong>
							（なくなり次第終了）
						</p>

						<p>
							<strong>◆子ども（中学生まで）</strong>
							１００円
							<span class="takids-info__separator">／</span>
							<strong>大人</strong>
							３００円
						</p>

						<p class="takids-info__note">
							※飲み物の提供はありませんので、水筒などお持ちください
						</p>

						<p class="takids-info__note">
							※予約の必要はありません。
						</p>
					</div>


					<!-- 案内画像 -->

					<div class="takids-guide">
						<img
							src="/images/community-center/takids/takids-guide.png"
							alt="こども食堂 たキッズのご案内"
							loading="lazy"
						/>
					</div>

				</div>

			</div>
		</section>


		<!-- =====================================================
		     お問い合わせ
		===================================================== -->

		<section class="takids-section takids-section--contact">
			<div class="takids-inner takids-inner--narrow">

				<h2>お問い合わせ</h2>

				<div class="takids-contact">

					<p>
						詳細は以下の主催団体にお問い合わせください。
					</p>

					<div class="takids-contact__organization">
						<p>
							<strong>
								主催：ＮＰＯ法人なごや Asoviva（あそびば）
							</strong>
						</p>

						<p>
							<a
								href="https://nagoya-asoviva.jp"
								target="_blank"
								rel="noopener noreferrer"
							>
								なごやAsoviva 公式サイト
							</a>
						</p>

						<p>
							お問合せ：
							<a href="mailto:info@nagoya-asoviva.jp">
								info@nagoya-asoviva.jp
							</a>
						</p>
					</div>

					<p>
						なごやあそびばでは、フリースクール、
						中高生サポートテラコヤ、
						夏休み小学生イベントなど様々な活動を行っています。
						詳しくはＨＰをご覧ください。
						あそびば公式ＬＩＮＥにも情報発信していきます。
						ぜひご登録ください。
					</p>

				</div>

			</div>
		</section>

	</main>
</Layout>


<style>
	/* =========================================================
	   Page
	========================================================= */

	.takids-page {
		width: 100%;
		margin: 0;
		padding: 0;
		background: #fff;
		color: #111827;
	}

	.takids-inner {
		width: min(calc(100% - 64px), 1180px);
		margin: 0 auto;
	}

	.takids-inner--narrow {
		max-width: 900px;
	}


	/* =========================================================
	   Hero
	========================================================= */

	.takids-hero {
		position: relative;
		width: 100%;
		height: clamp(300px, 38vw, 520px);
		overflow: hidden;
		background: #111827;
	}

	.takids-hero img {
		display: block;
		width: 100%;
		height: 100%;
		object-fit: cover;
		object-position: center;
	}

	.takids-hero__overlay {
		position: absolute;
		inset: 0;
		display: flex;
		align-items: center;
		justify-content: center;
		padding: 32px;
		background: rgb(0 0 0 / 22%);
	}

	.takids-hero h1 {
		margin: 0;
		color: #fff;
		font-size: clamp(38px, 5vw, 62px);
		font-weight: 400;
		line-height: 1.35;
		text-align: center;
		text-shadow: 0 2px 12px rgb(0 0 0 / 40%);
	}


	/* =========================================================
	   Breadcrumbs
	========================================================= */

	.takids-breadcrumbs {
		display: flex;
		align-items: center;
		flex-wrap: wrap;
		width: min(calc(100% - 48px), 1280px);
		margin: 0 auto;
		padding: 30px 0;
		gap: 10px;
		font-size: 14px;
		line-height: 1.6;
	}

	.takids-breadcrumbs a {
		color: #009fe8;
		text-decoration: none;
	}

	.takids-breadcrumbs a:hover {
		text-decoration: underline;
		text-underline-offset: 0.2em;
	}


	/* =========================================================
	   Introduction
	========================================================= */

	.takids-intro {
		padding: 64px 0 76px;
		background: #f4f9fc;
	}

	.takids-intro__lead {
		margin: 0 0 42px;
		font-size: 19px;
		line-height: 1.9;
		text-align: center;
	}

	.takids-philosophy {
		width: min(100%, 760px);
		margin: 0 auto;
		padding: 32px 40px;
		background: #fff;
	}

	.takids-philosophy p {
		margin: 0 0 18px;
		font-size: 17px;
		line-height: 1.8;
		text-align: center;
	}

	.takids-philosophy p:last-child {
		margin-bottom: 0;
	}

	.takids-intro__closing {
		margin: 34px 0 0;
		font-size: 17px;
		line-height: 1.8;
		text-align: center;
	}


	/* =========================================================
	   Section common
	========================================================= */

	.takids-section {
		padding: 80px 0 96px;
	}

	.takids-section h2 {
		margin: 0 0 48px;
		font-size: clamp(34px, 4vw, 48px);
		font-weight: 400;
		line-height: 1.4;
		text-align: center;
	}


	/* =========================================================
	   Content
	========================================================= */

	.takids-section--content {
		background: #fff;
	}

	.takids-content {
		width: min(100%, 900px);
		margin: 0 auto;
	}

	.takids-content > p {
		margin: 0 0 20px;
		font-size: 17px;
		line-height: 1.9;
	}


	/* =========================================================
	   Information
	========================================================= */

	.takids-info {
		margin: 42px 0 0;
		padding: 30px 36px;
		background: #f4f9fc;
	}

	.takids-info p {
		margin: 0 0 12px;
		font-size: 17px;
		line-height: 1.8;
	}

	.takids-info p:last-child {
		margin-bottom: 0;
	}

	.takids-info strong {
		margin-right: 0.5em;
	}

	.takids-info__separator {
		margin: 0 0.7em;
		color: #9ca3af;
	}

	.takids-info__note {
		font-size: 15px !important;
	}


	/* =========================================================
	   Guide image
	========================================================= */

	.takids-guide {
		width: min(100%, 650px);
		margin: 64px auto 0;
	}

	.takids-guide img {
		display: block;
		width: 100%;
		height: auto;
		margin: 0 auto;
	}


	/* =========================================================
	   Contact
	========================================================= */

	.takids-section--contact {
		background: #f4f9fc;
	}

	.takids-contact {
		width: min(100%, 800px);
		margin: 0 auto;
	}

	.takids-contact > p {
		margin: 0 0 24px;
		font-size: 17px;
		line-height: 1.9;
	}

	.takids-contact__organization {
		margin: 30px 0;
		padding: 28px 32px;
		background: #fff;
	}

	.takids-contact__organization p {
		margin: 0 0 12px;
		font-size: 17px;
		line-height: 1.8;
	}

	.takids-contact__organization p:last-child {
		margin-bottom: 0;
	}

	.takids-contact a {
		color: #009fe8;
		text-decoration: none;
	}

	.takids-contact a:hover {
		text-decoration: underline;
		text-underline-offset: 0.2em;
	}


	/* =========================================================
	   Tablet
	========================================================= */

	@media (max-width: 900px) {
		.takids-inner {
			width: min(calc(100% - 40px), 760px);
		}

		.takids-guide {
			max-width: 600px;
		}
	}


	/* =========================================================
	   Mobile
	========================================================= */

	@media (max-width: 600px) {
		.takids-inner {
			width: calc(100% - 32px);
		}

		.takids-hero {
			height: 300px;
		}

		.takids-hero h1 {
			font-size: 34px;
		}

		.takids-breadcrumbs {
			width: calc(100% - 32px);
			padding: 22px 0;
			font-size: 13px;
		}

		.takids-intro {
			padding: 46px 0 56px;
		}

		.takids-intro__lead {
			margin-bottom: 32px;
			font-size: 16px;
			text-align: left;
		}

		.takids-philosophy {
			padding: 26px 22px;
		}

		.takids-philosophy p {
			font-size: 15px;
			text-align: left;
		}

		.takids-intro__closing {
			margin-top: 28px;
			font-size: 15px;
			text-align: left;
		}

		.takids-section {
			padding: 56px 0 68px;
		}

		.takids-section h2 {
			margin-bottom: 34px;
		}

		.takids-content > p {
			font-size: 15px;
		}

		.takids-info {
			margin-top: 32px;
			padding: 24px 20px;
		}

		.takids-info p {
			font-size: 15px;
		}

		.takids-info__separator {
			display: none;
		}

		.takids-guide {
			margin-top: 44px;
		}

		.takids-contact > p,
		.takids-contact__organization p {
			font-size: 15px;
		}

		.takids-contact__organization {
			padding: 24px 20px;
		}
	}
</style>