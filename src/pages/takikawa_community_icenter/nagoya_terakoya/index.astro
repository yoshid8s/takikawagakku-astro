---
import Layout from '../../../layouts/Layout.astro';

const pageTitle = 'ナゴヤテラコヤ';
---

<Layout title={pageTitle}>
	<main class="terakoya-page">

		<!-- =====================================================
		     Hero
		===================================================== -->

		<section class="terakoya-hero">
			<img
				src="/images/community-center/nagoya-terakoya/hero.png"
				alt="ナゴヤテラコヤ"
			/>

			<div class="terakoya-hero__overlay">
				<h1>ナゴヤテラコヤ</h1>
			</div>
		</section>


		<!-- =====================================================
		     Breadcrumbs
		===================================================== -->

		<nav
			class="terakoya-breadcrumbs"
			aria-label="パンくずリスト"
		>
			<a href="/">Home</a>
			<span>/</span>

			<a href="/takikawa_community_icenter/">
				滝川コミュニティセンター
			</a>
			<span>/</span>

			<span>ナゴヤテラコヤ</span>
		</nav>


		<!-- =====================================================
		     Introduction
		===================================================== -->

		<section class="terakoya-intro">
			<div class="terakoya-inner">

				<p class="terakoya-intro__lead">
					「ヤゴトテラコヤ」は、誰でも無料で参加できる学びと交流の場です。
					学校の予習・復習や読書、探求活動など、一人でもみんなでも自由に取り組むことができ、
					学ぶ楽しさを実感できます。
					元教員や大学生がやさしく見守り・サポートし、
					異年齢の交流を通じて新しい発見やつながりも生まれます。
					出入り自由なので、お気軽に立ち寄りください。
				</p>


				<!-- =============================================
				     開催情報
				============================================= -->

				<div class="terakoya-info">

					<div class="terakoya-info__item">
						<h2>参加費無料</h2>
					</div>

					<div class="terakoya-info__item">
						<h2>開催日時</h2>

						<p>
							第2・第4水曜日　17:00〜19:00
							（時間内出入り自由）
						</p>
					</div>

					<div class="terakoya-info__item">
						<h2>開催場所</h2>

						<p>
							滝川コミュニティセンター
							（名古屋市昭和区川名山町46-4）
						</p>
					</div>

					<div class="terakoya-info__item">
						<h2>開催内容</h2>

						<p>
							学習サポート（予習・復習・読書など）、
							探求活動の応援、プチおやつタイムあり
						</p>
					</div>

					<div class="terakoya-info__item">
						<h2>お問い合わせ先</h2>

						<p>
							NPO法人なごやAsoviva
						</p>

						<p>
							メール：
							<a href="mailto:terakoya@nagoya-asoviva.jp">
								terakoya@nagoya-asoviva.jp
							</a>
						</p>
					</div>

				</div>


				<!-- =============================================
				     案内画像
				============================================= -->

				<div class="terakoya-guide">
					<button
						class="terakoya-flyer-button"
						type="button"
						data-lightbox-image="/images/community-center/nagoya-terakoya/terakoya-guide.png"
						data-lightbox-group="terakoya-flyer"
						aria-label="ヤゴトテラコヤのご案内を拡大表示"
					>
						<img
							src="/images/community-center/nagoya-terakoya/terakoya-guide.png"
							alt="ヤゴトテラコヤのご案内"
							loading="lazy"
						/>
					</button>
				</div>

			</div>
		</section>
		<div
			class="image-lightbox"
			id="terakoya-lightbox"
			aria-hidden="true"
		>
			<button
				class="image-lightbox__close"
				type="button"
				aria-label="画像を閉じる"
			>
				×
			</button>

			<div class="image-lightbox__content">
				<img
					class="image-lightbox__image"
					src=""
					alt=""
				/>
			</div>
		</div>
	</main>
</Layout>


<style>
	/* =========================================================
	   Page
	========================================================= */

	.terakoya-page {
		width: 100%;
		margin: 0;
		padding: 0;
		background: #fff;
		color: #111827;
	}

	.terakoya-inner {
		width: min(calc(100% - 64px), 1080px);
		margin: 0 auto;
	}


	/* =========================================================
	   Hero
	========================================================= */

	.terakoya-hero {
		position: relative;
		width: 100%;
		height: clamp(300px, 38vw, 520px);
		overflow: hidden;
		background: #111827;
	}

	.terakoya-hero img {
		display: block;
		width: 100%;
		height: 100%;
		object-fit: cover;
		object-position: center;
	}

	.terakoya-hero__overlay {
		position: absolute;
		inset: 0;
		display: flex;
		align-items: center;
		justify-content: center;
		padding: 32px;
		background: rgb(0 0 0 / 22%);
	}

	.terakoya-hero h1 {
		margin: 0;
		color: #fff;
		font-size: clamp(40px, 5vw, 64px);
		font-weight: 400;
		line-height: 1.3;
		text-align: center;
		text-shadow: 0 2px 12px rgb(0 0 0 / 40%);
	}


	/* =========================================================
	   Breadcrumbs
	========================================================= */

	.terakoya-breadcrumbs {
		display: flex;
		align-items: center;
		flex-wrap: wrap;
		width: min(calc(100% - 48px), 1280px);
		margin: 0 auto;
		padding: 30px 0;
		gap: 10px;
		font-size: 14px;
		line-height: 1.6;
	}

	.terakoya-breadcrumbs a {
		color: #009fe8;
		text-decoration: none;
	}

	.terakoya-breadcrumbs a:hover {
		text-decoration: underline;
		text-underline-offset: 0.2em;
	}


	/* =========================================================
	   Introduction
	========================================================= */

	.terakoya-intro {
		padding: 64px 0 96px;
		background: #f4f9fc;
	}

	.terakoya-intro__lead {
		margin: 0 0 64px;
		font-size: 17px;
		line-height: 1.9;
	}


	/* =========================================================
	   Information
	========================================================= */

	.terakoya-info {
		width: min(100%, 900px);
		margin: 0 auto;
	}

	.terakoya-info__item {
		margin: 0 0 34px;
	}

	.terakoya-info__item:last-child {
		margin-bottom: 0;
	}

	.terakoya-info__item h2 {
		position: relative;
		margin: 0 0 8px;
		padding-left: 1.1em;
		font-size: 17px;
		font-weight: 600;
		line-height: 1.6;
	}

	.terakoya-info__item h2::before {
		position: absolute;
		top: 0;
		left: 0;
		content: "■";
	}

	.terakoya-info__item p {
		margin: 0 0 4px;
		font-size: 17px;
		line-height: 1.8;
	}

	.terakoya-info__item a {
		color: #009fe8;
		text-decoration: none;
	}

	.terakoya-info__item a:hover {
		text-decoration: underline;
		text-underline-offset: 0.2em;
	}


	/* =========================================================
	   Guide image
	========================================================= */

	.terakoya-guide {
		width: min(100%, 720px);
		margin: 72px auto 0;
	}

	.terakoya-guide img {
		display: block;
		width: 100%;
		height: auto;
		margin: 0 auto;
	}

	/* =========================================================
	   Flyer button
	========================================================= */

	.terakoya-flyer-button {
		display: block;
		width: 100%;
		padding: 0;
		border: 0;
		background: transparent;
		cursor: zoom-in;
	}

	.terakoya-flyer-button img {
		display: block;
		width: 100%;
		height: auto;
	}

	/* =========================================================
	   Lightbox
	========================================================= */

	.image-lightbox {
		position: fixed;
		z-index: 9999;
		inset: 0;
		display: none;
		align-items: center;
		justify-content: center;
		padding: 48px;
		background: rgb(0 0 0 / 88%);
	}

	.image-lightbox.is-open {
		display: flex;
	}

	.image-lightbox__content {
		display: flex;
		max-width: 100%;
		max-height: 100%;
		align-items: center;
		justify-content: center;
	}

	.image-lightbox__image {
		display: block;
		width: auto;
		height: auto;
		max-width: min(1500px, 94vw);
		max-height: 88vh;
		object-fit: contain;

		cursor: zoom-in;
		user-select: none;
		-webkit-user-drag: none;
		touch-action: none;

		transition: transform 0.15s ease;
		transform-origin: center center;
	}

	.image-lightbox__image.is-zoomed {
		cursor: grab;
		transition: none;
	}

	.image-lightbox__image.is-dragging {
		cursor: grabbing;
	}

	.image-lightbox__close {
		position: absolute;
		top: 18px;
		right: 24px;
		width: 48px;
		height: 48px;
		padding: 0;
		border: 0;
		background: transparent;
		color: #fff;
		cursor: pointer;
		font-size: 42px;
		line-height: 1;
	}

	/* =========================================================
	   Tablet
	========================================================= */

	@media (max-width: 900px) {
		.terakoya-inner {
			width: min(calc(100% - 40px), 760px);
		}

		.terakoya-intro__lead {
			margin-bottom: 52px;
		}

		.terakoya-guide {
			max-width: 620px;
		}
	}


	/* =========================================================
	   Mobile
	========================================================= */

	@media (max-width: 600px) {
		.terakoya-inner {
			width: calc(100% - 32px);
		}

		.terakoya-hero {
			height: 300px;
		}

		.terakoya-hero h1 {
			font-size: 36px;
		}

		.terakoya-breadcrumbs {
			width: calc(100% - 32px);
			padding: 22px 0;
			font-size: 13px;
		}

		.terakoya-intro {
			padding: 46px 0 68px;
		}

		.terakoya-intro__lead {
			margin-bottom: 44px;
			font-size: 15px;
		}

		.terakoya-info__item {
			margin-bottom: 28px;
		}

		.terakoya-info__item h2,
		.terakoya-info__item p {
			font-size: 15px;
		}

		.terakoya-guide {
			margin-top: 52px;
		}
	}
</style>
<script>
	const lightbox = document.querySelector('#terakoya-lightbox');
	const lightboxImage = lightbox?.querySelector('.image-lightbox__image');
	const closeButton = lightbox?.querySelector('.image-lightbox__close');

	const prevButton = null;
	const nextButton = null;
	const counter = null;

	let currentGroup = [];
	let currentIndex = 0;

	const updateLightbox = () => {
		if (
			!(lightboxImage instanceof HTMLImageElement) ||
			currentGroup.length === 0
		) {
			return;
		}

		const currentButton = currentGroup[currentIndex];

		if (!(currentButton instanceof HTMLElement)) return;

		const src = currentButton.dataset.lightboxImage;
		const image = currentButton.querySelector('img');

		if (!src) return;

		lightboxImage.src = src;
		lightboxImage.alt =
			image instanceof HTMLImageElement ? image.alt : '';

		if (counter) {
			counter.textContent =
				`${currentIndex + 1} / ${currentGroup.length}`;
		}

		if (prevButton instanceof HTMLButtonElement) {
			prevButton.disabled = currentGroup.length <= 1;
		}

		if (nextButton instanceof HTMLButtonElement) {
			nextButton.disabled = currentGroup.length <= 1;
		}
	};

	const openLightbox = (button) => {
		if (
			!lightbox ||
			!(button instanceof HTMLElement)
		) {
			return;
		}

		const groupName = button.dataset.lightboxGroup;

		if (!groupName) return;

		currentGroup = Array.from(
			document.querySelectorAll('[data-lightbox-image]')
		).filter((item) => {
			return (
				item instanceof HTMLElement &&
				item.dataset.lightboxGroup === groupName
			);
		});

		currentIndex = currentGroup.indexOf(button);

		if (currentIndex < 0) {
			currentIndex = 0;
		}

		updateLightbox();

		lightbox.classList.add('is-open');
		lightbox.setAttribute('aria-hidden', 'false');
		document.body.style.overflow = 'hidden';
	};

	const closeLightbox = () => {
		if (!lightbox) return;

		lightbox.classList.remove('is-open');
		lightbox.setAttribute('aria-hidden', 'true');

		if (lightboxImage instanceof HTMLImageElement) {
			lightboxImage.src = '';
		}

		currentGroup = [];
		currentIndex = 0;
		document.body.style.overflow = '';
	};

	const showPrevious = () => {
		if (currentGroup.length <= 1) return;

		currentIndex =
			(currentIndex - 1 + currentGroup.length) %
			currentGroup.length;

		updateLightbox();
	};

	const showNext = () => {
		if (currentGroup.length <= 1) return;

		currentIndex =
			(currentIndex + 1) %
			currentGroup.length;

		updateLightbox();
	};

	/*
	 * 重要：
	 * 個々の画像ボタンではなく document でクリックを監視する。
	 */
	document.addEventListener('click', (event) => {
		if (!(event.target instanceof Element)) return;

		const button = event.target.closest('[data-lightbox-image]');

		if (!(button instanceof HTMLElement)) return;

		event.preventDefault();
		event.stopPropagation();

		openLightbox(button);
	});

	closeButton?.addEventListener('click', (event) => {
		event.stopPropagation();
		closeLightbox();
	});

	let isZoomed = false;
	let isDragging = false;

	let imageX = 0;
	let imageY = 0;

	let dragStartX = 0;
	let dragStartY = 0;

	const zoomScale = 2;

	const applyImageTransform = () => {
		if (!(lightboxImage instanceof HTMLImageElement)) return;

		if (!isZoomed) {
			lightboxImage.style.transform = '';
			return;
		}

		lightboxImage.style.transform =
			`translate(${imageX}px, ${imageY}px) scale(${zoomScale})`;
	};

	const resetZoom = () => {
		if (!(lightboxImage instanceof HTMLImageElement)) return;

		isZoomed = false;
		isDragging = false;

		imageX = 0;
		imageY = 0;

		lightboxImage.classList.remove(
			'is-zoomed',
			'is-dragging'
		);

		lightboxImage.style.transform = '';
	};

	const toggleZoom = () => {
		if (!(lightboxImage instanceof HTMLImageElement)) return;

		if (isZoomed) {
			resetZoom();
			return;
		}

		isZoomed = true;
		imageX = 0;
		imageY = 0;

		lightboxImage.classList.add('is-zoomed');

		applyImageTransform();
	};

	/*
	* クリック / タップで拡大・縮小
	*/
	lightboxImage?.addEventListener('click', (event) => {
		event.preventDefault();
		event.stopPropagation();

		if (isDragging) return;

		toggleZoom();
	});

	/*
	* ドラッグ開始
	*/
	lightboxImage?.addEventListener('mousedown', (event) => {
		if (
			!isZoomed ||
			!(lightboxImage instanceof HTMLImageElement)
		) {
			return;
		}

		event.preventDefault();
		event.stopPropagation();

		isDragging = true;

		dragStartX = event.clientX - imageX;
		dragStartY = event.clientY - imageY;

		lightboxImage.classList.add('is-dragging');
	});

	/*
	* 重要：
	* mousemove は画像ではなく document で監視する
	*/
	document.addEventListener('mousemove', (event) => {
		if (!isDragging || !isZoomed) return;

		event.preventDefault();

		imageX = event.clientX - dragStartX;
		imageY = event.clientY - dragStartY;

		applyImageTransform();
	});

	/*
	* ドラッグ終了
	*/
	document.addEventListener('mouseup', () => {
		if (!isDragging) return;

		isDragging = false;

		if (lightboxImage instanceof HTMLImageElement) {
			lightboxImage.classList.remove('is-dragging');
		}
	});

	lightboxImage?.addEventListener('pointerdown', (event) => {
		if (
			!isZoomed ||
			!(lightboxImage instanceof HTMLImageElement)
		) {
			return;
		}

		event.preventDefault();

		isDragging = true;

		dragStartX = event.clientX - imageX;
		dragStartY = event.clientY - imageY;

		lightboxImage.classList.add('is-dragging');
		lightboxImage.setPointerCapture(event.pointerId);
	});

	lightboxImage?.addEventListener('pointermove', (event) => {
		if (
			!isDragging ||
			!isZoomed ||
			!(lightboxImage instanceof HTMLImageElement)
		) {
			return;
		}

		event.preventDefault();

		imageX = event.clientX - dragStartX;
		imageY = event.clientY - dragStartY;

		applyImageTransform();
	});

	lightboxImage?.addEventListener('pointerup', (event) => {
		if (!(lightboxImage instanceof HTMLImageElement)) return;

		isDragging = false;

		lightboxImage.classList.remove('is-dragging');

		if (lightboxImage.hasPointerCapture(event.pointerId)) {
			lightboxImage.releasePointerCapture(event.pointerId);
		}
	});

	lightboxImage?.addEventListener('pointercancel', () => {
		isDragging = false;
		lightboxImage?.classList.remove('is-dragging');
	});

	prevButton?.addEventListener('click', (event) => {
		event.stopPropagation();
		showPrevious();
	});

	nextButton?.addEventListener('click', (event) => {
		event.stopPropagation();
		showNext();
	});

	lightbox?.addEventListener('click', (event) => {
		if (event.target === lightbox) {
			closeLightbox();
		}
	});

	document.addEventListener('keydown', (event) => {
		if (!lightbox?.classList.contains('is-open')) return;

		if (event.key === 'Escape') {
			closeLightbox();
		}

		if (event.key === 'ArrowLeft') {
			showPrevious();
		}

		if (event.key === 'ArrowRight') {
			showNext();
		}
	});
</script>
