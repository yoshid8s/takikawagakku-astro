---
import Layout from '../../../../layouts/Layout.astro';

const pageTitle = '囲碁クラブ';
---

<Layout title={pageTitle}>
	<main class="igo-club-page">

		<!-- =====================================================
		     Hero
		===================================================== -->

		<section class="igo-club-hero">
			<img
				src="/images/community-center/igo-club/hero.jpg"
				alt="囲碁クラブ"
			/>

			<div class="igo-club-hero__overlay">
				<h1>囲碁クラブ</h1>
			</div>
		</section>


		<!-- =====================================================
		     Breadcrumbs
		===================================================== -->

		<nav
			class="igo-club-breadcrumbs"
			aria-label="パンくずリスト"
		>
			<a href="/">Home</a>
			<span>/</span>

			<a href="/takikawa_community_icenter/">
				滝川コミュニティセンター
			</a>
			<span>/</span>

			<a href="/takikawa_community_icenter/takikawa_commicenter-regular_courses/">
				文化教養講座
			</a>
			<span>/</span>

			<span>囲碁クラブ</span>
		</nav>


		<!-- =====================================================
		     Introduction
		===================================================== -->

		<section class="igo-club-intro">
			<div class="igo-club-inner igo-club-inner--narrow">

				<p>
					これから囲碁を始めようと思われる方・ルールがわからない方も
				</p>

				<p>
					講師が丁寧に指導しますので安心して楽しんで頂けます。
				</p>

				<p>
					会員皆様に自主運営して頂いております。
				</p>

			</div>
		</section>


		<!-- =====================================================
		     募集案内
		===================================================== -->

		<section class="igo-club-section igo-club-section--recruit">
			<div class="igo-club-inner igo-club-inner--narrow">

				<h2>募集案内</h2>

				<div class="igo-club-recruit">

					<h3>囲碁クラブ　新規会員募集</h3>

					<p>
						<strong>
							募集期間　2月16日(金)～先着順にて受付
						</strong>
					</p>

					<p>
						定員8名　どなたでも可
					</p>

				</div>

			</div>
		</section>


		<!-- =====================================================
		     講座内容
		===================================================== -->

		<section class="igo-club-section igo-club-section--course">
			<div class="igo-club-inner">

				<h2>講座内容</h2>

				<div class="igo-club-course">

					<!-- 写真 -->

					<div class="igo-club-course__image">
						<img
							src="/images/community-center/igo-club/igo-club.png"
							alt="囲碁クラブ"
							loading="lazy"
						/>
					</div>


					<!-- テキスト -->

					<div class="igo-club-course__content">

						<ul>
							<li>
								<strong>内容</strong>
								自由対局・講師による指導
							</li>

							<li>
								<strong>開催期間</strong>
								4月～翌年3月
							</li>

							<li>
								<strong>開催日時</strong>
								毎週金曜日　13時～16時
								<span class="igo-club-note">
									＊第5金曜日休み
								</span>
							</li>

							<li>
								<strong>開催場所</strong>
								2階和室
							</li>

							<li>
								<strong>定員</strong>
								25名　滝川学区以外の方も入会可
							</li>

							<li>
								<strong>講師</strong>
								梅鉢　勇夫 先生
							</li>

							<li>
								<strong>年会費</strong>
								6,000円
							</li>

							<li>
								<strong>その他</strong>

								<ul>
									<li>
										年度途中での退会希望者は会費返還可能
									</li>
									<li>
										災害・運営都合により開催中止延期する場合がございます。
									</li>
								</ul>
							</li>
						</ul>

					</div>

				</div>

			</div>
		</section>

	</main>
</Layout>


<style>
	/* =========================================================
	   Page
	========================================================= */

	.igo-club-page {
		width: 100%;
		margin: 0;
		padding: 0;
		background: #fff;
		color: #111827;
	}

	.igo-club-inner {
		width: min(calc(100% - 64px), 1180px);
		margin: 0 auto;
	}

	.igo-club-inner--narrow {
		max-width: 900px;
	}


	/* =========================================================
	   Hero
	========================================================= */

	.igo-club-hero {
		position: relative;
		width: 100%;
		height: clamp(300px, 38vw, 520px);
		overflow: hidden;
		background: #111827;
	}

	.igo-club-hero img {
		display: block;
		width: 100%;
		height: 100%;
		object-fit: cover;
		object-position: center;
	}

	.igo-club-hero__overlay {
		position: absolute;
		inset: 0;
		display: flex;
		align-items: center;
		justify-content: center;
		padding: 32px;
		background: rgb(0 0 0 / 24%);
	}

	.igo-club-hero h1 {
		margin: 0;
		color: #fff;
		font-size: clamp(40px, 5vw, 64px);
		font-weight: 400;
		line-height: 1.3;
		text-align: center;
		text-shadow: 0 2px 12px rgb(0 0 0 / 35%);
	}


	/* =========================================================
	   Breadcrumbs
	========================================================= */

	.igo-club-breadcrumbs {
		display: flex;
		align-items: center;
		flex-wrap: wrap;
		width: min(calc(100% - 48px), 1280px);
		margin: 0 auto;
		padding: 30px 0;
		gap: 10px;
		font-size: 14px;
		line-height: 1.6;
	}

	.igo-club-breadcrumbs a {
		color: #009fe8;
		text-decoration: none;
	}

	.igo-club-breadcrumbs a:hover {
		text-decoration: underline;
		text-underline-offset: 0.2em;
	}


	/* =========================================================
	   Introduction
	========================================================= */

	.igo-club-intro {
		padding: 56px 0 72px;
		background: #f4f9fc;
	}

	.igo-club-intro p {
		margin: 0 0 16px;
		font-size: 18px;
		line-height: 1.9;
		text-align: center;
	}

	.igo-club-intro p:last-child {
		margin-bottom: 0;
	}


	/* =========================================================
	   Section common
	========================================================= */

	.igo-club-section {
		padding: 80px 0 96px;
	}

	.igo-club-section h2 {
		margin: 0 0 48px;
		font-size: clamp(34px, 4vw, 48px);
		font-weight: 400;
		line-height: 1.4;
		text-align: center;
	}


	/* =========================================================
	   Recruit
	========================================================= */

	.igo-club-section--recruit {
		background: #fff;
	}

	.igo-club-recruit {
		width: min(100%, 760px);
		margin: 0 auto;
		padding: 36px 40px;
		background: #f4f9fc;
		text-align: center;
	}

	.igo-club-recruit h3 {
		margin: 0 0 24px;
		font-size: 24px;
		font-weight: 500;
		line-height: 1.5;
	}

	.igo-club-recruit p {
		margin: 0 0 12px;
		font-size: 17px;
		line-height: 1.8;
	}

	.igo-club-recruit p:last-child {
		margin-bottom: 0;
	}


	/* =========================================================
	   Course
	========================================================= */

	.igo-club-section--course {
		background: #f4f9fc;
	}

	.igo-club-course {
		display: grid;
		grid-template-columns:
			minmax(300px, 0.9fr)
			minmax(0, 1.1fr);
		align-items: center;
		gap: 72px;
	}

	.igo-club-course__image {
		width: 100%;
		max-width: 500px;
		margin: 0 auto;
	}

	.igo-club-course__image img {
		display: block;
		width: 100%;
		height: auto;
		margin: 0 auto;
	}


	/* =========================================================
	   Course text
	========================================================= */

	.igo-club-course__content {
		width: 100%;
		max-width: 650px;
	}

	.igo-club-course__content > ul {
		margin: 0;
		padding-left: 1.5em;
	}

	.igo-club-course__content > ul > li {
		margin: 0 0 16px;
		padding-left: 0.25em;
		font-size: 17px;
		line-height: 1.8;
	}

	.igo-club-course__content > ul > li:last-child {
		margin-bottom: 0;
	}

	.igo-club-course__content strong {
		margin-right: 0.6em;
		font-weight: 600;
	}

	.igo-club-course__content ul ul {
		margin: 10px 0 0;
		padding-left: 1.5em;
	}

	.igo-club-course__content ul ul li {
		margin-bottom: 6px;
		line-height: 1.8;
	}

	.igo-club-note {
		display: inline-block;
		margin-left: 0.4em;
	}


	/* =========================================================
	   Tablet
	========================================================= */

	@media (max-width: 900px) {
		.igo-club-inner {
			width: min(calc(100% - 40px), 760px);
		}

		.igo-club-course {
			grid-template-columns: 1fr;
			gap: 40px;
		}

		.igo-club-course__image {
			max-width: 500px;
		}

		.igo-club-course__content {
			max-width: 680px;
			margin: 0 auto;
		}
	}


	/* =========================================================
	   Mobile
	========================================================= */

	@media (max-width: 600px) {
		.igo-club-inner {
			width: calc(100% - 32px);
		}

		.igo-club-hero {
			height: 300px;
		}

		.igo-club-hero h1 {
			font-size: 36px;
		}

		.igo-club-breadcrumbs {
			width: calc(100% - 32px);
			padding: 22px 0;
			font-size: 13px;
		}

		.igo-club-intro {
			padding: 44px 0 52px;
		}

		.igo-club-intro p {
			font-size: 16px;
			text-align: left;
		}

		.igo-club-section {
			padding: 56px 0 68px;
		}

		.igo-club-section h2 {
			margin-bottom: 34px;
		}

		.igo-club-recruit {
			padding: 28px 22px;
		}

		.igo-club-recruit h3 {
			font-size: 20px;
		}

		.igo-club-recruit p {
			font-size: 15px;
		}

		.igo-club-course {
			gap: 32px;
		}

		.igo-club-course__image {
			max-width: 340px;
		}

		.igo-club-course__content > ul > li {
			font-size: 15px;
		}
	}
</style>