---
import Layout from '../../../../layouts/Layout.astro';

const pageTitle = '子ども将棋講座';
---

<Layout title={pageTitle}>
	<main class="child-shogi-page">

		<!-- ヒーロー -->
		<section
			class="child-shogi-hero"
			style={`background-image:
				linear-gradient(rgba(0,0,0,.28), rgba(0,0,0,.28)),
				url('/images/community-center/child-shogi/hero.jpg');`}
		>
			<h1>子ども将棋講座</h1>
		</section>

		<!-- パンくず -->
		<nav class="child-shogi-breadcrumbs" aria-label="パンくずリスト">
			<a href="/">Home</a>
			<span>/</span>

			<a href="/takikawa_community_icenter/">
				滝川コミュニティセンター
			</a>

			<span>/</span>

			<a href="/takikawa_community_icenter/takikawa_commicenter-regular_courses/">
				文化教養講座
			</a>

			<span>/</span>
			<span>子ども将棋講座</span>
		</nav>


		<!-- 導入 -->
		<section class="child-shogi-intro">
			<div class="child-shogi-intro__inner">
				<p>
					日本の伝統文化である将棋を継承、子どもたちの健全育成の場として、
					これから将棋を始めようとする子や駒の動かし方やルールが分からない子にも
					指導員が丁寧に指導します。
				</p>

				<p>
					講座終了時に棋力に応じた「級位認定証」も授与しております。
				</p>
			</div>
		</section>


		<!-- アコーディオン一覧 -->
		<section class="child-shogi-sections">
			<div class="child-shogi-sections__inner">

				<!-- 0. 募集について -->
				<details class="child-shogi-accordion" open>
					<summary>
						<span>募集について</span>
						<span class="child-shogi-accordion__icon" aria-hidden="true">＋</span>
					</summary>

					<div class="child-shogi-accordion__body">
                                <p>本年度の募集は終了しました。</p>
                                <p>10月からの新規受講生を募集しております。</p>
                                <p>受講をご希望の方は、コミセン窓口までお問い合わせください。</p>
					</div>
				</details>

                <!-- 1. 子ども将棋講座概要 -->
                <details class="child-shogi-accordion" open>
                    <summary>
                        <span>子ども将棋講座概要</span>
                        <span
                            class="child-shogi-accordion__icon"
                            aria-hidden="true"
                        >
                            ＋
                        </span>
                    </summary>

                    <div class="child-shogi-accordion__body">

                        <!-- =========================================
                            案内画像2枚
                        ========================================= -->

                        <div class="child-shogi-grid child-shogi-grid--two">

                            <button
                                type="button"
                                class="child-shogi-image-button"
                                data-lightbox-image="/images/community-center/child-shogi/overview-01.png"
                                data-lightbox-group="child-shogi-overview"
                                aria-label="子ども将棋講座概要を拡大表示"
                            >
                                <img
                                    src="/images/community-center/child-shogi/overview-01.png"
                                    alt="子ども将棋講座概要"
                                    loading="lazy"
                                />
                            </button>

                            <button
                                type="button"
                                class="child-shogi-image-button"
                                data-lightbox-image="/images/community-center/child-shogi/overview-02.png"
                                data-lightbox-group="child-shogi-overview"
                                aria-label="子ども将棋講座案内を拡大表示"
                            >
                                <img
                                    src="/images/community-center/child-shogi/overview-02.png"
                                    alt="子ども将棋講座案内"
                                    loading="lazy"
                                />
                            </button>

                        </div>

                        <!-- =========================================
                            概要：写真＋テキスト 2カラム
                        ========================================= -->

                        <div class="child-shogi-overview">

                            <div class="child-shogi-overview__photo">
                                <img
                                    src="/images/community-center/child-shogi/overview-photo.jpg"
                                    alt="子ども将棋講座の様子"
                                    loading="lazy"
                                />
                            </div>

                            <div class="child-shogi-overview__details">

                                <p class="child-shogi-overview__recruit">
                                    <strong>
                                        募集受付期間　前期 2月中旬・後期追加募集　8月下旬
                                    </strong>
                                </p>

                                <ul>
                                    <li>
                                        開催期間
                                        <ul>
                                            <li>前期 4月〜9月</li>
                                            <li>後期10月〜3月</li>
                                        </ul>
                                    </li>

                                    <li>
                                        開催日時
                                        <ul>
                                            <li>
                                                毎月第1・3土曜日 午前10時〜12時
                                                <span class="child-shogi-red">
                                                    （開催日が変更となる場合あり）
                                                </span>
                                            </li>
                                        </ul>
                                    </li>

                                    <li>
                                        開催場所　滝川コミュニティセンター全館
                                    </li>

                                    <li>
                                        対象 小学生（新1年生〜新6年生）

                                        <p class="child-shogi-red child-shogi-emphasis">
                                            滝川学区在住児童優先
                                        </p>

                                        <p class="child-shogi-overview__note">
                                            滝川学区外児童は定員不足による二次募集から対象
                                        </p>
                                    </li>

                                    <li>
                                        定員 50名
                                    </li>

                                    <li>
                                        内容
                                        <ul>
                                            <li>挨拶・ルール・礼儀・駒の動かし方</li>
                                            <li>クラス分けによる練習対局</li>
                                            <li>指導員による指導対局</li>
                                            <li>弥生杯・トーナメント大会開催</li>
                                            <li>級位認定・認定証の授与</li>
                                            <li>皆勤賞・あっぱれ賞の授与</li>
                                            <li>
                                                <span class="child-shogi-red child-shogi-emphasis">
                                                    プロ棋士特別指導
                                                </span>
                                                　半期に1回　など
                                            </li>
                                        </ul>
                                    </li>

                                    <li>
                                        講師：日本将棋連盟公認 棋道指導員、将棋指導員など（4名）
                                    </li>

                                    <li>
                                        会費：7,000円
                                    </li>
                                    <li>
                                        その他
                                        <ul>
                                            <li>初めての方でも安心して受講できます。</li>
                                            <li>兄弟姉妹の申し込みは抽選時配慮致します。</li>
                                            <li>前後期会員は優先入会して頂けます。</li>
                                            <li>
                                                災害・運営都合により開催中止、延期する場合がございます。
                                            </li>
                                            <li>
                                                子ども用スリッパが必要な際はご持参ください。
                                            </li>
                                        </ul>
                                    </li>                                    
                                </ul>
                            </div>
                        </div>
                    </div>
                </details>


                <!-- 2. 注意事項 -->
                <details class="child-shogi-accordion" open>
                    <summary>
                        <span>受講にあたっての注意事項</span>
                        <span
                            class="child-shogi-accordion__icon"
                            aria-hidden="true"
                        >
                            ＋
                        </span>
                    </summary>

                    <div class="child-shogi-accordion__body">

                        <div class="child-shogi-notice">

                            <p>
                                受講にあたってのご連絡は
                                <span class="child-shogi-red child-shogi-emphasis">
                                    当ホームページ
                                </span>
                                及び
                                <span class="child-shogi-red child-shogi-emphasis">
                                    らくらく連絡網
                                </span>
                                にて行います。
                            </p>

                            <p>
                                受講生は必ず
                                <span class="child-shogi-red child-shogi-emphasis">
                                    らくらく連絡網アプリ
                                </span>
                                のご登録をお願いいたします。
                            </p>

                        </div>

                        <button
                            type="button"
                            class="child-shogi-image-button child-shogi-image-button--single"
                            data-lightbox-image="/images/community-center/child-shogi/rule.png"
                            data-lightbox-group="child-shogi-rule"
                            aria-label="受講にあたっての注意事項を拡大表示"
                        >
                            <img
                                src="/images/community-center/child-shogi/rule.png"
                                alt="子ども将棋講座 受講にあたっての注意事項"
                                loading="lazy"
                            />
                        </button>

                    </div>
                </details>


				<!-- 3. 日程表 -->
				<details class="child-shogi-accordion" open>
					<summary>
						<span>令和8年 子ども将棋講座開催日程表</span>
						<span class="child-shogi-accordion__icon" aria-hidden="true">＋</span>
					</summary>

					<div class="child-shogi-accordion__body">
						<div class="child-shogi-grid child-shogi-grid--two">

							<button
								type="button"
								class="child-shogi-image-button"
								data-lightbox-image="/images/community-center/child-shogi/schedule-01.png"
								data-lightbox-group="child-shogi-schedule"
								aria-label="令和8年子ども将棋講座日程表1を拡大表示"
							>
								<img
									src="/images/community-center/child-shogi/schedule-01.png"
									alt="令和8年 子ども将棋講座開催日程表 前半"
									loading="lazy"
								/>
							</button>

							<button
								type="button"
								class="child-shogi-image-button"
								data-lightbox-image="/images/community-center/child-shogi/schedule-02.png"
								data-lightbox-group="child-shogi-schedule"
								aria-label="令和8年子ども将棋講座日程表2を拡大表示"
							>
								<img
									src="/images/community-center/child-shogi/schedule-02.png"
									alt="令和8年 子ども将棋講座開催日程表 後半"
									loading="lazy"
								/>
							</button>

						</div>
					</div>
				</details>


				<!-- 4. 近隣講座 -->
				<details class="child-shogi-accordion" open>
					<summary>
						<span>近隣の将棋講座のご案内</span>
						<span class="child-shogi-accordion__icon" aria-hidden="true">＋</span>
					</summary>

					<div class="child-shogi-accordion__body">
						<button
							type="button"
							class="child-shogi-image-button child-shogi-image-button--single"
							data-lightbox-image="/images/community-center/child-shogi/nearby.png"
							data-lightbox-group="child-shogi-nearby"
							aria-label="近隣の将棋講座の案内を拡大表示"
						>
							<img
								src="/images/community-center/child-shogi/nearby.png"
								alt="近隣の将棋講座のご案内"
								loading="lazy"
							/>
						</button>
					</div>
				</details>


				<!-- 5. 歴史 -->
				<details class="child-shogi-accordion" open>
					<summary>
						<span>これまでの子ども将棋講座・来館プロ棋士</span>
						<span class="child-shogi-accordion__icon" aria-hidden="true">＋</span>
					</summary>

					<div class="child-shogi-accordion__body">
						<div class="child-shogi-grid child-shogi-grid--two">

							<button
								type="button"
								class="child-shogi-image-button"
								data-lightbox-image="/images/community-center/child-shogi/history-01.png"
								data-lightbox-group="child-shogi-history"
								aria-label="これまでの子ども将棋講座1を拡大表示"
							>
								<img
									src="/images/community-center/child-shogi/history-01.png"
									alt="これまでの子ども将棋講座"
									loading="lazy"
								/>
							</button>

							<button
								type="button"
								class="child-shogi-image-button"
								data-lightbox-image="/images/community-center/child-shogi/history-02.png"
								data-lightbox-group="child-shogi-history"
								aria-label="来館プロ棋士一覧を拡大表示"
							>
								<img
									src="/images/community-center/child-shogi/history-02.png"
									alt="子ども将棋講座 来館プロ棋士"
									loading="lazy"
								/>
							</button>

						</div>
					</div>
				</details>

			</div>
		</section>


		<!-- ライトボックス -->
        <div
            id="child-shogi-lightbox"
            class="image-lightbox"
            aria-hidden="true"
        >
            <button
                type="button"
                class="image-lightbox__close"
                aria-label="拡大表示を閉じる"
            >
                ×
            </button>

            <button
                type="button"
                class="image-lightbox__nav image-lightbox__nav--prev"
                aria-label="前の画像"
            >
                ‹
            </button>

            <div class="image-lightbox__viewport">
                <img
                    class="image-lightbox__image"
                    src=""
                    alt=""
                    draggable="false"
                />
            </div>

            <button
                type="button"
                class="image-lightbox__nav image-lightbox__nav--next"
                aria-label="次の画像"
            >
                ›
            </button>

            <div
                class="image-lightbox__counter"
                aria-live="polite"
            ></div>
        </div>

	</main>
</Layout>
<style>
	.child-shogi-page {
		background: #f4f9fc;
		color: #111827;
	}

	/* Hero */

	.child-shogi-hero {
		display: grid;
		min-height: 480px;
		place-items: center;
		background-position: center;
		background-size: cover;
	}

	.child-shogi-hero h1 {
		margin: 0;
		color: #fff;
		font-size: clamp(42px, 5vw, 68px);
		font-weight: 400;
		text-align: center;
		text-shadow: 0 2px 12px rgb(0 0 0 / 30%);
	}

	/* Breadcrumb */

	.child-shogi-breadcrumbs {
		display: flex;
		align-items: center;
		flex-wrap: wrap;
		width: min(calc(100% - 48px), 1280px);
		margin: 0 auto;
		padding: 32px 0;
		gap: 10px;
		font-size: 14px;
	}

	.child-shogi-breadcrumbs a {
		color: #009fe8;
		text-decoration: none;
	}

	/* Intro */

	.child-shogi-intro {
		padding: 56px 0 64px;
	}

	.child-shogi-intro__inner {
		width: min(calc(100% - 64px), 900px);
		margin: 0 auto;
	}

	.child-shogi-intro p {
		margin: 0 0 20px;
		font-size: 17px;
		line-height: 1.9;
	}

	/* Sections */

	.child-shogi-sections {
		padding-bottom: 96px;
	}

	.child-shogi-sections__inner {
		width: min(calc(100% - 64px), 1280px);
		margin: 0 auto;
	}

	.child-shogi-accordion {
		overflow: hidden;
		margin-bottom: 24px;
		border-radius: 8px;
		background: #fff;
	}

	.child-shogi-accordion > summary {
		display: flex;
		align-items: center;
		justify-content: space-between;
		padding: 20px 28px;
		background: #0da5df;
		color: #fff;
		cursor: pointer;
		font-size: 19px;
		font-weight: 600;
		list-style: none;
	}

	.child-shogi-accordion > summary::-webkit-details-marker {
		display: none;
	}

	.child-shogi-accordion__icon {
		font-size: 26px;
		font-weight: 300;
		line-height: 1;
		transition: transform 0.2s ease;
	}

	.child-shogi-accordion[open] .child-shogi-accordion__icon {
		transform: rotate(45deg);
	}

	.child-shogi-accordion__body {
		padding: 48px;
	}

	.child-shogi-grid {
		display: grid;
		gap: 28px;
	}

	.child-shogi-grid--two {
		grid-template-columns: repeat(2, minmax(0, 1fr));
	}

	/* Images */

	.child-shogi-image-button {
		display: block;
		width: 100%;
		padding: 0;
		border: 0;
		background: transparent;
		cursor: zoom-in;
	}

	.child-shogi-image-button img {
		display: block;
		width: 100%;
		height: auto;
	}

	.child-shogi-image-button--single {
		max-width: 900px;
		margin: 0 auto;
	}

	.child-shogi-static-image {
		width: min(100%, 760px);
		margin: 40px auto 0;
	}

	.child-shogi-static-image img {
		display: block;
		width: 100%;
		height: auto;
	}

	.child-shogi-description {
		max-width: 950px;
		margin: 42px auto 0;
	}

	.child-shogi-description p,
	.child-shogi-description li {
		font-size: 16px;
		line-height: 1.8;
	}

	.child-shogi-description ul {
		padding-left: 1.5em;
	}

	/* Lightbox */

	.image-lightbox {
		position: fixed;
		z-index: 9999;
		inset: 0;
		display: none;
		align-items: center;
		justify-content: center;
		padding: 48px;
		background: rgb(0 0 0 / 88%);
	}

	.image-lightbox.is-open {
		display: flex;
	}

	.image-lightbox__content {
		display: flex;
		max-width: 100%;
		max-height: 100%;
		flex-direction: column;
		align-items: center;
		justify-content: center;
	}

	.image-lightbox__image {
		display: block;
		width: auto;
		height: auto;
		max-width: min(1500px, 94vw);
		max-height: 88vh;
		object-fit: contain;
	}

	.image-lightbox__counter {
		margin: 10px 0 0;
		color: #fff;
		font-size: 13px;
	}

	.image-lightbox__close {
		position: absolute;
		top: 18px;
		right: 24px;
		width: 48px;
		height: 48px;
		border: 0;
		background: transparent;
		color: #fff;
		cursor: pointer;
		font-size: 42px;
	}

	.image-lightbox__nav {
		position: absolute;
		top: 50%;
		display: grid;
		width: 56px;
		height: 72px;
		place-items: center;
		border: 0;
		background: rgb(0 0 0 / 25%);
		color: #fff;
		cursor: pointer;
		font-size: 52px;
		transform: translateY(-50%);
	}

	.image-lightbox__nav--prev {
		left: 16px;
	}

	.image-lightbox__nav--next {
		right: 16px;
	}

	.image-lightbox__nav:disabled {
		display: none;
	}

    /* =========================================================
    Overview
    ========================================================= */

    .child-shogi-overview {
        display: grid;
        grid-template-columns:
            minmax(0, 1fr)
            minmax(0, 1fr);
        align-items: start;
        gap: 64px;
        margin-top: 64px;
        margin-bottom: 56px;
    }

    .child-shogi-overview__photo {
        width: 100%;
    }

    .child-shogi-overview__photo img {
        display: block;
        width: 100%;
        height: auto;
    }

    .child-shogi-overview__details {
        min-width: 0;
        font-size: 16px;
        line-height: 1.75;
    }

    .child-shogi-overview__recruit {
        margin: 0 0 22px;
        font-size: 18px;
        line-height: 1.7;
    }

    .child-shogi-overview__details ul {
        margin: 0;
        padding-left: 1.5em;
    }

    .child-shogi-overview__details > ul > li {
        margin-bottom: 8px;
    }

    .child-shogi-overview__details li ul {
        margin-top: 6px;
    }

    .child-shogi-overview__details li li {
        margin-bottom: 4px;
    }

    .child-shogi-overview__note {
        margin: 4px 0 0;
    }

    .child-shogi-red {
        color: #f00;
    }

    .child-shogi-emphasis {
        font-weight: 700;
    }


    /* =========================================================
    Notice
    ========================================================= */

    .child-shogi-notice {
        margin: 0 0 36px;
    }

    .child-shogi-notice p {
        margin: 0 0 24px;
        font-size: 17px;
        line-height: 1.9;
    }


    /* =========================================================
    Tablet
    ========================================================= */

    @media (max-width: 900px) {
        .child-shogi-overview {
            grid-template-columns: 1fr;
            gap: 36px;
        }

        .child-shogi-overview__photo {
            width: min(100%, 680px);
            margin: 0 auto;
        }

        .child-shogi-overview__details {
            width: min(100%, 720px);
            margin: 0 auto;
        }
    }


    /* =========================================================
    Mobile
    ========================================================= */

	@media (max-width: 900px) {
		.child-shogi-hero {
			min-height: 360px;
		}

		.child-shogi-grid--two {
			grid-template-columns: 1fr;
		}

		.child-shogi-accordion__body {
			padding: 36px 28px;
		}
	}

	@media (max-width: 600px) {
		.child-shogi-hero {
			min-height: 300px;
		}

		.child-shogi-breadcrumbs {
			width: calc(100% - 32px);
			padding: 24px 0;
		}

		.child-shogi-intro__inner,
		.child-shogi-sections__inner {
			width: calc(100% - 32px);
		}

		.child-shogi-accordion__body {
			padding: 26px 18px;
		}

		.child-shogi-accordion > summary {
			padding: 17px 20px;
			font-size: 16px;
		}
        .child-shogi-overview {
            margin-bottom: 40px;
        }

        .child-shogi-overview__details {
            font-size: 15px;
        }

        .child-shogi-overview__recruit {
            font-size: 16px;
        }

        .child-shogi-notice p {
            font-size: 15px;
        }
	}
</style>

<script>
	const lightbox =
		document.querySelector('#child-shogi-lightbox');

	const lightboxImage =
		lightbox?.querySelector('.image-lightbox__image');

	const viewport =
		lightbox?.querySelector('.image-lightbox__viewport');

	const closeButton =
		lightbox?.querySelector('.image-lightbox__close');

	const prevButton =
		lightbox?.querySelector('.image-lightbox__nav--prev');

	const nextButton =
		lightbox?.querySelector('.image-lightbox__nav--next');

	const counter =
		lightbox?.querySelector('.image-lightbox__counter');


	/* =========================================================
	   State
	========================================================= */

	let currentGroup = [];
	let currentIndex = 0;

	let isZoomed = false;
	let isDragging = false;
	let didDrag = false;

	let startX = 0;
	let startY = 0;

	let translateX = 0;
	let translateY = 0;

	let dragStartTranslateX = 0;
	let dragStartTranslateY = 0;


	/* =========================================================
	   Transform
	========================================================= */

	const updateTransform = () => {
		if (!(lightboxImage instanceof HTMLImageElement)) {
			return;
		}

		if (!isZoomed) {
			lightboxImage.style.transform = '';
			return;
		}

		lightboxImage.style.transform =
			`translate(${translateX}px, ${translateY}px) scale(2)`;
	};


	const resetZoom = () => {
		if (!(lightboxImage instanceof HTMLImageElement)) {
			return;
		}

		isZoomed = false;
		isDragging = false;
		didDrag = false;

		translateX = 0;
		translateY = 0;

		lightboxImage.classList.remove(
			'is-zoomed',
			'is-dragging',
		);

		lightboxImage.style.transform = '';
	};


	const enableZoom = () => {
		if (!(lightboxImage instanceof HTMLImageElement)) {
			return;
		}

		isZoomed = true;

		translateX = 0;
		translateY = 0;

		lightboxImage.classList.add('is-zoomed');

		updateTransform();
	};


	const disableZoom = () => {
		resetZoom();
	};


	/* =========================================================
	   Update image
	========================================================= */

	const updateLightbox = () => {
		if (
			!(lightboxImage instanceof HTMLImageElement) ||
			currentGroup.length === 0
		) {
			return;
		}

		resetZoom();

		const currentButton =
			currentGroup[currentIndex];

		if (!(currentButton instanceof HTMLElement)) {
			return;
		}

		const src =
			currentButton.dataset.lightboxImage;

		const sourceImage =
			currentButton.querySelector('img');

		if (!src) {
			return;
		}

		lightboxImage.src = src;

		lightboxImage.alt =
			sourceImage instanceof HTMLImageElement
				? sourceImage.alt
				: '';

		if (counter instanceof HTMLElement) {
			counter.textContent =
				`${currentIndex + 1} / ${currentGroup.length}`;
		}

		if (prevButton instanceof HTMLButtonElement) {
			prevButton.disabled =
				currentGroup.length <= 1;
		}

		if (nextButton instanceof HTMLButtonElement) {
			nextButton.disabled =
				currentGroup.length <= 1;
		}
	};


	/* =========================================================
	   Open
	========================================================= */

	const openLightbox = (button) => {
		if (
			!lightbox ||
			!(button instanceof HTMLElement)
		) {
			return;
		}

		const groupName =
			button.dataset.lightboxGroup;

		if (!groupName) {
			return;
		}

		currentGroup = Array.from(
			document.querySelectorAll(
				'[data-lightbox-image]',
			),
		).filter((item) => {
			return (
				item instanceof HTMLElement &&
				item.dataset.lightboxGroup === groupName
			);
		});

		currentIndex =
			currentGroup.indexOf(button);

		if (currentIndex < 0) {
			currentIndex = 0;
		}

		updateLightbox();

		lightbox.classList.add('is-open');

		lightbox.setAttribute(
			'aria-hidden',
			'false',
		);

		document.body.style.overflow = 'hidden';
	};


	/* =========================================================
	   Close
	========================================================= */

	const closeLightbox = () => {
		if (!lightbox) {
			return;
		}

		resetZoom();

		lightbox.classList.remove('is-open');

		lightbox.setAttribute(
			'aria-hidden',
			'true',
		);

		if (lightboxImage instanceof HTMLImageElement) {
			lightboxImage.src = '';
			lightboxImage.alt = '';
		}

		currentGroup = [];
		currentIndex = 0;

		document.body.style.overflow = '';
	};


	/* =========================================================
	   Previous / Next
	========================================================= */

	const showPrevious = () => {
		if (currentGroup.length <= 1) {
			return;
		}

		currentIndex =
			(
				currentIndex -
				1 +
				currentGroup.length
			) %
			currentGroup.length;

		updateLightbox();
	};


	const showNext = () => {
		if (currentGroup.length <= 1) {
			return;
		}

		currentIndex =
			(currentIndex + 1) %
			currentGroup.length;

		updateLightbox();
	};


	/* =========================================================
	   Open trigger
	========================================================= */

	document.addEventListener('click', (event) => {
		if (!(event.target instanceof Element)) {
			return;
		}

		const button =
			event.target.closest(
				'[data-lightbox-image]',
			);

		if (!(button instanceof HTMLElement)) {
			return;
		}

		event.preventDefault();

		openLightbox(button);
	});


	/* =========================================================
	   Zoom by click
	========================================================= */

	lightboxImage?.addEventListener(
		'click',
		(event) => {
			if (
				!(lightboxImage instanceof HTMLImageElement)
			) {
				return;
			}

			event.preventDefault();
			event.stopPropagation();

			/*
			 * ドラッグ直後のclickでは
			 * ズームを解除しない
			 */
			if (didDrag) {
				didDrag = false;
				return;
			}

			if (isZoomed) {
				disableZoom();
			} else {
				enableZoom();
			}
		},
	);


	/* =========================================================
	   Drag start
	========================================================= */

	lightboxImage?.addEventListener(
		'pointerdown',
		(event) => {
			if (
				!isZoomed ||
				!(lightboxImage instanceof HTMLImageElement)
			) {
				return;
			}

			event.preventDefault();
			event.stopPropagation();

			isDragging = true;
			didDrag = false;

			startX = event.clientX;
			startY = event.clientY;

			dragStartTranslateX = translateX;
			dragStartTranslateY = translateY;

			lightboxImage.classList.add(
				'is-dragging',
			);

			lightboxImage.setPointerCapture(
				event.pointerId,
			);
		},
	);


	/* =========================================================
	   Drag move
	========================================================= */

	lightboxImage?.addEventListener(
		'pointermove',
		(event) => {
			if (
				!isDragging ||
				!isZoomed ||
				!(lightboxImage instanceof HTMLImageElement)
			) {
				return;
			}

			event.preventDefault();

			const deltaX =
				event.clientX - startX;

			const deltaY =
				event.clientY - startY;

			/*
			 * 数px以上動いた場合だけ
			 * ドラッグとして判定
			 */
			if (
				Math.abs(deltaX) > 4 ||
				Math.abs(deltaY) > 4
			) {
				didDrag = true;
			}

			translateX =
				dragStartTranslateX + deltaX;

			translateY =
				dragStartTranslateY + deltaY;

			updateTransform();
		},
	);


	/* =========================================================
	   Drag end
	========================================================= */

	const endDrag = (event) => {
		if (
			!isDragging ||
			!(lightboxImage instanceof HTMLImageElement)
		) {
			return;
		}

		isDragging = false;

		lightboxImage.classList.remove(
			'is-dragging',
		);

		if (
			event instanceof PointerEvent &&
			lightboxImage.hasPointerCapture(
				event.pointerId,
			)
		) {
			lightboxImage.releasePointerCapture(
				event.pointerId,
			);
		}
	};


	lightboxImage?.addEventListener(
		'pointerup',
		endDrag,
	);

	lightboxImage?.addEventListener(
		'pointercancel',
		endDrag,
	);


	/* =========================================================
	   Controls
	========================================================= */

	closeButton?.addEventListener(
		'click',
		(event) => {
			event.stopPropagation();

			closeLightbox();
		},
	);


	prevButton?.addEventListener(
		'click',
		(event) => {
			event.stopPropagation();

			showPrevious();
		},
	);


	nextButton?.addEventListener(
		'click',
		(event) => {
			event.stopPropagation();

			showNext();
		},
	);


	/* =========================================================
	   Background click
	========================================================= */

	lightbox?.addEventListener(
		'click',
		(event) => {
			if (
				event.target === lightbox ||
				event.target === viewport
			) {
				closeLightbox();
			}
		},
	);


	/* =========================================================
	   Keyboard
	========================================================= */

	document.addEventListener(
		'keydown',
		(event) => {
			if (
				!lightbox?.classList.contains(
					'is-open',
				)
			) {
				return;
			}

			if (event.key === 'Escape') {
				closeLightbox();
			}

			if (event.key === 'ArrowLeft') {
				showPrevious();
			}

			if (event.key === 'ArrowRight') {
				showNext();
			}
		},
	);
</script>