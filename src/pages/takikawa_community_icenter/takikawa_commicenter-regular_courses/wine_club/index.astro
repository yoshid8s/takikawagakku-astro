---
import Layout from '../../../../layouts/Layout.astro';

const pageTitle = 'ワイン倶楽部';
---

<Layout title={pageTitle}>
	<main class="wine-club-page">

		<!-- =====================================================
		     Hero
		===================================================== -->

		<section class="wine-club-hero">
			<img
				src="/images/community-center/wine-club/hero.jpg"
				alt="ワイン倶楽部"
			/>

			<div class="wine-club-hero__overlay">
				<h1>ワイン倶楽部</h1>
			</div>
		</section>


		<!-- =====================================================
		     Breadcrumbs
		===================================================== -->

		<nav
			class="wine-club-breadcrumbs"
			aria-label="パンくずリスト"
		>
			<a href="/">Home</a>
			<span>/</span>

			<a href="/takikawa_community_icenter/">
				滝川コミュニティセンター
			</a>
			<span>/</span>

			<a href="/takikawa_community_icenter/takikawa_commicenter-regular_courses/">
				文化教養講座
			</a>
			<span>/</span>

			<span>ワイン倶楽部</span>
		</nav>


		<!-- =====================================================
		     Introduction
		===================================================== -->

		<section class="wine-club-intro">
			<div class="wine-club-inner wine-club-inner--narrow">

				<p>
					ワインについてより深く親しみ、楽しむための講座です。
				</p>

				<p>
					日曜日の午後、美味しいワインとともに楽しい時間を過ごしませんか。
				</p>

			</div>
		</section>


		<!-- =====================================================
		     お知らせ
		===================================================== -->

		<section class="wine-club-section wine-club-section--notice">
			<div class="wine-club-inner">

				<h2>お知らせ</h2>

				<div class="wine-club-notice">
					<h3>2026年度前期 当選者について</h3>

                    <p>
                    2026年度前期のワインクラブ当選者が決まりました。以下をご確認いただき、当選された方は、3月10日（火）から22日（日）12時までに滝川コミュニティセンター受付（月曜休館日）にて手続きを完了させてください。期限までに手続きが完了しない場合は辞退されたものとみなします。
                    </p>

					<div class="wine-club-notice__image">
						<img
							src="/images/community-center/wine-club/winner-2026.png"
							alt="2026年度前期 ワイン倶楽部 当選者番号"
							loading="lazy"
						/>
					</div>
				</div>

			</div>
		</section>


		<!-- =====================================================
		     講座内容
		===================================================== -->

		<section class="wine-club-section wine-club-section--course">
			<div class="wine-club-inner">

				<h2>講座内容</h2>

				<div class="wine-club-course">

					<!-- 左：画像 -->

					<div class="wine-club-course__image">

							<img
								src="/images/community-center/wine-club/wine-club.png"
								alt="滝川ワイン倶楽部"
								loading="lazy"
							/>

					</div>


					<!-- 右：講座内容 -->

					<div class="wine-club-course__content">

						<dl class="wine-club-course__details">

							<div class="wine-club-course__row">
								<dt>運営方法</dt>
								<dd>
									会員から幹事を選出<br />
                                    当番制による会場準備等自主的に運営していただきます。
								</dd>
							</div>

							<div class="wine-club-course__row">
								<dt>開催期間</dt>
								<dd>
									前期 4月～9月<br />
                                    後期　10月～3月
								</dd>
							</div>

							<div class="wine-club-course__row">
								<dt>開催日時</dt>
								<dd>
									毎月1回 日曜日<br />
									15:00〜16:30
								</dd>
							</div>

							<div class="wine-club-course__row">
								<dt>開催場所</dt>
								<dd>
									滝川コミセン　1階会議室
								</dd>
							</div>

							<div class="wine-club-course__row">
								<dt>対象</dt>
								<dd>
									成人の方<br />
                                    幹事または当番として運営にご協力頂ける
								</dd>
							</div>

							<div class="wine-club-course__row">
								<dt>定員</dt>
								<dd>
									35名
								</dd>
							</div>

							<div class="wine-club-course__row">
								<dt>内容</dt>
								<dd>
									世界のワインを楽しみながら、製法・特徴を講師によるトークにより楽しみながら学ぶ事ができます。
								</dd>
							</div>

							<div class="wine-club-course__row">
								<dt>講師</dt>
								<dd>
									増井　伸也　ソムリエ　（レストランテ・イルソーレ代表）
								</dd>
							</div>

							<div class="wine-club-course__row">
								<dt>会費</dt>
								<dd>
									10,000円
								</dd>
							</div>

							<div class="wine-club-course__row">
								<dt>その他</dt>
								<dd>
									交通乗用具を運転してのご来館はご遠慮ください。
                                    過度な飲酒はお控えください。前期会員は後期も優先入会して頂けます。
                                    災害・運営都合により開催中止延期する場合がございます。
								</dd>
							</div>

						</dl>

					</div>

				</div>


				<!-- 講座内容 下部画像 -->

				<div class="wine-club-course__bottom-image">
					<button
						class="wine-club-flyer-button"
						type="button"
						data-lightbox-image="/images/community-center/wine-club/wine-photo.png"
						data-lightbox-group="wine-club-flyer"
						aria-label="ワイン倶楽部のチラシを拡大表示"
					>
						<img
							src="/images/community-center/wine-club/wine-photo.png"
							alt="ワイン倶楽部の様子"
							loading="lazy"
						/>
					</button>
				</div>

			</div>
		</section>


		<!-- =====================================================
		     募集案内
		===================================================== -->

		<section class="wine-club-section wine-club-section--recruit">
			<div class="wine-club-inner wine-club-inner--narrow">

				<h2>募集案内</h2>

				<div class="wine-club-recruit">
					<p>
						<strong>募集受付期間</strong>
					</p>

					<p>
						前期 2月中旬・後期追加募集　8月下旬
					</p>
				</div>

			</div>
		</section>
		<div
			class="image-lightbox"
			id="wine-club-lightbox"
			aria-hidden="true"
		>
			<button
				class="image-lightbox__close"
				type="button"
				aria-label="画像を閉じる"
			>
				×
			</button>

			<div class="image-lightbox__content">
				<img
					class="image-lightbox__image"
					src=""
					alt=""
				/>
			</div>
		</div>
	</main>
</Layout>


<style>
	/* =========================================================
	   Page
	========================================================= */

	.wine-club-page {
		width: 100%;
		margin: 0;
		padding: 0;
		background: #fff;
		color: #111827;
	}

	.wine-club-inner {
		width: min(calc(100% - 64px), 1180px);
		margin: 0 auto;
	}

	.wine-club-inner--narrow {
		max-width: 900px;
	}


	/* =========================================================
	   Hero
	========================================================= */

	.wine-club-hero {
		position: relative;
		width: 100%;
		height: clamp(300px, 38vw, 520px);
		overflow: hidden;
		background: #111827;
	}

	.wine-club-hero img {
		display: block;
		width: 100%;
		height: 100%;
		object-fit: cover;
		object-position: center;
	}

	.wine-club-hero__overlay {
		position: absolute;
		inset: 0;
		display: flex;
		align-items: center;
		justify-content: center;
		padding: 32px;
		background: rgb(0 0 0 / 24%);
	}

	.wine-club-hero h1 {
		margin: 0;
		color: #fff;
		font-size: clamp(40px, 5vw, 64px);
		font-weight: 400;
		line-height: 1.3;
		text-align: center;
		text-shadow: 0 2px 12px rgb(0 0 0 / 35%);
	}


	/* =========================================================
	   Breadcrumbs
	========================================================= */

	.wine-club-breadcrumbs {
		display: flex;
		align-items: center;
		flex-wrap: wrap;
		width: min(calc(100% - 48px), 1280px);
		margin: 0 auto;
		padding: 30px 0;
		gap: 10px;
		font-size: 14px;
		line-height: 1.6;
	}

	.wine-club-breadcrumbs a {
		color: #009fe8;
		text-decoration: none;
	}

	.wine-club-breadcrumbs a:hover {
		text-decoration: underline;
		text-underline-offset: 0.2em;
	}


	/* =========================================================
	   Introduction
	========================================================= */

	.wine-club-intro {
		padding: 56px 0 72px;
		background: #f4f9fc;
	}

	.wine-club-intro p {
		margin: 0 0 18px;
		font-size: 18px;
		line-height: 1.9;
		text-align: center;
	}

	.wine-club-intro p:last-child {
		margin-bottom: 0;
	}


	/* =========================================================
	   Section common
	========================================================= */

	.wine-club-section {
		padding: 80px 0 96px;
	}

	.wine-club-section h2 {
		margin: 0 0 52px;
		font-size: clamp(34px, 4vw, 48px);
		font-weight: 400;
		line-height: 1.4;
		text-align: center;
	}


	/* =========================================================
	   Notice
	========================================================= */

	.wine-club-section--notice {
		background: #fff;
	}

	.wine-club-notice {
		width: min(100%, 820px);
		margin: 0 auto;
		text-align: center;
	}

	.wine-club-notice h3 {
		margin: 0 0 32px;
		font-size: 24px;
		font-weight: 500;
		line-height: 1.5;
	}

	.wine-club-notice__image {
		width: min(100%, 560px);
		margin: 0 auto;
	}

	.wine-club-notice__image img {
		display: block;
		width: 100%;
		height: auto;
		margin: 0 auto;
	}


	/* =========================================================
	   Course
	========================================================= */

	.wine-club-section--course {
		background: #f4f9fc;
	}

	.wine-club-course {
		display: grid;
		grid-template-columns:
			minmax(300px, 0.9fr)
			minmax(0, 1.1fr);
		align-items: start;
		gap: 64px;
	}

	.wine-club-course__image {
		width: 100%;
		max-width: 500px;
		margin: 0 auto;
	}

	.wine-club-course__image img {
		display: block;
		width: 100%;
		height: auto;
	}


	/* =========================================================
	   Course details
	========================================================= */

	.wine-club-course__details {
		margin: 0;
	}

	.wine-club-course__row {
		display: grid;
		grid-template-columns: 110px minmax(0, 1fr);
		padding: 14px 0;
		border-bottom: 1px solid #d7e0e6;
	}

	.wine-club-course__row:first-child {
		border-top: 1px solid #d7e0e6;
	}

	.wine-club-course__row dt {
		margin: 0;
		font-weight: 600;
		line-height: 1.8;
	}

	.wine-club-course__row dd {
		margin: 0;
		line-height: 1.8;
	}

	/* =========================================================
	   Flyer button
	========================================================= */

	.wine-club-flyer-button {
		display: block;
		width: 100%;
		padding: 0;
		border: 0;
		background: transparent;
		cursor: zoom-in;
	}

	.wine-club-flyer-button img {
		display: block;
		width: 100%;
		height: auto;
	}


	/* =========================================================
	   Bottom image
	========================================================= */

	.wine-club-course__bottom-image {
		width: min(100%, 900px);
		margin: 64px auto 0;
	}

	.wine-club-course__bottom-image img {
		display: block;
		width: 100%;
		height: auto;
		margin: 0 auto;
	}


	/* =========================================================
	   Recruit
	========================================================= */

	.wine-club-section--recruit {
		background: #fff;
	}

	.wine-club-recruit {
		padding: 36px 40px;
		background: #f4f9fc;
		border-radius: 4px;
	}

	.wine-club-recruit p {
		margin: 0 0 16px;
		font-size: 17px;
		line-height: 1.8;
	}

	.wine-club-recruit p:last-child {
		margin-bottom: 0;
	}

	.wine-club-recruit__note {
		color: #4b5563;
		font-size: 15px !important;
	}

	/* =========================================================
	   Lightbox
	========================================================= */

	.image-lightbox {
		position: fixed;
		z-index: 9999;
		inset: 0;
		display: none;
		align-items: center;
		justify-content: center;
		padding: 48px;
		background: rgb(0 0 0 / 88%);
	}

	.image-lightbox.is-open {
		display: flex;
	}

	.image-lightbox__content {
		display: flex;
		max-width: 100%;
		max-height: 100%;
		align-items: center;
		justify-content: center;
	}

	.image-lightbox__image {
		display: block;
		width: auto;
		height: auto;
		max-width: min(1500px, 94vw);
		max-height: 88vh;
		object-fit: contain;

		cursor: zoom-in;
		user-select: none;
		-webkit-user-drag: none;
		touch-action: none;

		transition: transform 0.15s ease;
		transform-origin: center center;
	}

	.image-lightbox__image.is-zoomed {
		cursor: grab;
		transition: none;
	}

	.image-lightbox__image.is-dragging {
		cursor: grabbing;
	}

	.image-lightbox__close {
		position: absolute;
		top: 18px;
		right: 24px;
		width: 48px;
		height: 48px;
		padding: 0;
		border: 0;
		background: transparent;
		color: #fff;
		cursor: pointer;
		font-size: 42px;
		line-height: 1;
	}


	/* =========================================================
	   Tablet
	========================================================= */

	@media (max-width: 900px) {
		.wine-club-inner {
			width: min(calc(100% - 40px), 760px);
		}

		.wine-club-course {
			grid-template-columns: 1fr;
			gap: 44px;
		}

		.wine-club-course__image {
			max-width: 520px;
		}

		.wine-club-course__content {
			width: 100%;
			max-width: 680px;
			margin: 0 auto;
		}

		.wine-club-course__bottom-image {
			margin-top: 48px;
		}
	}


	/* =========================================================
	   Mobile
	========================================================= */

	@media (max-width: 600px) {
		.wine-club-inner {
			width: calc(100% - 32px);
		}

		.wine-club-hero {
			height: 300px;
		}

		.wine-club-hero h1 {
			font-size: 36px;
		}

		.wine-club-breadcrumbs {
			width: calc(100% - 32px);
			padding: 22px 0;
			font-size: 13px;
		}

		.wine-club-intro {
			padding: 44px 0 52px;
		}

		.wine-club-intro p {
			font-size: 16px;
			text-align: left;
		}

		.wine-club-section {
			padding: 56px 0 68px;
		}

		.wine-club-section h2 {
			margin-bottom: 36px;
		}

		.wine-club-notice h3 {
			margin-bottom: 24px;
			font-size: 20px;
		}

		.wine-club-course {
			gap: 36px;
		}

		.wine-club-course__row {
			grid-template-columns: 90px minmax(0, 1fr);
			padding: 12px 0;
			font-size: 15px;
		}

		.wine-club-course__bottom-image {
			margin-top: 40px;
		}

		.wine-club-recruit {
			padding: 28px 24px;
		}

		.wine-club-recruit p {
			font-size: 15px;
		}
	}
</style>
<script>
	const lightbox = document.querySelector('#wine-club-lightbox');
	const lightboxImage =
		lightbox?.querySelector('.image-lightbox__image');
	const closeButton =
		lightbox?.querySelector('.image-lightbox__close');

	let currentButton = null;

	let isZoomed = false;
	let isDragging = false;

	let imageX = 0;
	let imageY = 0;

	let dragStartX = 0;
	let dragStartY = 0;

	const zoomScale = 2;

	const applyImageTransform = () => {
		if (!(lightboxImage instanceof HTMLImageElement)) return;

		if (!isZoomed) {
			lightboxImage.style.transform = '';
			return;
		}

		lightboxImage.style.transform =
			`translate(${imageX}px, ${imageY}px) scale(${zoomScale})`;
	};

	const resetZoom = () => {
		if (!(lightboxImage instanceof HTMLImageElement)) return;

		isZoomed = false;
		isDragging = false;

		imageX = 0;
		imageY = 0;

		lightboxImage.classList.remove(
			'is-zoomed',
			'is-dragging'
		);

		lightboxImage.style.transform = '';
	};

	const openLightbox = (button) => {
		if (
			!lightbox ||
			!(button instanceof HTMLElement) ||
			!(lightboxImage instanceof HTMLImageElement)
		) {
			return;
		}

		const src = button.dataset.lightboxImage;
		const image = button.querySelector('img');

		if (!src) return;

		currentButton = button;

		resetZoom();

		lightboxImage.src = src;
		lightboxImage.alt =
			image instanceof HTMLImageElement ? image.alt : '';

		lightbox.classList.add('is-open');
		lightbox.setAttribute('aria-hidden', 'false');

		document.body.style.overflow = 'hidden';
	};

	const closeLightbox = () => {
		if (!lightbox) return;

		resetZoom();

		lightbox.classList.remove('is-open');
		lightbox.setAttribute('aria-hidden', 'true');

		if (lightboxImage instanceof HTMLImageElement) {
			lightboxImage.src = '';
		}

		document.body.style.overflow = '';

		if (currentButton instanceof HTMLElement) {
			currentButton.focus();
		}

		currentButton = null;
	};

	const toggleZoom = () => {
		if (!(lightboxImage instanceof HTMLImageElement)) return;

		if (isZoomed) {
			resetZoom();
			return;
		}

		isZoomed = true;
		imageX = 0;
		imageY = 0;

		lightboxImage.classList.add('is-zoomed');

		applyImageTransform();
	};

	/*
	 * 防災ページと同じく document でクリックを監視
	 */
	document.addEventListener('click', (event) => {
		if (!(event.target instanceof Element)) return;

		const button =
			event.target.closest('[data-lightbox-image]');

		if (!(button instanceof HTMLElement)) return;

		event.preventDefault();
		event.stopPropagation();

		openLightbox(button);
	});

	/*
	 * クリック / タップで拡大・縮小
	 */
	lightboxImage?.addEventListener('click', (event) => {
		event.preventDefault();
		event.stopPropagation();

		if (isDragging) return;

		toggleZoom();
	});

	/*
	 * マウスドラッグ
	 */
	lightboxImage?.addEventListener('mousedown', (event) => {
		if (
			!isZoomed ||
			!(lightboxImage instanceof HTMLImageElement)
		) {
			return;
		}

		event.preventDefault();
		event.stopPropagation();

		isDragging = true;

		dragStartX = event.clientX - imageX;
		dragStartY = event.clientY - imageY;

		lightboxImage.classList.add('is-dragging');
	});

	document.addEventListener('mousemove', (event) => {
		if (!isDragging || !isZoomed) return;

		event.preventDefault();

		imageX = event.clientX - dragStartX;
		imageY = event.clientY - dragStartY;

		applyImageTransform();
	});

	document.addEventListener('mouseup', () => {
		if (!isDragging) return;

		isDragging = false;

		if (lightboxImage instanceof HTMLImageElement) {
			lightboxImage.classList.remove('is-dragging');
		}
	});

	/*
	 * タッチ / Pointer Event
	 */
	lightboxImage?.addEventListener('pointerdown', (event) => {
		if (
			!isZoomed ||
			!(lightboxImage instanceof HTMLImageElement)
		) {
			return;
		}

		event.preventDefault();

		isDragging = true;

		dragStartX = event.clientX - imageX;
		dragStartY = event.clientY - imageY;

		lightboxImage.classList.add('is-dragging');
		lightboxImage.setPointerCapture(event.pointerId);
	});

	lightboxImage?.addEventListener('pointermove', (event) => {
		if (
			!isDragging ||
			!isZoomed ||
			!(lightboxImage instanceof HTMLImageElement)
		) {
			return;
		}

		event.preventDefault();

		imageX = event.clientX - dragStartX;
		imageY = event.clientY - dragStartY;

		applyImageTransform();
	});

	lightboxImage?.addEventListener('pointerup', (event) => {
		if (!(lightboxImage instanceof HTMLImageElement)) return;

		isDragging = false;

		lightboxImage.classList.remove('is-dragging');

		if (lightboxImage.hasPointerCapture(event.pointerId)) {
			lightboxImage.releasePointerCapture(event.pointerId);
		}
	});

	lightboxImage?.addEventListener('pointercancel', () => {
		isDragging = false;
		lightboxImage?.classList.remove('is-dragging');
	});

	closeButton?.addEventListener('click', (event) => {
		event.stopPropagation();
		closeLightbox();
	});

	lightbox?.addEventListener('click', (event) => {
		if (event.target === lightbox) {
			closeLightbox();
		}
	});

	document.addEventListener('keydown', (event) => {
		if (!lightbox?.classList.contains('is-open')) return;

		if (event.key === 'Escape') {
			closeLightbox();
		}
	});
</script>
