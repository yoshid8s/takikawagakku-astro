---
import Layout from '../../../layouts/Layout.astro';

const pageTitle = '困りごと相談窓口';
---

<Layout title={pageTitle}>
	<main class="problem-consultation-page">

		<!-- パンくず -->
		<nav
			class="problem-consultation-breadcrumbs"
			aria-label="パンくずリスト"
		>
			<a href="/">Home</a>
			<span aria-hidden="true">/</span>

			<a href="/takikawa_community_icenter/">
				滝川コミュニティセンター
			</a>

			<span aria-hidden="true">/</span>
			<span>困りごと相談窓口</span>
		</nav>


		<!-- =========================================
		     Block 1
		     困りごと相談窓口
		========================================= -->

		<section class="problem-consultation-main">
			<div class="problem-consultation-main__inner">

				<h1>困りごと相談窓口</h1>

				<div class="problem-consultation-main__content">

					<div class="problem-consultation-main__image">
						<img
							src="/images/community-center/consultation/senior-trouble.png"
							alt="高齢者の困りごと相談のイメージ"
						/>
					</div>

					<div class="problem-consultation-main__text">
						<p>
							名古屋市の「地域支えあい事業」の一環として、学区内の様々な課題を地域住民自身で解決するため各区の社会福祉協議会が中心となり市内103の学区で実施しております。
						</p>

						<p>
							（滝川学区は平成23年度から実施）
						</p>

						<p>
							滝川学区内にお住いの皆様からの次の事項を目的としています。
						</p>

						<ol>
							<li>日常生活の困りごとの相談受付</li>
                                <ol class="alpha-list">
                                    <li>
                                        粗大ゴミを捨てたいけど一人ではできない。
                                    </li>

                                    <li>
                                        病院の付き添いをお願いしたい。
                                    </li>

                                    <li>
                                        災害時の避難が心配で相談したい。
                                    </li>

                                    <li>
                                        とりあえず話をきいてほしい など
                                    </li>
                                </ol>
							<li>
								必要に応じて行政機関への取次・ボランティアへの依頼による困りごと解決
							</li>
						</ol>
					</div>

				</div>
			</div>
		</section>


		<!-- =========================================
		     Block 2
		     利用方法
		========================================= -->

		<section class="problem-consultation-usage">
			<div class="problem-consultation-usage__inner">

				<h2>利用方法</h2>

				<div class="problem-consultation-usage__table">

					<div class="problem-consultation-usage__row">
						<div class="problem-consultation-usage__label">
							相談窓口
						</div>

						<div class="problem-consultation-usage__value">
							滝川コミセン内
						</div>
					</div>


					<div class="problem-consultation-usage__row">
						<div class="problem-consultation-usage__label">
							相談方法
						</div>

						<div class="problem-consultation-usage__value">
							電話・面談
						</div>
					</div>


					<div class="problem-consultation-usage__row">
						<div class="problem-consultation-usage__label">
							相談日時
						</div>

						<div class="problem-consultation-usage__value">
							<p>毎週火曜日　13:00〜16:00</p>
							<p>毎週木曜日　9:00〜12:00</p>
						</div>
					</div>


					<div class="problem-consultation-usage__row">
						<div class="problem-consultation-usage__label">
							電話番号
						</div>

						<div class="problem-consultation-usage__value">
							<a href="tel:09066756071">
								090-6675-6071
							</a>
						</div>
					</div>


					<div class="problem-consultation-usage__row">
						<div class="problem-consultation-usage__label">
							費用
						</div>

						<div class="problem-consultation-usage__value">
							<p>無料</p>

							<p class="problem-consultation-usage__note">
								※電話による通信料はご負担ください。
							</p>
						</div>
					</div>

				</div>
			</div>
		</section>

	</main>
</Layout>


<style>

	/* =========================================================
	   Page
	========================================================= */

	.problem-consultation-page {
		width: 100%;
		margin: 0;
		padding: 0;
		background: #f4f9fc;
		color: #111827;
	}


	/* =========================================================
	   Breadcrumbs
	========================================================= */

	.problem-consultation-breadcrumbs {
		display: flex;
		align-items: center;
		flex-wrap: wrap;
		width: min(calc(100% - 48px), 1280px);
		margin: 0 auto;
		padding: 32px 0;
		gap: 10px;
		font-size: 14px;
		line-height: 1.6;
	}

	.problem-consultation-breadcrumbs a {
		color: #009fe8;
		text-decoration: none;
	}

	.problem-consultation-breadcrumbs a:hover {
		text-decoration: underline;
		text-underline-offset: 0.2em;
	}


	/* =========================================================
	   Block 1
	========================================================= */

	.problem-consultation-main {
		width: 100%;
		padding: 72px 0 96px;
		background: #f4f9fc;
	}

	.problem-consultation-main__inner {
		width: min(calc(100% - 64px), 1200px);
		margin: 0 auto;
	}

	.problem-consultation-main h1 {
		margin: 0 0 64px;
		font-size: clamp(40px, 4.5vw, 60px);
		font-weight: 400;
		line-height: 1.3;
		text-align: center;
	}

	.problem-consultation-main__content {
		display: grid;
		grid-template-columns:
			minmax(300px, 420px)
			minmax(0, 680px);
		justify-content: center;
		align-items: center;
		gap: 72px;
	}

	/* 画像は元画像を必要以上に拡大しない */
	.problem-consultation-main__image {
		width: 100%;
		max-width: 420px;
		margin: 0 auto;
	}

	.problem-consultation-main__image img {
		display: block;
		width: 100%;
		max-width: 420px;
		height: auto;
		margin: 0 auto;
	}

	.problem-consultation-main__text {
		width: 100%;
		max-width: 680px;
	}

	.problem-consultation-main__text p {
		margin: 0 0 20px;
		font-size: 17px;
		line-height: 1.9;
		text-align: left;
	}

    .problem-consultation-main__text ol {
        margin: 30px 0 0;
        padding-left: 1.7em;
        list-style-position: outside;
    }

    .problem-consultation-main__text ol.alpha-list {
        list-style-type: lower-alpha;
    }

	.problem-consultation-main__text li {
		display: list-item;
		margin: 0 0 12px;
		padding-left: 0.3em;
		font-size: 17px;
		line-height: 1.8;
		text-align: left;
	}


	/* =========================================================
	   Block 2
	========================================================= */

	.problem-consultation-usage {
		width: 100%;
		padding: 80px 0 104px;
		background: #fff;
	}

	.problem-consultation-usage__inner {
		width: min(calc(100% - 64px), 1000px);
		margin: 0 auto;
	}

	.problem-consultation-usage h2 {
		margin: 0 0 48px;
		font-size: clamp(34px, 4vw, 48px);
		font-weight: 400;
		line-height: 1.4;
		text-align: center;
	}

	.problem-consultation-usage__table {
		width: min(100%, 860px);
		margin: 0 auto;
		border-top: 1px solid #d9dee4;
	}

	.problem-consultation-usage__row {
		display: grid;
		grid-template-columns: 200px minmax(0, 1fr);
		border-bottom: 1px solid #d9dee4;
	}

	.problem-consultation-usage__label,
	.problem-consultation-usage__value {
		padding: 20px 26px;
		font-size: 16px;
		line-height: 1.8;
	}

	.problem-consultation-usage__label {
		display: flex;
		align-items: center;
		background: #f4f9fc;
		font-weight: 600;
	}

	.problem-consultation-usage__value {
		background: #fff;
	}

	.problem-consultation-usage__value p {
		margin: 0;
	}

	.problem-consultation-usage__value a {
		color: #009fe8;
		font-weight: 600;
		text-decoration: none;
	}

	.problem-consultation-usage__value a:hover {
		text-decoration: underline;
		text-underline-offset: 0.2em;
	}

	.problem-consultation-usage__note {
		margin-top: 4px !important;
		color: #6b7280;
		font-size: 14px;
	}


	/* =========================================================
	   Tablet
	========================================================= */

	@media (max-width: 900px) {
		.problem-consultation-breadcrumbs {
			width: min(calc(100% - 40px), 1280px);
		}

		.problem-consultation-main {
			padding: 56px 0 72px;
		}

		.problem-consultation-main__inner {
			width: min(calc(100% - 40px), 760px);
		}

		.problem-consultation-main h1 {
			margin-bottom: 44px;
		}

		.problem-consultation-main__content {
			grid-template-columns: 1fr;
			gap: 40px;
		}

		.problem-consultation-main__image {
			max-width: 400px;
		}

		.problem-consultation-main__image img {
			max-width: 400px;
		}

		.problem-consultation-main__text {
			max-width: 720px;
			margin: 0 auto;
		}

		.problem-consultation-usage__inner {
			width: min(calc(100% - 40px), 900px);
		}
	}


	/* =========================================================
	   Mobile
	========================================================= */

	@media (max-width: 600px) {
		.problem-consultation-breadcrumbs {
			width: calc(100% - 32px);
			padding: 24px 0;
			font-size: 13px;
		}

		.problem-consultation-main {
			padding: 44px 0 56px;
		}

		.problem-consultation-main__inner {
			width: calc(100% - 32px);
		}

		.problem-consultation-main h1 {
			margin-bottom: 36px;
			font-size: 36px;
		}

		.problem-consultation-main__content {
			gap: 32px;
		}

		.problem-consultation-main__image {
			max-width: 300px;
		}

		.problem-consultation-main__image img {
			max-width: 300px;
		}

		.problem-consultation-main__text p,
		.problem-consultation-main__text li {
			font-size: 15px;
		}

		.problem-consultation-main__text ol {
			padding-left: 1.6em;
		}

		.problem-consultation-usage {
			padding: 56px 0 72px;
		}

		.problem-consultation-usage__inner {
			width: calc(100% - 32px);
		}

		.problem-consultation-usage h2 {
			margin-bottom: 32px;
		}

		.problem-consultation-usage__row {
			display: block;
		}

		.problem-consultation-usage__label {
			padding: 12px 18px;
		}

		.problem-consultation-usage__value {
			padding: 16px 18px 20px;
		}
	}
</style>