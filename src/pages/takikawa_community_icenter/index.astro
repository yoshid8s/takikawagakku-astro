<script>
	/* =========================================================
	   Availability tabs
	========================================================= */

	const tabs = document.querySelectorAll('[data-availability-tab]');
	const panels = document.querySelectorAll('[data-availability-panel]');

	tabs.forEach((tab) => {
		tab.addEventListener('click', () => {
			if (!(tab instanceof HTMLElement)) return;

			const key = tab.dataset.availabilityTab;

			if (!key) return;

			tabs.forEach((item) => {
				const isActive =
					item instanceof HTMLElement &&
					item.dataset.availabilityTab === key;

				item.classList.toggle('is-active', isActive);

				item.setAttribute(
					'aria-selected',
					String(isActive),
				);
			});

			panels.forEach((panel) => {
				if (!(panel instanceof HTMLElement)) return;

				panel.classList.toggle(
					'is-active',
					panel.dataset.availabilityPanel === key,
				);
			});
		});
	});


	/* =========================================================
	   Lightbox elements
	========================================================= */

	const lightbox =
		document.querySelector('#community-center-lightbox');

	const lightboxImage =
		lightbox?.querySelector('.image-lightbox__image');

	const closeButton =
		lightbox?.querySelector('.image-lightbox__close');

	const prevButton =
		lightbox?.querySelector('.image-lightbox__nav--prev');

	const nextButton =
		lightbox?.querySelector('.image-lightbox__nav--next');

	const counter =
		lightbox?.querySelector('.image-lightbox__counter');


	/* =========================================================
	   Lightbox state
	========================================================= */

	let currentGroup = [];
	let currentIndex = 0;

	let isZoomed = false;
	let isDragging = false;
	let hasDragged = false;

	let imageX = 0;
	let imageY = 0;

	let dragStartX = 0;
	let dragStartY = 0;

	let pointerStartX = 0;
	let pointerStartY = 0;

	let activePointerId = null;

	const zoomScale = 2;


	/* =========================================================
	   Transform
	========================================================= */

	const applyImageTransform = () => {
		if (!(lightboxImage instanceof HTMLImageElement)) return;

		if (!isZoomed) {
			lightboxImage.style.transform = '';
			return;
		}

		lightboxImage.style.transform =
			`translate(${imageX}px, ${imageY}px) scale(${zoomScale})`;
	};


	/* =========================================================
	   Zoom reset
	========================================================= */

	const resetZoom = () => {
		if (!(lightboxImage instanceof HTMLImageElement)) return;

		isZoomed = false;
		isDragging = false;
		hasDragged = false;

		imageX = 0;
		imageY = 0;

		dragStartX = 0;
		dragStartY = 0;

		pointerStartX = 0;
		pointerStartY = 0;

		activePointerId = null;

		lightboxImage.classList.remove(
			'is-zoomed',
			'is-dragging',
		);

		lightboxImage.style.transform = '';
	};


	/* =========================================================
	   Zoom in / out
	========================================================= */

	const toggleZoom = () => {
		if (!(lightboxImage instanceof HTMLImageElement)) return;

		if (isZoomed) {
			resetZoom();
			return;
		}

		isZoomed = true;

		imageX = 0;
		imageY = 0;

		lightboxImage.classList.add('is-zoomed');

		applyImageTransform();
	};


	/*
	 * クリックで拡大／縮小
	 *
	 * ドラッグ直後に発生する click では
	 * 縮小しないよう hasDragged で判定。
	 */
	lightboxImage?.addEventListener('click', (event) => {
		if (!(lightboxImage instanceof HTMLImageElement)) return;

		event.preventDefault();
		event.stopPropagation();

		if (hasDragged) {
			hasDragged = false;
			return;
		}

		toggleZoom();
	});


	/* =========================================================
	   Drag start
	========================================================= */

	lightboxImage?.addEventListener('pointerdown', (event) => {
		if (
			!isZoomed ||
			!(lightboxImage instanceof HTMLImageElement)
		) {
			return;
		}

		/*
		 * マウスの場合は左クリックだけ許可。
		 */
		if (
			event.pointerType === 'mouse' &&
			event.button !== 0
		) {
			return;
		}

		event.preventDefault();
		event.stopPropagation();

		isDragging = true;
		hasDragged = false;

		activePointerId = event.pointerId;

		pointerStartX = event.clientX;
		pointerStartY = event.clientY;

		dragStartX = event.clientX - imageX;
		dragStartY = event.clientY - imageY;

		lightboxImage.classList.add('is-dragging');

		/*
		 * 画像外までドラッグしても
		 * pointermove / pointerup を追跡できるようにする。
		 */
		lightboxImage.setPointerCapture(event.pointerId);
	});


	/* =========================================================
	   Drag move
	========================================================= */

	lightboxImage?.addEventListener('pointermove', (event) => {
		if (
			!isDragging ||
			!isZoomed ||
			activePointerId !== event.pointerId
		) {
			return;
		}

		event.preventDefault();

		const movedX =
			Math.abs(event.clientX - pointerStartX);

		const movedY =
			Math.abs(event.clientY - pointerStartY);

		/*
		 * 数px程度ならクリックとみなす。
		 */
		if (movedX > 4 || movedY > 4) {
			hasDragged = true;
		}

		imageX =
			event.clientX - dragStartX;

		imageY =
			event.clientY - dragStartY;

		applyImageTransform();
	});


	/* =========================================================
	   Drag end
	========================================================= */

	const endDrag = (event) => {
		if (
			!isDragging ||
			activePointerId !== event.pointerId
		) {
			return;
		}

		isDragging = false;

		if (lightboxImage instanceof HTMLImageElement) {
			lightboxImage.classList.remove('is-dragging');

			if (
				lightboxImage.hasPointerCapture(event.pointerId)
			) {
				lightboxImage.releasePointerCapture(
					event.pointerId,
				);
			}
		}

		activePointerId = null;
	};

	lightboxImage?.addEventListener(
		'pointerup',
		endDrag,
	);

	lightboxImage?.addEventListener(
		'pointercancel',
		endDrag,
	);


	/* =========================================================
	   Update lightbox image
	========================================================= */

	const updateLightbox = () => {
		if (
			!(lightboxImage instanceof HTMLImageElement) ||
			currentGroup.length === 0
		) {
			return;
		}

		/*
		 * 画像を切り替えるたびに
		 * 拡大率と移動位置をリセット。
		 */
		resetZoom();

		const currentButton =
			currentGroup[currentIndex];

		if (!(currentButton instanceof HTMLElement)) return;

		const src =
			currentButton.dataset.lightboxImage;

		const image =
			currentButton.querySelector('img');

		if (!src) return;

		lightboxImage.src = src;

		lightboxImage.alt =
			image instanceof HTMLImageElement
				? image.alt
				: '';

		if (counter) {
			counter.textContent =
				`${currentIndex + 1} / ${currentGroup.length}`;
		}

		if (prevButton instanceof HTMLButtonElement) {
			prevButton.disabled =
				currentGroup.length <= 1;
		}

		if (nextButton instanceof HTMLButtonElement) {
			nextButton.disabled =
				currentGroup.length <= 1;
		}
	};


	/* =========================================================
	   Open lightbox
	========================================================= */

	const openLightbox = (button) => {
		if (
			!lightbox ||
			!(button instanceof HTMLElement)
		) {
			return;
		}

		const groupName =
			button.dataset.lightboxGroup;

		if (!groupName) return;

		currentGroup = Array.from(
			document.querySelectorAll(
				'[data-lightbox-image]',
			),
		).filter((item) => {
			return (
				item instanceof HTMLElement &&
				item.dataset.lightboxGroup === groupName
			);
		});

		currentIndex =
			currentGroup.indexOf(button);

		if (currentIndex < 0) {
			currentIndex = 0;
		}

		updateLightbox();

		lightbox.classList.add('is-open');

		lightbox.setAttribute(
			'aria-hidden',
			'false',
		);

		document.body.style.overflow = 'hidden';
	};


	/* =========================================================
	   Close lightbox
	========================================================= */

	const closeLightbox = () => {
		if (!lightbox) return;

		resetZoom();

		lightbox.classList.remove('is-open');

		lightbox.setAttribute(
			'aria-hidden',
			'true',
		);

		if (
			lightboxImage instanceof HTMLImageElement
		) {
			lightboxImage.src = '';
			lightboxImage.alt = '';
		}

		currentGroup = [];
		currentIndex = 0;

		document.body.style.overflow = '';
	};


	/* =========================================================
	   Previous / Next
	========================================================= */

	const showPrevious = () => {
		if (currentGroup.length <= 1) return;

		currentIndex =
			(
				currentIndex -
				1 +
				currentGroup.length
			) %
			currentGroup.length;

		updateLightbox();
	};

	const showNext = () => {
		if (currentGroup.length <= 1) return;

		currentIndex =
			(currentIndex + 1) %
			currentGroup.length;

		updateLightbox();
	};


	/* =========================================================
	   Lightbox triggers
	========================================================= */

	document.addEventListener('click', (event) => {
		if (!(event.target instanceof Element)) return;

		const button =
			event.target.closest(
				'[data-lightbox-image]',
			);

		if (!(button instanceof HTMLElement)) return;

		event.preventDefault();

		openLightbox(button);
	});


	/* =========================================================
	   Lightbox controls
	========================================================= */

	closeButton?.addEventListener(
		'click',
		(event) => {
			event.preventDefault();
			event.stopPropagation();

			closeLightbox();
		},
	);

	prevButton?.addEventListener(
		'click',
		(event) => {
			event.preventDefault();
			event.stopPropagation();

			showPrevious();
		},
	);

	nextButton?.addEventListener(
		'click',
		(event) => {
			event.preventDefault();
			event.stopPropagation();

			showNext();
		},
	);


	/*
	 * 背景部分をクリックしたときだけ閉じる。
	 * 画像や操作ボタンをクリックしても閉じない。
	 */
	lightbox?.addEventListener(
		'click',
		(event) => {
			if (event.target === lightbox) {
				closeLightbox();
			}
		},
	);


	/* =========================================================
	   Keyboard
	========================================================= */

	document.addEventListener(
		'keydown',
		(event) => {
			if (
				!lightbox?.classList.contains(
					'is-open',
				)
			) {
				return;
			}

			switch (event.key) {
				case 'Escape':
					closeLightbox();
					break;

				case 'ArrowLeft':
					showPrevious();
					break;

				case 'ArrowRight':
					showNext();
					break;
			}
		},
	);
</script>