---
import Layout from '../../layouts/Layout.astro';

const availabilityItems = [
	{
		key: '202608',
		label: '8月',
		src: '/images/community-center/availability/202608.svg',
		alt: '2026年8月 滝川コミュニティセンター空室状況',
	},
	{
		key: '202609',
		label: '9月',
		src: '/images/community-center/availability/202609.svg',
		alt: '2026年9月 滝川コミュニティセンター空室状況',
	},
	{
		key: '202610',
		label: '10月',
		src: '/images/community-center/availability/202610.svg',
		alt: '2026年10月 滝川コミュニティセンター空室状況',
	},
	{
		key: '202611',
		label: '11月',
		src: '/images/community-center/availability/202611.svg',
		alt: '2026年11月 滝川コミュニティセンター空室状況',
	},
];

const rooms = [
	{
		title: '第1会議室',
		image: '/images/community-center/rooms/room-01.png',
		alt: '滝川コミュニティセンター 第1会議室',
		content: `
			<p>広さ 46.93㎡</p>
			<ul>
				<li>集会・講演会・学習会などにご利用いただけます。</li>
				<li>約 40 名(イスのみ)~約 20 名(テーブル・イスあり)</li>
                <li>プロジェクター用スクリーン、ホワイトボード(固定式)</li>
                <li>第1会議室と第2会議室をつなげて 1 つの会議室としてご利用いただくこともできます。</li>
                <li>館内フリーWi-Fi 利用可能です。</li>
			</ul>
		`,
	},
	{
		title: '第2会議室',
		image: '/images/community-center/rooms/room-02.png',
		alt: '滝川コミュニティセンター 第2会議室',
		content: `
			<p>広さ 36.06㎡</p>
			<ul>
				<li>集会・講演会・学習会などにご利用いただけます。</li>
				<li>約 30 名(イスのみ)~約 15 名(テーブル・イスあり)</li>
                <li>ホワイトボード(可動式)</li>
                <li>第1会議室と第2会議室をつなげて 1 つの会議室としてご利用いただくこともできます。</li>
                <li>館内フリーWi-Fi 利用可能です。</li>
			</ul>
		`,
	},
	{
		title: '和室',
		image: '/images/community-center/rooms/japanese-room.png',
		alt: '滝川コミュニティセンター 和室',
		content: `
			<p>12帖と10帖の和室があります。</p>
			<ul>
				<li>茶道・囲碁・将棋の他、会議にもご利用いただけます。</li>
				<li>約 40 名(イスのみ)~約 20 名(テーブル・イスあり)</li>
                <li>炉、床の間、ホワイトボード(固定式)、テーブル、イス
                ※ 通常はカーペット敷き(取り外して畳での使用可)</li>
                <li>この他、調理室、湯沸室、多目的トイレ、などの部屋や設備があります。</li>
                <li>館内フリーWi-Fi 利用可能です。</li>
			</ul>
		`,
	},
];
---

<Layout title="滝川コミュニティセンター">
	<main class="community-center-page">
		<section
			class="community-center-hero"
			style={`background-image: linear-gradient(rgba(0,0,0,.25), rgba(0,0,0,.25)), url('/images/community-center/hero.jpg');`}
		>
			<h1>滝川コミュニティセンター</h1>
		</section>

		<nav class="breadcrumbs" aria-label="パンくずリスト">
			<a href="/">Home</a>
			<span>/</span>
			<span>滝川コミュニティセンター</span>
		</nav>

		<section class="intro-section content-section">
			<div class="section-inner two-column">
				<div class="section-text">
					<h2>滝川コミュニティセンター</h2>

					<p>
						滝川コミュニティセンターは、市の指定管理者制度により、指定管理者となった滝川学区自治協議会が
                        運営委員会を設置して管理・運営している公共施設で、平成23年12月に開館しました。
                        滝川学区自治協議会および滝川コミュニティセンターが主催する 「文化教養講座」 を
                        定期的に開催しているほか、学区の皆様を中心としたサークル活動や学習会、会合など 
                        自主活動クラブ の拠点として幅広く活用していただいています。
                        また、滝川学区社会福祉協議会による 「困りごと相談窓口」 も設置されています。
					</p>

					<p>
						滝川コミセンに関するニュースは<a href="/category/%e6%bb%9d%e5%b7%9d%e3%82%b3%e3%83%9f%e3%82%bb%e3%83%b3">こちら</a> 
					</p>
				</div>

				<div class="section-image">
					<img
						src="/images/community-center/exterior.png"
						alt="滝川コミュニティセンター外観"
						loading="lazy"
					/>
				</div>
			</div>
		</section>

		<section class="availability-section content-section">
			<div class="section-inner">
				<h2>滝川コミセンの空室状況・予約</h2>

				<p class="section-lead">
					滝川コミセンで開催されている自主活動クラブを含めたイベントカレンダーです。
				</p>
                <p class="attention-note">
                    令和8年8月22日更新
                </p>
				<div
					class="availability-tabs"
					role="tablist"
					aria-label="空室状況 月選択"
				>
					{
						availabilityItems.map((item, index) => (
							<button
								class:list={[
									'availability-tab',
									index === 0 && 'is-active',
								]}
								type="button"
								role="tab"
								aria-selected={index === 0 ? 'true' : 'false'}
								data-availability-tab={item.key}
							>
								{item.label}
							</button>
						))
					}
				</div>

				<div class="availability-panels">
					{
						availabilityItems.map((item, index) => (
							<div
								class:list={[
									'availability-panel',
									index === 0 && 'is-active',
								]}
								data-availability-panel={item.key}
								role="tabpanel"
							>
								<button
									class="availability-image-button"
									type="button"
									data-lightbox-image={item.src}
									data-lightbox-group="availability"
									aria-label={`${item.alt}を拡大表示`}
								>
									<img
										src={item.src}
										alt={item.alt}
										loading={index === 0 ? 'eager' : 'lazy'}
									/>
								</button>

								<p class="availability-caption">
									画像をクリックすると拡大表示できます。
								</p>
							</div>
						))
					}
				</div>

				<div class="reservation-notice">
					<h3>新規に滝川コミセンのご利用希望の方へ</h3>
                    <ul>
                        <li>滝川コミセンへの直接ご訪問いただき、申込書を提出いただくか、 オンラインからもお申し込みができます。</li>
                        <li>オンライン申し込みには、滝川コミセンを訪問されてのお申し込みが優先されますので、お申し込み時点で空室でも予約保証をするものではありませんので、あらかじめご了承ください。</li>
                        <li>お申し込みは「先着順」による受付で、電話・メール・ファックス等によるお申し込みや仮予約はできません。</li>
                        <li>空室状況は毎月第1・第3土曜日更新です。</li>
                        <li>最新の利用情報は電話にてお問合せください。052-710-8621</li>
                    </ul>

					<div class="reservation-actions">
						<a
							class="primary-button"
							href="https://takikawagakku.jp/takikawa_community_icenter/comisen-reserve/"
						>
							オンラインで予約する
						</a>
					</div>
				</div>
			</div>
		</section>

		<section class="facility-section content-section content-section--white">
			<div class="section-inner">
				<h2>施設概要</h2>

				<div class="info-grid">
					<div class="info-card">
						<h3>所在地</h3>
						<p>
							〒466-0827<br />
							名古屋市昭和区川名山町46-4
						</p>
                        <h3>駐車場について</h3>
						<p>
							駐車場が狭いため、できるだけお車のご利用はお控えください。<br />
                            なお、駐車場のご利用は 1 団体につき2台までとさせていただきます。<br />
                            それ以外は、お近くのコインパーキングをご利用ください。
						</p>
					</div>

                    <div class="info-card">
						<h3>施設概要</h3>
						<ul>
							<li>面 積 敷地 501.63 m2 延床 299.91 m2</li>
                            <li>構造・規模 鉄筋コンクリート造り 2階建て</li>
                            <li>その他 太陽光発電施設併設</li>
                            <li>当センターでは、「AED」(自動体外式除細動器)を備えています。</li>　
						</ul>
                        <p class="attention-note">エレベーターはありません</p>
					</div>

					<div class="info-card">
						<h3>開館時間</h3>
						<p>
							9:00〜20:00
						</p>
						<p>
							窓口業務：9:00〜16:00
						</p>
                        <h3>お問い合わせ</h3>
						<p>
							TEL.052-710-8621
						</p>
					</div>

					<div class="info-card">
						<h3>休館日</h3>
						<p>毎週月曜日</p>
						<p>夏季休館：8月12日〜16日</p>
						<p>年末年始：12月28日〜1月6日</p>
                        <p>その他、運営委員会が定める日</p>
					</div>

					<div class="info-card">
						<h3>利用の制限</h3>
						<p>
							以下に該当する場合はご利用いただけません。
						</p>
                        <ul>
							<li>法律で定める選挙における選挙運動としての利用</li>
                            <li>専ら営利を目的とした利用（ただし、地域の公共団体等がバザーなど得た利益を公共の目的に利用する場合を除きます。）</li>
                            <li>その他、管理運営上、支障があると運営委員会が判断したとき</li>
						</ul>
					</div>

                    <div class="info-card">
						<h3>主な利用例</h3>
                        <ul>
							<li>サークル・各種団体の会合、練習</li>
                            <li>各種教室の発表会</li>
                            <li>勉強会・趣味の会</li>
                            <li>お仲間同士での食事会</li>
                            <li>子ども会や老人クラブ、保育園などの行事</li>
                            <li>ハロウィンパーティー・クリスマス会・誕生日会</li>
                            <li>お茶会 など</li>
						</ul>
					</div>

                    <div class="info-card">
						<h3>利用ルール遵守のお願い</h3>
                        <ul>
							<li>全館禁煙にご協力ください。</li>
                            <li>所定の場所を除き、火気の使用はできません。</li>
                            <li>出たゴミはすべてお持ち帰りください。</li>
                            <li>他の利用者に迷惑がかかる行為はお控えください。</li>
						</ul>
					</div>
				</div>
			</div>
		</section>

        <section class="rooms-section">
            <div class="section-inner">
                <h2>お部屋のご案内</h2>

                <div class="rooms-intro">
                    <p>
                        ご利用になれるお部屋は、以下の3部屋の他に調理室があります。
                    </p>
                    <p>
                        同時に複数の部屋をご利用いただくこともできます。
                    </p>
                </div>

                <div class="rooms-notes">
                    <ul>
                        <li>
                            2つの会議室を1部屋として利用する際は、2部屋分の利用料が必要となります。
                        </li>
                        <li>
                            楽器を使用したり、大きな声や音を出す場合は、和室又は会議室2室のご利用をお願いする場合があります。
                        </li>
                        <li>
                            「調理室」の一般利用については他の利用区分との併用であり湯沸かしないし調理を伴う利用に限ります。
                        </li>
                    </ul>
                </div>
				<div class="room-grid">
					{
						rooms.map((room) => (
							<article class="room-card">
								<img
									src={room.image}
									alt={room.alt}
									loading="lazy"
								/>

								<div class="room-card__body">
									<h3>{room.title}</h3>
									<div set:html={room.content} />
								</div>
							</article>
						))
					}
				</div>
			</div>
		</section>

		<section class="floor-section content-section content-section--white">
			<div class="section-inner">
				<h2>館内平面図</h2>

				<div class="floor-grid">
					<figure>
						<button
							class="floor-image-button"
							type="button"
							data-lightbox-image="/images/community-center/floor/1f.png"
							data-lightbox-group="floor"
							aria-label="1階平面図を拡大表示"
						>
							<img
								src="/images/community-center/floor/1f.png"
								alt="滝川コミュニティセンター 1階平面図"
								loading="lazy"
							/>
						</button>
						<figcaption>1階平面図</figcaption>
					</figure>

					<figure>
						<button
							class="floor-image-button"
							type="button"
							data-lightbox-image="/images/community-center/floor/2f.png"
							data-lightbox-group="floor"
							aria-label="2階平面図を拡大表示"
						>
							<img
								src="/images/community-center/floor/2f.png"
								alt="滝川コミュニティセンター 2階平面図"
								loading="lazy"
							/>
						</button>
						<figcaption>2階平面図</figcaption>
					</figure>
				</div>
			</div>
		</section>

        <section class="usage-section content-section">
            <div class="section-inner">
                <h2>利用時間</h2>

                <p class="usage-description">
                    ご利用は、以下の時間区分によります。
                    なお、時間区分を連続してご利用の場合は、
                    あいだの時間も利用していただけます。
                </p>

                <div class="usage-table-wrap">
                    <table class="usage-table usage-time-table">
                        <thead>
                            <tr>
                                <th>利用時間区分</th>
                                <th>午前</th>
                                <th>午後</th>
                                <th>夜間</th>
                            </tr>
                        </thead>

                        <tbody>
                            <tr>
                                <th>利用時間</th>
                                <td>9:00〜12:00</td>
                                <td>13:00〜16:00</td>
                                <td>17:00〜20:00</td>
                            </tr>
                        </tbody>
                    </table>
                </div>

                <div class="usage-fee">
                    <h2>利用料</h2>

                    <p>
                        利用料は、利用代表者の方のお住まいの地域により異なります。
                    </p>

                    <div class="usage-table-wrap">
                        <table class="usage-table fee-table">
                            <thead>
                                <tr>
                                    <th>時間区分及び<br />施設区分単位</th>
                                    <th>滝川学区在住の方</th>
                                    <th>それ以外の方</th>
                                    <th>学区自治協議会関係</th>
                                </tr>
                            </thead>

                            <tbody>
                                <tr>
                                    <th>利用料</th>
                                    <td>
                                        会議室&nbsp; 1,200 円<br />
                                        調理室&nbsp; 600 円
                                    </td>
                                    <td>
                                        会議室&nbsp; 2,200 円<br />
                                        調理室&nbsp; 1,100 円
                                    </td>
                                    <td>減免適用</td>
                                </tr>
                            </tbody>
                        </table>
                    </div>

                    <ul class="usage-fee-notes">
                        <li>
                            2つの会議室を1部屋として利用する際は、
                            2部屋分の利用料が必要となります。
                        </li>
                        <li>
                            上記の利用料には、冷暖房費を含みます。
                        </li>
                    </ul>

                    <p class="usage-example">
                        （例）滝川学区在住の方が、「午前」に1部屋利用される場合の
                        利用料は「1,200円」となり、「午前」と「午後」を利用される場合は
                        「2,400円」となります。
                    </p>

                    <div class="cancellation-fee">
                        <h3>【取消料】</h3>

                        <ul>
                            <li>
                                利用者のご都合により、予約後の利用を取り消される場合は、
                                以下の通り「取消料」を申し受けます。
                            </li>
                            <li>
                                センターの都合又は暴風警報等の発令により
                                利用できなかった場合の取消料は不要です。
                            </li>
                            <li>
                                <strong>利用日の前日・当日　利用料の100%</strong>
                            </li>
                        </ul>
                    </div>
                </div>
            </div>
        </section>

		<section class="rules-section content-section content-section--white">
			<div class="section-inner">
				<h2>利用方法・利用上のお願い</h2>

				<div class="accordion-list">
					<details>
						<summary>
							<span>利用申込について</span>
							<span aria-hidden="true">＋</span>
						</summary>

						<div class="accordion-body">
							<p>
								利用を希望される方は、空室状況をご確認のうえ、
								窓口またはオンライン予約をご利用ください。
							</p>

							<p>
								窓口での申し込みが優先となり、オンラインへの予約データ反映が遅れることがありますので、
								オンライン上で空室と表示されていても、
								予約済みの場合があります。
							</p>
						</div>
					</details>

					<details>
						<summary>
							<span>利用上のお願い</span>
							<span aria-hidden="true">＋</span>
						</summary>

						<div class="accordion-body">
							<ul>
								<li>施設・設備は大切にご利用ください。</li>
								<li>利用後は室内を原状に戻してください。</li>
								<li>ゴミは各自ですべてお持ち帰りください。</li>
								<li>他の利用者や近隣の迷惑となる行為はお控えください。</li>
                                <li>全館禁煙にご協力ください。</li>
                                <li>所定の場所を除き、火気の使用はできません。</li>
							</ul>
						</div>
					</details>

					<details>
						<summary>
							<span>臨時休館・警報発令時について</span>
							<span aria-hidden="true">＋</span>
						</summary>

						<div class="accordion-body">
							<p>
								以下に該当する場合は「臨時休館」となります。
							</p>

							<ul>
								<li>名古屋市域に「暴風警報」が発令されたとき。</li>
                                <li>昭和区に「震度 5 弱」以上の地震が発生したとき。</li>
								<li>利用者の安全が確保されないと判断されるとき。</li>
								<li>センター又は学区主催の行事(その準備を含む)等と重なったとき。</li>
								<li>センターに避難所が開設されたとき。</li>
                                <li>その他、運営委員会において必要と判断したいとき。</li>
							</ul>
						</div>
					</details>
                    <details>
						<summary>
							<span>警報発令時の対応</span>
							<span aria-hidden="true">＋</span>
						</summary>

						<div class="accordion-body">
							<ul>
								<li>午前7時までに解除：通常通り開館</li>
                                <li>午前7時時点で発令中：午前閉館</li>
								<li>午前11時時点で発令中：午後閉館</li>
								<li>午後3時時点で発令中：夜間閉館</li>
							</ul>
						</div>
					</details>
                    <details open>
                        <summary>
                                <span>設備・貸出備品一覧</span>
                                <span aria-hidden="true">＋</span>
                            </summary>

