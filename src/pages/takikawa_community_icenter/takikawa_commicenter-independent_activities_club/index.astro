	{
		id: 'gospel',
		title: 'ゴスペルの会',
		subtitle: '第2・4木曜',
		schedule: '第2・4木曜',
		image: '/images/community-center/independent-clubs/gospel.png',
		imageAlt: 'ゴスペルの会',
		content: `
			<p>木曜の10時半からゴスペルを歌おう！</p>

			<ul>
				<li>日程：第2・第4木曜日</li>
				<li>時間：10:30〜11:30</li>
				<li>費用：2,000円／1回</li>
				<li>対象：どなたでも参加できます</li>
				<li>お問い合わせ：河野　090-4089-4607</li>
				<li>受付時間：10:00〜17:00</li>
			</ul>
		`,
	},
	{
		id: 'shogi',
		title: '日本将棋連盟 名古屋滝川支部',
		subtitle: '第1・3土曜',
		schedule: '第1・3土曜',
		image: '/images/community-center/independent-clubs/shogi.png',
		imageAlt: '日本将棋連盟 名古屋滝川支部',
		content: `
			<ul>
				<li>対象：18歳以上</li>
				<li>開催区分：前期4月〜／後期10月〜</li>
				<li>開催日時：第1・第3土曜日 13:00〜16:00</li>
				<li>日程はお問い合わせください</li>
				<li>定員：25名</li>
				<li>受講料：7,000円（入会金不要）</li>
				<li>お問い合わせ：柴田　reki8510syo@gmail.com</li>
			</ul>
		`,
	},
	{
		id: 'sara',
		title: '水彩画・日本画 絵画教室 沙羅の会',
		subtitle: '第1・3火曜',
		schedule: '第1・3火曜',
		image: '/images/community-center/independent-clubs/sara.png',
		imageAlt: '絵画教室 沙羅の会 日本画・水彩画など',
		content: `
			<p>
				初心者の方も基本から親切丁寧にお教えいたします。
			</p>

			<ul>
				<li>開催日時：月2回 第1・第3火曜日 10:00〜12:00</li>
				<li>費用：月5,000円（入会金不要）</li>
