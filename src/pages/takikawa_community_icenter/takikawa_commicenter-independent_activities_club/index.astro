	{
		id: 'yoga',
		title: 'みんなで健康ヨガ',
		subtitle: '毎週水曜',
		schedule: '毎週水曜',
		image: '/images/community-center/independent-clubs/yoga.png',
		imageAlt: 'みんなで健康ヨガ',
		content: `
			<p>
				年齢忘れて、どなたでも参加OK♪<br>
				カラダが固くても大丈夫♪
			</p>

			<ul>
