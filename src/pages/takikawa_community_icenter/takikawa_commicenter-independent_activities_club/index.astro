		title: '社交ダンス教室',
		subtitle: '第2・4土曜',
		schedule: '第2・4土曜',
		image: '/images/community-center/independent-clubs/social-dance.png',
		imageAlt: '社交ダンス教室',
		content: `
			<p>社交ダンスで健康に、キレイに。</p>

