---
import Layout from '../../../layouts/Layout.astro';

const pageTitle = '自主活動クラブ';

const clubs = [
	{
		id: 'hatsuratsu',
		title: 'はつらつクラブ',
		subtitle: '毎週金曜',
		schedule: '毎週金曜',
		image: '/images/community-center/independent-clubs/hatsuratsu.png',
		imageAlt: 'はつらつクラブ',
		content: `
			<p>
				名古屋市高齢者はつらつ長寿推進事業の「はつらつクラブ」では、
				ずっとお元気でいていただくために、健康体操やレクリエーションを楽しみながら、
				介護予防について理解を深めていただきます。
			</p>

			<p>
				健康体操、レクリエーション、音楽鑑賞・歌唱などを行いながら、
				仲間づくりや介護予防を行っています。
				市内にお住まいで、ご自分で会場に通える65歳以上の方にご参加いただけます。
			</p>

			<p><strong>★参加にはお申し込みが必要です。</strong></p>

			<p>
				前期：毎年2月頃、後期：毎年8月頃に募集を行います。
			</p>

			<ul>
				<li>開催期間：前期 4〜9月／後期 10〜3月</li>
				<li>開催日時：毎週金曜日（祝日・年末年始を除く）13:30〜15:30</li>
				<li>入会金・参加費：無料（材料代等実費負担）</li>
				<li>持ち物：その都度ご案内します</li>
			</ul>

			<p>
				主催：社会福祉法人 昭和区社会福祉協議会<br>
				名古屋市昭和区御器所3-18-1<br>
				TEL：052-884-5511 ／ FAX：052-883-2231
			</p>
		`,
	},
	{
		id: 'folk-dance',
		title: '滝川フォークダンスクラブ',
		subtitle: '第1・3・4火曜',
		schedule: '第1・3・4火曜',
		image: '/images/community-center/independent-clubs/folk-dance.png',
		imageAlt: '滝川フォークダンスクラブ',
		content: `
			<p>
				愛知県フォークダンス連盟から迎えた講師のもとで指導を受けながら練習し、
				「昭和区民まつり」や「滝川学区親子ふれあいフェスタ」で披露しています。
				あなたも世界の音楽にあわせて楽しく踊ってみませんか？
			</p>

			<ul>
				<li>開催日時：毎月第1・3・4火曜日 13:30〜15:00（1回90分）</li>
				<li>入会資格：どなたでもOK（女性のみ）</li>
				<li>費用：月2,000円（入会金不要）</li>
				<li>持ち物：フォークダンス用上靴</li>
				<li>講師：愛知県フォークダンス連盟 加藤千恵子先生</li>
				<li>お問い合わせ：今井やよ　090-7865-1263</li>
			</ul>
		`,
	},
	{
		id: 'shigin',
		title: '岳精流日本吟院 滝川吟遊会',
		subtitle: '第2・3・4木曜',
		schedule: '第2・3・4木曜',
		image: '/images/community-center/independent-clubs/shigin.png',
		imageAlt: '岳精流日本吟院 滝川吟遊会',
		content: `
			<p>
				漢詩・短歌・俳句など、良い詩で感動、心もリフレッシュ。
				腹式呼吸で体も元気に。
			</p>

