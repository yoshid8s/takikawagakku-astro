---

<Layout title={pageTitle}>
	<main class="independent-clubs-page">
		<nav
			class="independent-clubs-breadcrumbs"
			aria-label="パンくずリスト"
		>
			<a href="/">Home</a>
			<span aria-hidden="true">/</span>

			<a href="/takikawa_community_icenter/">
				滝川コミュニティセンター
			</a>

			<span aria-hidden="true">/</span>
			<span>自主活動クラブ</span>
		</nav>

		<section class="independent-clubs-intro">
			<div class="independent-clubs-intro__inner">
				<h1>自主活動クラブ</h1>

				<p>
					学区の皆様を中心としたサークル活動や学習会などの自主活動クラブをご紹介します。
					ここでご紹介するクラブは、滝川学区自治協議会や滝川コミュニティセンターと独立して、
					各自のクラブ主体により主催されていますので、
					ご参加は各運営主体にお問い合わせください。
				</p>
			</div>
		</section>

        <section class="independent-clubs-list">
            <div class="independent-clubs-list__inner">
                <h2>滝川コミセン 自主活動クラブ一覧</h2>

                <nav
                    class="club-index"
                    id="club-index"
                    class="club-index"
                    aria-labelledby="club-index-title"
                >
                    <h3 id="club-index-title">クラブ一覧</h3>

                    <ul class="club-index__list">
                        {
                            clubs.map((club) => (
                                <li class="club-index__item">
                                    <a href={`#${club.id}`}>
                                        <span
                                            class="club-index__arrow"
                                            aria-hidden="true"
                                        >
                                            ›
                                        </span>

                                        <span>
                                            {club.title}
                                            <span class="club-index__schedule">
                                                （{club.schedule}）
                                            </span>
                                        </span>
                                    </a>
                                </li>
                            ))
                        }
                    </ul>
                </nav>

                <div class="independent-clubs-accordions">
                    {
                        clubs.map((club) => (
                            <details
                                id={club.id}
                                class="independent-club"
                                open
                            >
                                <summary>
                                    <span class="independent-club__heading">
                                        <strong>{club.title}</strong>
                                        <span>{club.subtitle}</span>
                                    </span>

                                    <span
                                        class="independent-club__icon"
                                        aria-hidden="true"
                                    >
                                        ＋
                                    </span>
                                </summary>

                                <div class="independent-club__body">
                                    <div class="independent-club__content">
                                        <div class="independent-club__image">
                                            <img
                                                src={club.image}
                                                alt={club.imageAlt}
                                                loading="lazy"
                                            />
                                        </div>

                                        <div class="independent-club__text">
                                            <div set:html={club.content} />

                                            {
                                                club.qr && (
                                                    <div class="independent-club__qr">
                                                        <p>ご予約はこちらから</p>

                                                        <img
                                                            src={club.qr}
                                                            alt="桜ハウス公式LINE QRコード"
                                                            loading="lazy"
                                                        />
                                                    </div>
                                                )
                                            }

                                            <p class="independent-club__back">
                                                <a href="#club-index">
                                                    自主活動クラブ一覧へ戻る
                                                </a>
                                            </p>
                                        </div>
                                    </div>
                                </div>
                            </details>
                        ))
                    }
                </div>
            </div>
        </section>
	</main>
</Layout>

<style>
	.independent-clubs-page {
		background: #f4f9fc;
		color: #111827;
	}

	.independent-clubs-breadcrumbs {
		display: flex;
		align-items: center;
		flex-wrap: wrap;
		width: min(calc(100% - 48px), 1280px);
		margin: 0 auto;
		padding: 32px 0;
		gap: 10px;
		font-size: 14px;
		line-height: 1.6;
	}

	.independent-clubs-breadcrumbs a {
		color: #009fe8;
		text-decoration: none;
	}

	.independent-clubs-intro {
		padding: 72px 0 64px;
	}

	.independent-clubs-intro__inner {
		width: min(calc(100% - 64px), 1000px);
		margin: 0 auto;
		text-align: center;
	}

	.independent-clubs-intro h1 {
		margin: 0 0 36px;
		font-size: clamp(40px, 4.5vw, 60px);
		font-weight: 400;
	}

	.independent-clubs-intro p {
		margin: 0;
		font-size: 17px;
		line-height: 1.9;
		text-align: left;
	}

	.independent-clubs-list {
		padding-bottom: 96px;
	}

	.independent-clubs-list__inner {
		width: min(calc(100% - 64px), 1200px);
		margin: 0 auto;
	}

	.independent-clubs-list h2 {
		margin: 0 0 40px;
		font-size: clamp(30px, 3.5vw, 46px);
		font-weight: 400;
		text-align: center;
	}

	.independent-clubs-accordions {
		display: grid;
		gap: 20px;
	}

	.independent-club {
		overflow: hidden;
		border-radius: 8px;
		background: #fff;
	}

	.independent-club > summary {
		display: flex;
		align-items: center;
		justify-content: space-between;
		padding: 20px 28px;
		background: #0da5df;
		color: #fff;
		cursor: pointer;
		list-style: none;
	}

	.independent-club > summary::-webkit-details-marker {
		display: none;
	}

	.independent-club__heading {
		display: flex;
		align-items: baseline;
		flex-wrap: wrap;
		gap: 10px;
	}

	.independent-club__heading strong {
		font-size: 19px;
	}

	.independent-club__heading > span {
		font-size: 14px;
		font-weight: 400;
	}

	.independent-club__icon {
		margin-left: 20px;
		font-size: 26px;
		font-weight: 300;
		line-height: 1;
		transition: transform 0.2s ease;
	}

	.independent-club[open] .independent-club__icon {
		transform: rotate(45deg);
	}

	.independent-club__body {
		padding: 48px 44px 52px;
	}

	.independent-club__content {
		display: grid;
		grid-template-columns: minmax(280px, 380px) minmax(0, 1fr);
		align-items: start;
		gap: 56px;
	}

	.independent-club__image {
		width: 100%;
		max-width: 380px;
		margin: 0 auto;
	}

	.independent-club__image img {
		display: block;
		width: 100%;
		height: auto;
	}

	.independent-club__text {
		min-width: 0;
	}

	.independent-club__text :global(p) {
